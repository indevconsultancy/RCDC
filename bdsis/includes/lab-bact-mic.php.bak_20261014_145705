if (!function_exists('bdsis_bact_mic_delete')) {
    /**
     * When the user switches a row FROM MIC TO Disk Diffusion on an edit,
     * iu-lab.php calls this to clear the MIC-side storage. No-op when the
     * dedicated table isn't present yet.
     *
     * @return bool
     */
    function bdsis_bact_mic_delete($bdsis, $brt2id)
    {
        $brt2id = (int)$brt2id;
        if ($brt2id <= 0 || !($bdsis instanceof mysqli)) { return false; }
        /* Always try to clean any stray ast_method_id='02' rows from the
           earlier (broken) attempt; harmless when none exist. */
        $delLegacy = @$bdsis->prepare("DELETE FROM bacteriology_ast_table WHERE brt2_id=? AND ast_method_id='02'");
        if ($delLegacy) { $delLegacy->bind_param("i", $brt2id); $delLegacy->execute(); $delLegacy->close(); }
        if (!bdsis_bact_mic_table_exists($bdsis)) { return true; }
        $q = @$bdsis->prepare("DELETE FROM bacteriology_mic_table WHERE brt2_id=?");
        if (!$q) { return false; }
        $q->bind_param("i", $brt2id);
        $ok = $q->execute();
        $q->close();
        return (bool)$ok;
    }
}

/* =============================================================================
   Phase 3 — MIC-triggered ESBL / CPE / AmpC confirmatory flow
   -----------------------------------------------------------------------------
   The confirmatory tests (ESBL combination disk, mCIM/eCIM, AmpC) are physical
   disk tests performed AFTER a resistant-phenotype screen suggests the organism
   needs confirming. On the DD path that screen is the routine antibiogram's
   zone diameters; on the MIC path it is the Phase 3 phenotype thresholds from
   image 3 of the MIC Document:

     ESBL screen:   CTX > 1  OR  CRO > 1  OR  CAZ > 4
     AmpC screen:   CTX > 1 AND CRO > 1              (bdsis_ampc_is_triggered,
                                                     requires all three)
                    confirmed with cefoxitin FOX > 8
     CPE screen:    ETP > 0.5  OR  IPM > 1  OR  MEM > 1

   These helpers project a parsed MIC row set into the code => interpretation
   shape bdsis_resistance_plan_core() and bdsis_ampc_is_triggered() already
   consume for the DD path, so Phase 3 reuses the entire confirmatory
   validation / save / load pipeline unchanged. The underlying confirmatory
   inputs stay as mm readings (the clavulanic-acid combination disc, cefoxitin
   disc and mCIM/eCIM disc are physical tests regardless of what triggered
   them) -- only the screen that opens the panel differs. The DD path is
   byte-identical to before.
   ============================================================================= */

if (!function_exists('bdsis_bact_mic_phenotype_thresholds')) {
    /**
     * Phase 3 phenotype trigger thresholds (user spec 2026-10-04).
     * "MIC value > threshold" is considered Resistant for screening.
     * These are not the general S/I/R breakpoints (those live in
     * bdsis_bact_mic_breakpoints()) -- they are the specific confirmatory-
     * flow screens, split per confirmatory panel so each has its own
     * trigger vocabulary and the ESBL panel does NOT fire on CRO alone.
     *
     * ESBL panel:   CTX > 1  OR  CAZ > 4             (CRO deliberately excluded)
     * CPE  panel:   ETP > 0.5  OR  IPM > 1  OR  MEM > 1
     * AmpC panel:   CTX > 1 AND CRO > 1               (2026-10-08: CAZ dropped)
     *               and FOX > 8 for cefoxitin confirmation
     *
     * @param  string $section  'esbl' | 'cpe' | 'ampc'  (default 'esbl')
     * @return array            code => float threshold
     */
    function bdsis_bact_mic_phenotype_thresholds($section = 'esbl')
    {
        $section = strtolower((string)$section);
        if ($section === 'cpe') {
            return array('ETP' => 0.5, 'IPM' => 1, 'MEM' => 1);
        }
        if ($section === 'ampc') {
            /* 2026-10-08 spec: CAZ removed from the AmpC co-trigger. The
               panel now opens on CTX AND CRO alone; FOX stays as the
               cefoxitin screen for in-panel interpretation. */
            return array('CTX' => 1, 'CRO' => 1, 'FOX' => 8);
        }
        /* ESBL (2026-10-05 spec): CTX > 1 OR CAZ > 4 OR CRO > 1. CRO added so
           MIC isolates where only Ceftriaxone is elevated also fire ESBL. */
        return array('CTX' => 1, 'CAZ' => 4, 'CRO' => 1);
    }
}

if (!function_exists('bdsis_bact_mic_proxy_results')) {
    /**
     * Project MIC rows into code => 'Resistant' | 'Susceptible' using the
     * ESBL + CPE phenotype thresholds combined. This is what the shared
     * resistance plan core (bdsis_resistance_plan_core) consumes to decide
     * which confirmatory sections are triggered.
     *
     * Deliberately EXCLUDES CRO even though CRO is on the DD ESBL trigger
     * list (CAZ/CTX/CPD/CRO) -- the user spec for MIC-mode ESBL triggers
     * on CTX > 1 OR CAZ > 4 only. CRO is handled separately for AmpC
     * co-triggering via bdsis_bact_mic_proxy_results_ampc().
     *
     * Rows with no value, or whose value does not parse as a positive
     * number, are skipped (no entry in the returned map).
     *
     * @param  array $micRows  shape returned by bdsis_bact_mic_parse_post()
     * @return array           code => 'Resistant' | 'Susceptible'
     */
    function bdsis_bact_mic_proxy_results($micRows)
    {
        $out = array();
        if (!is_array($micRows)) { return $out; }
        $thr = array_merge(
            bdsis_bact_mic_phenotype_thresholds('esbl'),   // CTX, CAZ
            bdsis_bact_mic_phenotype_thresholds('cpe')     // ETP, IPM, MEM
        );
        foreach ($thr as $code => $limit) {
            if (!isset($micRows[$code]) || !is_array($micRows[$code])) { continue; }
            $v = isset($micRows[$code]['value']) ? trim((string)$micRows[$code]['value']) : '';
            if ($v === '') { continue; }
            if (!preg_match('~\d+(\.\d+)?~', $v, $m)) { continue; }
            $num = (float)$m[0];
            $out[$code] = ($num > $limit) ? 'Resistant' : 'Susceptible';
        }
        return $out;
    }
}

if (!function_exists('bdsis_bact_mic_proxy_results_ampc')) {
    /**
     * AmpC-specific projection. The AmpC trigger wants CTX AND CRO both
     * 'Resistant' (bdsis_ampc_is_triggered, 2026-10-08 spec; CAZ was
     * dropped), so CRO must be present in the map even though it does
     * not trigger ESBL on its own.
     *
     * @return array  code => 'Resistant' | 'Susceptible'
     */
    function bdsis_bact_mic_proxy_results_ampc($micRows)
    {
        $out = array();
        if (!is_array($micRows)) { return $out; }
        $thr = bdsis_bact_mic_phenotype_thresholds('ampc');  // CTX, CRO, FOX
        foreach ($thr as $code => $limit) {
            if (!isset($micRows[$code]) || !is_array($micRows[$code])) { continue; }
            $v = isset($micRows[$code]['value']) ? trim((string)$micRows[$code]['value']) : '';
            if ($v === '') { continue; }
            if (!preg_match('~\d+(\.\d+)?~', $v, $m)) { continue; }
            $num = (float)$m[0];
            $out[$code] = ($num > $limit) ? 'Resistant' : 'Susceptible';
        }
        return $out;
    }
}

if (!function_exists('bdsis_bact_mic_resistance_plan')) {
    /**
     * MIC-mode counterpart of bdsis_bact_resistance_plan(): validates and
     * interprets one pathogen row's confirmatory tests when the AST method
     * is MIC. Section-aware: only the sections the user has actually
     * engaged with are validated. A section the user has NOT touched is
     * silently skipped even when the MIC values would trip its screen --
     * the panel appears informationally (see bpMicResistanceSync in
     * lab.php) but the save is never refused for an untouched section.
     *
     *   ESBL section:   validated iff any esbl_method / esbl_zone / esbl_result
     *                   field for this row carries a non-empty value.
     *   CPE  section:   validated iff any cpe_agent / mcim_* / ecim_* /
     *                   cpe_interp field carries a non-empty value.
     *
     * Core itself is unchanged -- we just mute the trigger results for a
     * section the user hasn't engaged with (R -> Susceptible for that code),
     * which makes core treat the section as "not triggered" and bypass its
     * completeness checks for that section.
     *
     * @param  mysqli $bdsis
     * @param  mixed  $rowIdx   form row index (pathogen[i])
     * @param  string $label    row label for messages, e.g. "Enteric Pathogen 2"
     * @param  array  $micRows  bdsis_bact_mic_parse_post() output
     * @param  array  $post     the whole request array
     * @return array            'ok', 'error', 'esbl', 'cpe'
     */
    function bdsis_bact_mic_resistance_plan($bdsis, $rowIdx, $label, $micRows, $post)
    {
        $results = bdsis_bact_mic_proxy_results($micRows);
        $field = function ($name, $sub = null) use ($post, $rowIdx) {
            if (!isset($post[$name]) || !is_array($post[$name]) || !isset($post[$name][$rowIdx])) { return ''; }
            $v = $post[$name][$rowIdx];
            if ($sub !== null) { $v = (is_array($v) && isset($v[$sub])) ? $v[$sub] : ''; }
            return is_array($v) ? '' : trim((string)$v);
        };

        /* Section-engagement check -- was any ESBL field touched for this row? */
        $esblAnyEntered = false;
        if (function_exists('bdsis_esbl_agents')) {
            foreach (bdsis_esbl_agents($bdsis) as $code => $_ag) {
                if ($field('esbl_method', $code) !== '' || $field('esbl_zone', $code) !== '') {
                    $esblAnyEntered = true;
                    break;
                }
            }
        }
        if (!$esblAnyEntered && $field('esbl_result') !== '') { $esblAnyEntered = true; }

        /* And any CPE field? "CPE" here spans the whole Carbapenemase slot:
           the mCIM/eCIM Carbapenemase Detection flow AND the standalone Carba
           NP test. Both the user-visible panels live inside #bpConf and both
           persist to bacteriology_resistance_table, so a MIC save that
           carries Carba NP tubes alone must keep the CPE triggers live --
           otherwise bdsis_resistance_plan_core skips its CPE block and the
           Carba NP data is silently dropped. 2026-10-10: carba_np_tube_a /
           carba_np_tube_b were added to the engagement list for parity with
           the DD save path, which validates them inside the same CPE block. */
        $cpeAnyEntered = false;
        foreach (array('cpe_agent','mcim_method','mcim_zone','mcim_colonies','ecim_method','ecim_zone','cpe_interp','carba_np_tube_a','carba_np_tube_b') as $f) {
            if ($field($f) !== '') { $cpeAnyEntered = true; break; }
        }

        /* Mute triggers for sections the user hasn't engaged with so core
           treats them as "not triggered" and skips its completeness checks.
           A section the user HAS engaged with is validated fully -- partial
           ESBL data still fails with the specific "enter a valid zone..."
           message the DD path uses, which is what we want. */
        if (function_exists('bdsis_bact_trigger_codes')) {
            $trig = bdsis_bact_trigger_codes();
            if (!$esblAnyEntered) {
                foreach ((array)$trig['esbl'] as $c) {
                    if (isset($results[$c]) && $results[$c] === 'Resistant') {
                        $results[$c] = 'Susceptible';
                    }
                }
            }
            if (!$cpeAnyEntered) {
                foreach ((array)$trig['cpe'] as $c) {
                    if (isset($results[$c]) && ($results[$c] === 'Resistant' || $results[$c] === 'Intermediate')) {
                        $results[$c] = 'Susceptible';
                    }
                }
            }
        }

        if (!function_exists('bdsis_resistance_plan_core')) {
            /* lab-helpers.php not loaded in this request -- treat as "no plan"
               so the MIC primary save still goes through. */
            return array('ok' => true, 'error' => '', 'esbl' => null, 'cpe' => null);
        }
        return bdsis_resistance_plan_core($bdsis, $results, $label, $field);
    }
}
