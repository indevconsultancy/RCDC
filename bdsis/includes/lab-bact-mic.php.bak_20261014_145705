if (!function_exists('bdsis_bact_mic_interpret')) {
    /**
     * MIC value → interpretation string ('Susceptible'/'Intermediate'/'Resistant').
     *
     * Takes the first numeric substring from the user's input (so "<=0.5"
     * reads as 0.5, "16^" as 16, ">64" as 64), then compares against the
     * numeric Susceptible / Resistant thresholds from the breakpoint record:
     *   value ≤ s  → Susceptible
     *   value ≥ r  → Resistant
     *   otherwise  → Intermediate
     * Returns '' (blank) when the antibiotic code is not in the breakpoint
     * map or the value cannot be parsed to a positive number.
     *
     * @return string
     */
    function bdsis_bact_mic_interpret($code, $value)
    {
        $code = strtoupper(trim((string)$code));
        $bps  = bdsis_bact_mic_breakpoints();
        if (!isset($bps[$code])) { return ''; }
        $v = trim((string)$value);
        if ($v === '') { return ''; }
        if (!preg_match('~\d+(\.\d+)?~', $v, $m)) { return ''; }
        $num = (float)$m[0];
        if ($num <= 0) { return ''; }
        $sThr = isset($bps[$code]['s']) ? (float)$bps[$code]['s'] : null;
        $rThr = isset($bps[$code]['r']) ? (float)$bps[$code]['r'] : null;
        if ($sThr !== null && $num <= $sThr) { return 'Susceptible'; }
        if ($rThr !== null && $num >= $rThr) { return 'Resistant'; }
        return 'Intermediate';
    }
}

if (!function_exists('bdsis_bact_mic_table_exists')) {
    /**
     * Positive-only memoised probe: true iff bacteriology_mic_table is on
     * this database. A FALSE result is NOT cached so that the next call --
     * after bdsis_bact_mic_table_ensure() may have created the table in
     * the same request -- sees the up-to-date state.
     */
    function bdsis_bact_mic_table_exists($bdsis)
    {
        static $exists = null;
        if ($exists === true) { return true; }    // only cache positive
        if (!($bdsis instanceof mysqli)) { return false; }
        $q = @$bdsis->query("SHOW TABLES LIKE 'bacteriology_mic_table'");
        $has = ($q && $q->num_rows > 0);
        if ($q) { $q->free(); }
        if ($has) { $exists = true; }
        return $has;
    }
}

if (!function_exists('bdsis_bact_mic_table_ensure')) {
    /**
     * Idempotent: creates bacteriology_mic_table if missing. Returns true
     * when the table is ready to accept writes, false when creation failed
     * (e.g. the DB account doesn't hold CREATE). The save path calls this
     * on every MIC save so a fresh install, or an environment where the
     * manual migration SQL was never applied, auto-heals on first use
     * instead of silently losing the user's data.
     *
     * Schema matches db-migrations/2026-10-03-bact-mic-table.sql byte-for-byte
     * so applying the migration manually after this ran is a no-op.
     *
     * @return bool
     */
    function bdsis_bact_mic_table_ensure($bdsis)
    {
        if (bdsis_bact_mic_table_exists($bdsis)) { return true; }
        if (!($bdsis instanceof mysqli)) { return false; }
        $sql = "CREATE TABLE IF NOT EXISTS bacteriology_mic_table (\n"
             . "  id                 INT(11)      NOT NULL AUTO_INCREMENT,\n"
             . "  brt2_id            INT(11)      NOT NULL,\n"
             . "  antimicrobial_code VARCHAR(15)  NOT NULL,\n"
             . "  mic_value          VARCHAR(20)  NULL,\n"
             . "  ast_result         VARCHAR(30)  NULL,\n"
             . "  recorded_on        DATETIME     NULL,\n"
             . "  PRIMARY KEY (id),\n"
             . "  KEY idx_brt2 (brt2_id),\n"
             . "  KEY idx_brt2_code (brt2_id, antimicrobial_code)\n"
             . ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4";
        $ok = @$bdsis->query($sql);
        if (!$ok) { return false; }
        /* The positive-only memo in _table_exists re-probes on the next call,
           which will now hit the newly created table and flip the cache. */
        return bdsis_bact_mic_table_exists($bdsis);
    }
}

if (!function_exists('bdsis_bact_mic_load_saved')) {
    /**
     * Saved MIC readings for one isolate -- now from the dedicated
     * bacteriology_mic_table (added 2026-10-03). The earlier Phase 1 attempt
     * stored MIC rows in bacteriology_ast_table.zone_diameter, which is a
     * DECIMAL column in the Bacteriology schema and could not accept strings
     * like "<=0.5". The MIC flow now has its own VARCHAR-friendly table.
     *
     * Returns map code => array('value','result'). Empty when the migration
     * hasn't been run or nothing is stored.
     *
     * @return array
     */
    function bdsis_bact_mic_load_saved($bdsis, $brt2id)
    {
        $out = array();
        $brt2id = (int)$brt2id;
        if ($brt2id <= 0 || !($bdsis instanceof mysqli)) { return $out; }
        if (!bdsis_bact_mic_table_exists($bdsis)) { return $out; }
        $q = @$bdsis->query("SELECT antimicrobial_code, mic_value, ast_result
                               FROM bacteriology_mic_table
                              WHERE brt2_id=".$brt2id);
        if ($q) {
            while (list($c, $z, $r) = $q->fetch_row()) {
                $out[strtoupper((string)$c)] = array(
                    'value'  => ($z === null ? '' : (string)$z),
                    'result' => (string)$r,
                );
            }
            $q->free();
        }
        return $out;
    }
}

if (!function_exists('bdsis_bact_mic_panel_html')) {
    /**
     * The MIC AST sub-panel for one pathogen row. Sibling of #bpDd{idx};
     * lab.php toggles between them via bpSetAstMethod().
     *
     * @param  string $idx    row index (matches the DD panel)
     * @param  array  $saved  code => array('value','result'); empty for new rows
     * @param  bool   $show   initial visibility (true when method='02')
     * @return string
     */
    function bdsis_bact_mic_panel_html($idx, $saved = array(), $show = false)
    {
        $hv  = function ($v) { return htmlspecialchars((string)$v, ENT_QUOTES); };
        $bps = bdsis_bact_mic_breakpoints();

        $h  = '<div class="lr-bact-mic" id="bpMic'.$idx.'" style="display:'.($show ? 'block' : 'none').';">';
        $h .= '<div class="lr-subcard lr-subcard--ast lr-subcard--mic">';
        $h .= '<div class="lr-subcard__head"><h4 class="lr-subcard__title">Antimicrobial Susceptibility &mdash; MIC</h4>'
            . '<span class="lr-subcard__meta">Minimum Inhibitory Concentration (mg/L) &middot; interpreted as you type</span></div>';
        /* Column layout aligned with the Disk Diffusion grid (2026-10-07):
             Antibiotic | Method | MIC (mg/L) | Interpretation
           The per-row Method column shows the fixed "MIC" chip, mirroring
           the "Disk Diffusion" chip on the DD side. The S/I/R reference
           values stay as a per-input tooltip (hover the MIC field) so they
           remain discoverable without taking a column of their own. */
        $h .= '<div class="row lr-grid-head d-none d-md-flex">'
            . '<div class="col-md-3">Antibiotic</div>'
            . '<div class="col-md-3">Method</div>'
            . '<div class="col-md-2">MIC (mg/L)</div>'
            . '<div class="col-md-4">Interpretation</div></div>';

        $j = 0;
        foreach ($bps as $code => $bp) {
            $cur    = isset($saved[$code]) ? $saved[$code] : array('value'=>'', 'result'=>'');
            $vId    = 'bpMicVal'.$idx.'_'.$code;
            $rId    = 'bpMicRes'.$idx.'_'.$code;
            $hintS  = $bp['mic_s'];
            $hintI  = $bp['mic_i'];
            $hintR  = $bp['mic_r'];

            $h .= '<div class="row lr-line bp-mic-row">';
            /* Antibiotic + hidden code (code[idx][j] is reused per DD; MIC
               posts its own `mic_value[idx][code]` keyed by antibiotic code
               so DD and MIC never share input names. */
            $h .= '<div class="col-md-3 lr-cell lr-cell--name"><span class="lr-agent">'.$hv($bp['agent']).'</span>'
                . '<span class="lr-agent-sub">'.$hv($code).'</span></div>';
            /* Method chip, mirroring the DD "Disk Diffusion" chip. */
            $h .= '<div class="col-md-3 lr-cell d-none d-md-block"><span class="lr-chip">MIC</span></div>';
            /* MIC value input (2026-10-07 UI alignment): type="number" numeric
               stepper with up/down arrows, matching the Zone (mm) field on the
               Disk Diffusion grid. The S/I/R reference values live on the
               title tooltip (hover) so lab techs still see what their value is
               being read against. Interpretation (bpBactMicInterpret) uses the
               first numeric substring of the value, which works identically
               for a numeric-input value as it did for a text value. */
            $bpHint = 'S '.$hintS.' · I '.$hintI.' · R '.$hintR;
            $h .= '<div class="col-6 col-md-2 lr-cell"><label class="lr-cell-label" for="'.$vId.'">MIC (mg/L)<span class="sr-only">, '.$hv($bp['agent']).'</span>:</label>'
                . '<input type="number" step="any" min="0" name="mic_value['.$idx.']['.$code.']" id="'.$vId.'"'
                . ' class="form-control text-center bp-mic-value" data-code="'.$hv($code).'"'
                . ' data-s="'.$hv((string)$bp['s']).'" data-r="'.$hv((string)$bp['r']).'"'
                . ' value="'.$hv($cur['value']).'" autocomplete="off"'
                . ' title="Breakpoints: '.$hv($bpHint).'"'
                . ' oninput="bpBactMicInterpret(this);" /></div>';
            /* Interpretation pill */
            $h .= '<div class="col-6 col-md-4 lr-cell"><label class="lr-cell-label" for="'.$rId.'">Result<span class="sr-only">, '.$hv($bp['agent']).'</span>:</label>'
                . '<input type="text" name="mic_result['.$idx.']['.$code.']" id="'.$rId.'"'
                . ' value="'.$hv($cur['result']).'" class="form-control lr-pill bp-mic-result"'
                . ' readonly tabindex="-1" aria-label="MIC result, '.$hv($bp['agent']).'" /></div>';
            $h .= '</div>';
            $j++;
        }

        $h .= '<div class="lr-help"><i class="fas fa-info-circle" aria-hidden="true"></i><span>'
            . 'Enter the MIC value in mg/L as a number (e.g. <code>0.5</code>, <code>2</code>, <code>16</code>). '
            . 'Use the up / down arrows or type directly; the interpretation updates automatically from the per-antibiotic breakpoints (hover the input to see S / I / R). '
            . 'Leave a row blank if the antibiotic was not tested &mdash; the save path writes nothing for empty rows.'
            . '</span></div>';
        $h .= '</div></div>';
        return $h;
    }
}

if (!function_exists('bdsis_bact_mic_parse_post')) {
    /**
     * Pull one row's MIC fields from $_POST and return normalised rows ready
     * for save. Each entry: code => array('value','result'). Rows with empty
     * value are returned so the save path can DELETE them (replace semantics).
     *
     * @return array
     */
    function bdsis_bact_mic_parse_post($rowIdx, $post)
    {
        $out    = array();
        $values = (isset($post['mic_value'][$rowIdx]) && is_array($post['mic_value'][$rowIdx])) ? $post['mic_value'][$rowIdx] : array();
        foreach (bdsis_bact_mic_breakpoints() as $code => $_bp) {
            $raw = isset($values[$code]) ? trim((string)$values[$code]) : '';
            if ($raw === '') { $out[$code] = array('value'=>'', 'result'=>''); continue; }
            /* Server-side normalisation (reuses the E. coli MIC grammar). */
            $norm = function_exists('bdsis_mic_normalize_value') ? bdsis_mic_normalize_value($raw) : $raw;
            if ($norm === null) {
                /* Invalid grammar -> treat as empty rather than storing junk. */
                $out[$code] = array('value'=>'', 'result'=>''); continue;
            }
            $out[$code] = array(
                'value'  => (string)$norm,
                'result' => bdsis_bact_mic_interpret($code, $norm),
            );
        }
        return $out;
    }
}

if (!function_exists('bdsis_bact_mic_save')) {
    /**
     * Replace-semantics write for one isolate's MIC readings into the
     * dedicated bacteriology_mic_table (VARCHAR mic_value column accepts
     * comparator-prefixed strings cleanly). Deletes any prior rows for the
     * brt2_id, then INSERTs one row per non-empty antibiotic.
     *
     * When the migration hasn't been applied yet, returns TRUE (no-op) so a
     * save POST still succeeds for other data on the form -- just no MIC rows
     * are persisted. The admin runs the SQL once and the save starts working.
     *
     * ALSO deletes any method='02' rows the earlier (broken) Phase 1 code
     * accidentally attempted to write into bacteriology_ast_table, so a
     * record that was stuck in that state cleans itself on the next save.
     *
     * @return bool
     */
    function bdsis_bact_mic_save($bdsis, $brt2id, $rows)
    {
        $brt2id = (int)$brt2id;
        if ($brt2id <= 0 || !($bdsis instanceof mysqli)) { return false; }

        /* Clean up any stale ast_method_id='02' rows the earlier Phase 1 code
           may have left in bacteriology_ast_table before this bug-fix shipped
           (they'd be numeric-only, since the DECIMAL column rejected MIC
           strings). Safe to run unconditionally. */
        $delLegacy = @$bdsis->prepare("DELETE FROM bacteriology_ast_table WHERE brt2_id=? AND ast_method_id='02'");
        if ($delLegacy) {
            $delLegacy->bind_param("i", $brt2id);
            $delLegacy->execute();
            $delLegacy->close();
        }

        /* FAIL LOUDLY if the dedicated MIC table is missing AND we cannot
           create it. The earlier design silently succeeded in this case,
           which meant a user's MIC save vanished without any error -- the
           exact failure mode behind the "Method reverts to Disk Diffusion
           on reload" bug. The ensure call runs an idempotent
           CREATE TABLE IF NOT EXISTS so a fresh install just works. */
        if (!bdsis_bact_mic_table_ensure($bdsis)) { return false; }

        $del = @$bdsis->prepare("DELETE FROM bacteriology_mic_table WHERE brt2_id=?");
        if (!$del) { return false; }
        $del->bind_param("i", $brt2id);
        $del->execute();
        $del->close();

        if (!is_array($rows) || count($rows) === 0) { return true; }

        $ins = @$bdsis->prepare("INSERT INTO bacteriology_mic_table
                                 (brt2_id, antimicrobial_code, mic_value, ast_result, recorded_on)
                                 VALUES (?, ?, ?, ?, NOW())");
        if (!$ins) { return false; }
        foreach ($rows as $code => $row) {
            $v = isset($row['value']) ? (string)$row['value'] : '';
            if ($v === '') { continue; }   // empty rows are not persisted (user didn't test that antibiotic)
            $c = strtoupper((string)$code);
            $r = isset($row['result']) ? (string)$row['result'] : '';
            $ins->bind_param("isss", $brt2id, $c, $v, $r);
            if (!$ins->execute()) { $ins->close(); return false; }
        }
        $ins->close();
        return true;
    }
}

if (!function_exists('bdsis_bact_mic_delete_dd')) {
    /**
     * When the user switches a row FROM Disk Diffusion TO MIC on an edit,
     * iu-lab.php calls this so stale DD rows for the isolate are cleared.
     * Only DD rows (ast_method_id='01') are removed; AmpC/ESBL/CPE tables
     * live elsewhere and are not touched.
     *
     * @return bool
     */
    function bdsis_bact_mic_delete_dd($bdsis, $brt2id)
    {
        $brt2id = (int)$brt2id;
        if ($brt2id <= 0 || !($bdsis instanceof mysqli)) { return false; }
        $q = @$bdsis->prepare("DELETE FROM bacteriology_ast_table WHERE brt2_id=? AND ast_method_id='01'");
        if (!$q) { return false; }
        $q->bind_param("i", $brt2id);
        $ok = $q->execute();
