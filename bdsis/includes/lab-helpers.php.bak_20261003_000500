     * Sourced from ms_ecoli_strain_table instead of being hardcoded. '98' (Non
     * DEC) and '99' (Not Required) are deliberately excluded -- the form only
     * ever recorded the six DEC pathotypes.
     *
     * @param  mysqli $bdsis
     * @return array  strain_id => ecoli_strain
     */
    function bdsis_ecoli_pcr_strains($bdsis)
    {
        $strains = array();
        if (!($bdsis instanceof mysqli)) {
            return $strains;
        }
        $qry = $bdsis->query(
            "SELECT strain_id, ecoli_strain FROM ms_ecoli_strain_table
              WHERE strain_id IN ('01','02','03','04','05','06') ORDER BY strain_id"
