if (!function_exists('bdsis_rotavirus_gp_save')) {
    /**
     * BDSIS New Field Request - Rotavirus Genotyping.
     *
     * Replace a subject's stored G/P genotypes. Callers pass the posted ids;
     * anything not an ACTIVE genotype is dropped, so an unknown or injected
     * value can never be stored. Passing an empty list simply clears them,
     * which is what happens when the two gating conditions stop holding.
     *
     * @param  array $ids posted genotype ids
     * @return bool  false only when the table is missing
     */
    function bdsis_rotavirus_gp_save($bdsis, $sid, $ids, $user, $today)
    {
        if (!($bdsis instanceof mysqli) || trim((string) $sid) === '') { return false; }
        $del = $bdsis->prepare("DELETE FROM rcdc_elisa_genotype_table WHERE subject_id=?");
        if (!$del) { return false; }
        $del->bind_param("s", $sid);
        $del->execute();
        $del->close();

        $allowed = bdsis_active_rotavirus_genotypes($bdsis);
        $clean   = array();
        foreach ((array) $ids as $gid) {
            $gid = trim((string) $gid);
            if ($gid !== '' && array_key_exists($gid, $allowed)) { $clean[$gid] = true; }
        }
        if (count($clean) === 0) { return true; }

        $ins = $bdsis->prepare(
            "INSERT INTO rcdc_elisa_genotype_table (subject_id, genotype_id, recorded_by, recorded_on)
             VALUES (?,?,?,?)"
        );
        if (!$ins) { return false; }
        foreach (array_keys($clean) as $gid) {
            $ins->bind_param("ssss", $sid, $gid, $user, $today);
            $ins->execute();
        }
        $ins->close();

        return true;
    }
}

