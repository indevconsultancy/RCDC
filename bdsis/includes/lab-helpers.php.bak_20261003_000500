if (!function_exists('bdsis_carbapenemase_result')) {
    // START ESBL / CARBAPENEMASE CHANGE
    /**
     * Final Carbapenemase Result, generated from the mCIM / eCIM readings:
     *   mCIM Positive + eCIM read -> the eCIM outcome itself
     *                                ("Metallo-β-lactamase (MBL) detected" or
     *                                 "Serine carbapenemase detected")
     *   mCIM Positive, no eCIM    -> Carbapenemase Positive (not storable: the
     *                                save requires the eCIM first)
     *   mCIM Negative             -> Carbapenemase Negative (eCIM not required)
     *   mCIM Indeterminate        -> Carbapenemase Indeterminate
     *   anything else             -> '' (never classified)
     * The requirement defines Positive and Negative only; Indeterminate is
     * carried through rather than being forced into either, because an
     * indeterminate mCIM does not proceed to eCIM and must not read as a result
     * it is not.
     *
     * @param  string      $mcimResult
     * @param  string|null $ecimResult bdsis_ecim_interpret() output
     * @return string
     */
    function bdsis_carbapenemase_result($mcimResult, $ecimResult = null)
    {
        if ($mcimResult === 'Positive') {
            return ($ecimResult !== null && $ecimResult !== '') ? (string)$ecimResult : 'Carbapenemase Positive';
        }
        if ($mcimResult === 'Negative')      { return 'Carbapenemase Negative'; }
        if ($mcimResult === 'Indeterminate') { return 'Carbapenemase Indeterminate'; }
        return '';
    }
    // END ESBL / CARBAPENEMASE CHANGE
}

