            $v = $post[$name][$key];
            if ($sub !== null) { $v = (is_array($v) && isset($v[$sub])) ? $v[$sub] : ''; }
            return is_array($v) ? '' : trim((string)$v);
        };
        return bdsis_resistance_plan_core($bdsis, $results, $label, $field);
    }
}

/* ---------------------------------------------------------------------------
   Conditional ESBL / carbapenemase sub-panels.
   Moved here from lab/lab.php so lab/load-ecoli-ast.php can render the same
   two panels for an E. coli pathotype record. The markup, field names and
   ids are unchanged; the caller decides the index, and the E.coli panel uses
   'E' . prt3_record_id so its ids cannot collide with a pathogen row's.
