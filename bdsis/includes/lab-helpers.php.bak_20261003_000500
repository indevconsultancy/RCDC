if (!function_exists('bdsis_resistance_report_rows_for')) {
    /** Report rows for an already-loaded record. @return string */
    function bdsis_resistance_report_rows_for($bdsis, $r)
    {
        if ($r === null) { return ''; }
        $h  = function ($v) { return htmlspecialchars((string)$v, ENT_QUOTES); };
        $u  = function ($v) use ($h) { $v = trim((string)$v); return '<u>' . ($v === '' ? '-' : $h($v)) . '</u>'; };
        $html = '';

        if ($r['esbl'] !== null) {
            $e = $r['esbl'];
            $html .= '<tr><td colspan=8><label><B>ESBL Test</B> &mdash; triggered: ' . $h(implode(', ', $e['triggered_by'])) . ' Resistant</label></td></tr>';
            $html .= '<tr><td colspan=2><label><B>Antibiotic</B></label></td><td colspan=2><label><B>Method</B></label></td>'
                   . '<td colspan=2><label><B>Zone Diameter</B></label></td><td colspan=2><label><B>Increase vs plain disc</B></label></td></tr>';
            $agents = bdsis_esbl_agents($bdsis);
            foreach ($agents as $code => $ag) {
                if (!isset($e['agents'][$code])) { continue; }
                $row  = $e['agents'][$code];
                $diff = '';
                if ($ag['pair'] !== '' && isset($e['agents'][$ag['pair']]) && $row['zone'] !== '' && $e['agents'][$ag['pair']]['zone'] !== '') {
                    $d = (float)$row['zone'] - (float)$e['agents'][$ag['pair']]['zone'];
                    $diff = ($d >= 0 ? '+' : '') . rtrim(rtrim(number_format($d, 1, '.', ''), '0'), '.') . ' mm';
                }
                $html .= '<tr><td colspan=2><label>' . $u($ag['label'] . ' (' . html_entity_decode($ag['content']) . ')') . '</label></td>'
                       . '<td colspan=2><label>' . $u($row['method']) . '</label></td>'
                       . '<td colspan=2><label>' . $u($row['zone']) . '</label></td>'
                       . '<td colspan=2><label>' . ($diff === '' ? '' : $u($diff)) . '</label></td></tr>';
            }
            $html .= '<tr><td colspan=8><label>Final ESBL Status: <B>' . $u($e['result']) . '</B></label></td></tr>';
        }

        if ($r['cpe'] !== null) {
            $c = $r['cpe'];
            // START ESBL / CARBAPENEMASE CHANGE
            $isMcim = ($c['mcim_method'] === 'mCIM');
            /* Carbapenem disc: code plus the master name when it resolves. */
            $agentTxt = $c['agent'];
            if ($agentTxt !== '') {
                $an = @$bdsis->query("SELECT antimicrobial_agent FROM ms_ast_table WHERE ast_method_id='01' AND code='" . $bdsis->real_escape_string($agentTxt) . "'");
                if ($an && $an->num_rows > 0) { list($anName) = $an->fetch_row(); if ((string)$anName !== '') { $agentTxt .= ' (' . $anName . ')'; } }
            }
            $html .= '<tr><td colspan=8><label><B>Carbapenems Test</B> &mdash; triggered: ' . $h(implode(', ', $c['triggered_by'])) . ' Resistant/Intermediate</label></td></tr>';
            $html .= '<tr><td colspan=8><label>Antibiotic: ' . $u($agentTxt) . '</label></td></tr>';
            $html .= '<tr><td colspan=2><label><B>Test</B></label></td><td colspan=2><label><B>Method</B></label></td>'
                   . '<td colspan=2><label><B>Zone Diameter</B></label></td><td colspan=2><label><B>Interpretation</B></label></td></tr>';
            $html .= '<tr><td colspan=2><label>' . ($isMcim ? 'mCIM' : 'Carbapenemase')
                   . ($isMcim && $c['mcim_colonies'] !== '' ? ' (colonies within zone: ' . $h($c['mcim_colonies']) . ')' : '') . '</label></td>'
                   . '<td colspan=2><label>' . $u($c['mcim_method']) . '</label></td>'
                   . '<td colspan=2><label>' . $u($c['mcim_zone']) . '</label></td>'
                   . '<td colspan=2><label>' . $u($isMcim ? $c['mcim_result'] : $c['result']) . '</label></td></tr>';
            if ($isMcim && $c['mcim_result'] === 'Positive' && $c['ecim_method'] !== '') {
                /* The measured difference the MBL / serine call is made on, shown
                   the way the ESBL pair shows its increase. */
                $eDiff = '';
                if ($c['ecim_zone'] !== '' && $c['mcim_zone'] !== '') {
                    $d = (float)$c['ecim_zone'] - (float)$c['mcim_zone'];
                    $eDiff = ' (' . ($d >= 0 ? '+' : '') . rtrim(rtrim(number_format($d, 1, '.', ''), '0'), '.') . ' mm vs mCIM)';
                }
                $html .= '<tr><td colspan=2><label>eCIM' . $h($eDiff) . '</label></td>'
                       . '<td colspan=2><label>' . $u($c['ecim_method']) . '</label></td>'
                       . '<td colspan=2><label>' . $u($c['ecim_zone']) . '</label></td>'
                       . '<td colspan=2><label>' . $u($c['ecim_result']) . '</label></td></tr>';
            } elseif ($isMcim) {
                /* The requirement is explicit that a non-positive mCIM stops here. */
                $html .= '<tr><td colspan=2><label>eCIM</label></td>'
                       . '<td colspan=6><label><u>eCIM not required</u></label></td></tr>';
            } else {
                $html .= '<tr><td colspan=2><label>eCIM</label></td>'
                       . '<td colspan=6><label><u>Not applicable (method: ' . $h($c['mcim_method']) . ')</u></label></td></tr>';
            }
            $html .= '<tr><td colspan=8><label>Carbapenemase Result: <B>' . $u($c['result']) . '</B></label></td></tr>';
            // END ESBL / CARBAPENEMASE CHANGE
        }

        return $html;
    }
}

if (!function_exists('bdsis_ecoli_ast_results')) {
    /**
     * What one E. coli AST panel has actually recorded: code => interpretation.
     *
     * This is what the ESBL / carbapenemase triggers read, and it is deliberately
     * the RECORDED interpretation rather than anything re-derived from a number:
     *
     *   Disk Diffusion  the zone read through the same CLSI thresholds the save
     *                   applies, so the trigger and the stored ast_result agree.
     *   MIC             the reader's own S / I / R / SDD / N/A. An MIC value is
     *                   never classified here -- 16 mg/L means nothing without a
     *                   breakpoint for that organism, so only what the reader
     *                   stated counts. SDD and N/A trigger nothing.
     *
     * @param  mysqli $bdsis
     * @param  string $methodId    ms_ast_method_table id posted for the panel
     * @param  string $letter      the panel's suffix in the flat field names (a..l)
     * @param  array  $post        $_POST
     * @param  array  $breakpoints bdsis_ast_breakpoints()
     * @param  array  $micRows     validated rows from bdsis_ecoli_mic_parse()
     * @return array  code => interpretation
     */
    function bdsis_ecoli_ast_results($bdsis, $methodId, $letter, $post, $breakpoints, $micRows = array())
    {
        $out = array();
        $methodId = (string)$methodId;

        if ($methodId === '01') {
            $cntrKey = 'cntr' . $letter;
            $cntr = (isset($post[$cntrKey]) && !is_array($post[$cntrKey])) ? (int)$post[$cntrKey] : 0;
            for ($i = 1; $i <= $cntr; $i++) {
                $cKey = 'code' . $letter . $i;
                $zKey = 'zone' . $letter . $i;
                $code = (isset($post[$cKey]) && !is_array($post[$cKey])) ? strtoupper(trim((string)$post[$cKey])) : '';
                $zone = (isset($post[$zKey]) && !is_array($post[$zKey])) ? $post[$zKey] : '';
                if ($code === '' || !isset($breakpoints[$code])) { continue; }
                $out[$code] = bdsis_ast_interpret_zone($zone, $breakpoints[$code]);
            }
            return $out;
        }

        if ($methodId === bdsis_mic_method_id()) {
            foreach ((array)$micRows as $row) {
                if (!is_array($row) || !isset($row['code'])) { continue; }
                $out[strtoupper((string)$row['code'])] = isset($row['result']) ? (string)$row['result'] : '';
            }
        }
        return $out;
    }
}

