if (!function_exists('bdsis_rotavirus_gp_groups')) {
    /**
     * BDSIS New Field Request - Rotavirus Genotyping.
     *
     * The active genotypes split into the two families the request asks for:
     *   G type  G1 G2 G3 G4 G8 G9 G10 G12
     *   P type  P[4] P[6] P[8] P[9] P[10] P[11]
     * Split on the label, so the master table stays the single source of the
     * values and nothing here has to be kept in step with it by hand. Combined
     * labels such as "G1P[8]" are inactive rows and never reach this list.
     *
     * @param  mysqli $bdsis
     * @return array array('G' => id => label, 'P' => id => label)
     */
    function bdsis_rotavirus_gp_groups($bdsis)
    {
        /* genotype_group says which picker a row belongs to when the label
           cannot: "UT" starts with neither G nor P, and UT in the G column is a
           different observation from UT in the P column, so each has its own row
           and its own id. Rows without a group (every pre-existing one) keep
           being classified by their label exactly as before.
           See sql/2026-09-18_rotavirus_ut_genotype.sql. */
        $groups = array();
        $res = ($bdsis instanceof mysqli)
            ? @$bdsis->query("SELECT genotype_id, genotype_group FROM ms_rotavirus_genotype_table")
            : false;
        if ($res) {
            while (list($gid, $grp) = $res->fetch_row()) {
                $grp = strtoupper(trim((string) $grp));
                if ($grp === 'G' || $grp === 'P') { $groups[(string) $gid] = $grp; }
            }
            $res->free();
        }

        $out = array('G' => array(), 'P' => array());
        foreach (bdsis_active_rotavirus_genotypes($bdsis) as $gid => $label) {
            $trimmed = trim((string) $label);
            if ($trimmed === '') { continue; }
            if (isset($groups[(string) $gid])) {
                $out[$groups[(string) $gid]][$gid] = $trimmed;
                continue;
            }
            $first = strtoupper(substr($trimmed, 0, 1));
            if ($first === 'G' && strpos($trimmed, 'P[') === false) {
                $out['G'][$gid] = $trimmed;
            } elseif ($first === 'P') {
                $out['P'][$gid] = $trimmed;
            }
        }

        return $out;
    }
}

if (!function_exists('bdsis_rotavirus_gp_compose')) {
    /**
     * The genotype string a set of G/P selections reads as.
     *
     * G labels come first, then P labels, each in master order, run together:
     *
     *   G1 + P[8]            -> G1P[8]
     *   G2 + P[4]            -> G2P[4]
     *   G4 + P[4] + P[8]     -> G4P[4]P[8]
     *   G8 + UT              -> G8 UT
     *
     * UT is a word rather than a type, so it is separated by a space from
     * whatever sits next to it; everything else is concatenated.
     *
     * @param  array $labels selected labels, G group first then P group
     * @return string        '' when nothing is selected
     */
    function bdsis_rotavirus_gp_compose($labels)
    {
        $out = '';
        foreach ((array) $labels as $label) {
            $label = trim((string) $label);
            if ($label === '') { continue; }
            if ($out === '') { $out = $label; continue; }
            $spaced = (strtoupper($label) === 'UT') || (strtoupper(substr($out, -2)) === 'UT');
            $out .= ($spaced ? ' ' : '') . $label;
        }

        return $out;
    }
}

if (!function_exists('bdsis_rotavirus_gp_selected')) {
