        /* Row 1 -- what was tested, and how. */
        $h .= '<div class="row lr-line">';
        $h .= '<div class="col-md-6 lr-cell"><label class="lr-cell-label" for="bpCpeAgent'.$idx.'">Antibiotic:</label>'.$cAgentSel.'</div>';
        $h .= '<div class="col-md-6 lr-cell"><label class="lr-cell-label" for="bpMcimMethod'.$idx.'">Method:</label>'
            . $sel('mcim_method['.$idx.']', 'bpMcimMethod'.$idx, bdsis_mcim_methods(), $cMethod, 'Select Method', 'required onchange="bpMcimInterpret(\''.$idx.'\');"')
            . '<small class="lr-inline-error" id="bpCpeEcimFirst'.$idx.'" style="display:none;">eCIM is performed only after a Positive mCIM. Choose mCIM here; the eCIM row appears when mCIM is Positive.</small></div>';
        $h .= '</div>';

        /* Row 2 -- the reading. Colonies is its own column now rather than a
           stack under the zone, and disappears with the column when the method
           is not mCIM. */
        $h .= '<div class="row lr-line">';
        $h .= '<div class="col-md-6 lr-cell"><label class="lr-cell-label" for="bpMcimZone'.$idx.'">Zone Diameter (mm):</label>'
            . '<input type="number" '.($cIsMcim ? 'step="1" min="6" required' : 'step="any" min="0"').' data-was-required="1" name="mcim_zone['.$idx.']" id="bpMcimZone'.$idx.'" class="form-control text-center"'
            . ' value="'.$hv($c ? $c['mcim_zone'] : '').'" oninput="bpMcimInterpret(\''.$idx.'\');" /></div>';
        $h .= '<div class="col-md-6 lr-cell" id="bpMcimColWrap'.$idx.'" style="display:'.($cIsMcim ? 'block' : 'none').';">'
            . '<label class="lr-cell-label" for="bpMcimColonies'.$idx.'">Colonies within zone:</label>'
            . $sel('mcim_colonies['.$idx.']', 'bpMcimColonies'.$idx, array('Yes', 'No'), ($c ? $c['mcim_colonies'] : ''), 'Select', ($cIsMcim ? 'required ' : '').'data-was-required="1" onchange="bpMcimInterpret(\''.$idx.'\');"').'</div>';
        $h .= '</div>';

        /* Row 3 -- the mCIM reading on the left, eCIM on the right. Only one of
           the two interpretation controls applies at a time, and only one of the
           two eCIM panels; the JS swaps them by id exactly as before. */
        $ecimOn = ($c && $c['mcim_result'] === 'Positive');
        $ecimNote = ($ecimOn ? 'display:none;' : 'display:block;');
        $h .= '<div class="row lr-line">';
        $h .= '<div class="col-md-6 lr-cell">'
            . '<div id="bpMcimResWrap'.$idx.'" style="display:'.($cIsMcim ? 'block' : 'none').';"><label class="lr-cell-label" for="bpMcimResult'.$idx.'">mCIM Interpretation:</label>'
            . '<input type="text" name="mcim_result['.$idx.']" id="bpMcimResult'.$idx.'" class="form-control lr-pill" readonly tabindex="-1" placeholder="mCIM result" value="'.$hv($c ? $c['mcim_result'] : '').'" /></div>'
            . '<div id="bpCpeInterpWrap'.$idx.'" style="display:'.($cIsMcim ? 'none' : 'block').';"><label class="lr-cell-label" for="bpCpeInterp'.$idx.'">Interpretation:</label>'
            . $sel('cpe_interp['.$idx.']', 'bpCpeInterp'.$idx, bdsis_cpe_interpretations(), (($c && !$cIsMcim) ? $c['result'] : ''), 'Select Interpretation', (!$cIsMcim ? 'required ' : '').'data-was-required="1" onchange="bpMcimInterpret(\''.$idx.'\');"', 'lr-pill-select').'</div>'
            . '</div>';

        $h .= '<div class="col-md-6 lr-cell">';
        /* eCIM, once mCIM reads Positive. */
        $h .= '<div class="lr-reveal bp-ecim" id="bpEcim'.$idx.'" style="display:'.($ecimOn ? 'block' : 'none').';">';
        $h .= '<label class="lr-cell-label" for="bpEcimMethod'.$idx.'">eCIM <span class="required-star" aria-hidden="true">*</span>'
            . '<span class="lr-agent-sub">Required &mdash; mCIM is Positive</span></label>';
        $h .= '<div class="row">';
        $h .= '<div class="col-6"><label class="lr-mini-label" for="bpEcimMethod'.$idx.'">Method:</label>'
            . $sel('ecim_method['.$idx.']', 'bpEcimMethod'.$idx, bdsis_ecim_methods(), ($c ? $c['ecim_method'] : ''), 'Select Method', 'required').'</div>';
        $h .= '<div class="col-6"><label class="lr-mini-label" for="bpEcimZone'.$idx.'">Zone (mm)<span class="sr-only">, eCIM</span>:</label>'
            . '<input type="number" step="1" min="6" name="ecim_zone['.$idx.']" id="bpEcimZone'.$idx.'" class="form-control text-center" required'
            . ' value="'.$hv($c ? $c['ecim_zone'] : '').'" oninput="bpEcimInterpret(\''.$idx.'\');" /></div>';
        $h .= '<div class="col-6"><label class="lr-mini-label" for="bpEcimDiff'.$idx.'">Increase vs mCIM:</label>'
            . '<input type="text" class="form-control text-center lr-pill" id="bpEcimDiff'.$idx.'" readonly tabindex="-1" placeholder="&ndash;" /></div>';
        $h .= '<div class="col-6"><label class="lr-mini-label" for="bpEcimResult'.$idx.'">Result<span class="sr-only">, eCIM</span>:</label>'
            . '<input type="text" name="ecim_result['.$idx.']" id="bpEcimResult'.$idx.'" class="form-control lr-pill" readonly tabindex="-1" placeholder="eCIM result" value="'.$hv($c ? $c['ecim_result'] : '').'" /></div>';
        $h .= '</div>';
        $h .= '</div>';
        /* ...or the note that stands in its place. */
        $h .= '<div class="lr-reveal bp-ecim-na" id="bpEcimNa'.$idx.'" style="'.$ecimNote.'">'
            . '<label class="lr-cell-label" for="bpEcimNaText'.$idx.'">eCIM:</label>'
            . '<input type="text" class="form-control lr-pill" id="bpEcimNaText'.$idx.'" value="'.($cIsMcim ? 'eCIM not required' : 'Not applicable for this method').'" readonly tabindex="-1" /></div>';
        $h .= '</div>';
        $h .= '</div>';
        /* Final result. */
        $h .= '<div class="row lr-line lr-line--result">'
            . '<div class="col-md-8 lr-cell lr-cell--name"><span class="lr-agent">Carbapenemase Result</span>'
            . '<span class="lr-agent-sub">Generated from mCIM / eCIM; stated for Carba NP, PCR or Other.</span></div>'
            . '<div class="col-md-4 lr-cell"><label class="lr-cell-label" for="bpCpeResult'.$idx.'">Carbapenemase Result:</label>'
            . '<input type="text" name="cpe_result['.$idx.']" id="bpCpeResult'.$idx.'" class="form-control lr-pill" readonly tabindex="-1" placeholder="Pending" value="'.$hv($c ? $c['result'] : '').'" /></div></div>';

        /* Rule reminders. #bpMcimHint is toggled with style.display, so the
           banner sits inside it rather than being it. */
        $h .= '<div id="bpMcimHint'.$idx.'" style="display:'.($cIsMcim ? 'block' : 'none').';">'
            . $help('mCIM (whole mm, 6 or more): 6&ndash;15 mm = Positive; 16&ndash;18 mm = Positive with colonies in the zone, otherwise Indeterminate; 19 mm or more = Negative, or Indeterminate with colonies. eCIM 5 mm or more larger than mCIM = Metallo-&beta;-lactamase (MBL) detected; less than 5 mm = Serine carbapenemase detected.')
            . '</div>';
        $h .= '</div></div>';

        return $h;
    }
}

if (!function_exists('bdsis_ecoli_resistance_panels')) {
    /**
     * The ESBL / carbapenemase panels for one E. coli pathotype record, ready to
     * drop under its AST tiles (lab/load-ecoli-ast.php).
     *
     * Empty when there is no saved pathotype record to hang the results on: the
     * confirmatory tables key off rcdc_ecoli_pcr_result_table3.record_id, so
     * until the PCR pathotype is saved there is nothing to store against.
     *
     * \@return string
     */
    function bdsis_ecoli_resistance_panels($bdsis, $prt3rid)
    {
        $id = (int)$prt3rid;
        if ($id <= 0 || !($bdsis instanceof mysqli)) { return ''; }
        $idx = bdsis_ecoli_resistance_key($id);
        $html = bdsis_bact_resistance_panels_html($idx, bdsis_ecoli_load_resistance($bdsis, $id), bdsis_esbl_agents($bdsis));
        return '<div class="col-12 eco-resistance" data-ecoidx="' . htmlspecialchars($idx, ENT_QUOTES) . '" data-prt3="' . $id . '">' . $html . '</div>';
    }
}

