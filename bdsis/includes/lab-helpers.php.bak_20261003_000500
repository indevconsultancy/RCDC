                $strains[$sid] = $sname;
            }
        }

        return $strains;
    }
}

if (!function_exists('bdsis_ecoli_pcr_applies')) {
    /**
     * THE single rule deciding whether the E.coli PCR Result section applies to
     * one isolate of one subject.
     *
     * It applies when either:
     *   1. the isolate's Bacteriology AST Result is 'Positive'
     *      (bacteriology_result_table2.ast_status), or
     *   2. a PCR record already exists for that subject_id + ecoli_id
     *      (rcdc_ecoli_pcr_result_table2).
     *
     * Clause 2 is NOT optional. Every E.coli bacteriology row written before the
     * AST select started offering Positive/Negative carries ast_status='NR'
     * (3725 such rows) while 3650+ PCR records hang off them. Gating purely on
     * ast_status would make all of that captured PCR and pathology-type data
     * invisible -- in the data-entry form AND in every report -- and
     * un-editable. Clause 2 keeps historical records working while new entries
     * follow clause 1.
     *
     * This helper is the ONLY place the rule lives. lab/lab.php (render),
     * lab/iu-lab.php (save), reports/report-view.php and
     * reports/report-html-builder.php (print) all call it, so the layers cannot
     * drift apart again.
     *
     * Note on granularity: the rule is keyed by (subject_id, ecoli_id), not by
     * bacteriology row, because rcdc_ecoli_pcr_result_table2 itself is keyed by
     * (subject_id, ecoli_id) and carries no reference to a bacteriology row.
     *
     * @param  mysqli $bdsis
     * @param  string $sid     subject_id
     * @param  string $ecoliId pathogen_id, '025' (LF) or '026' (NLF)
     * @return bool
     */
    function bdsis_ecoli_pcr_applies($bdsis, $sid, $ecoliId)
    {
        if (!($bdsis instanceof mysqli)) {
            return false;
        }
        if ($sid === null || $sid === '' || $ecoliId === null || $ecoliId === '') {
            return false;
        }

        $qry = $bdsis->prepare(
            "SELECT
                EXISTS(SELECT 1 FROM bacteriology_result_table2
                        WHERE subject_id = ? AND pathogen_id = ? AND ast_status = 'Positive')
              + EXISTS(SELECT 1 FROM rcdc_ecoli_pcr_result_table2
                        WHERE subject_id = ? AND ecoli_id = ?)"
        );
        if (!$qry) {
            return false;
        }
        $qry->bind_param("ssss", $sid, $ecoliId, $sid, $ecoliId);
        $qry->execute();
        $qry->bind_result($hits);
        $applies = $qry->fetch() ? ((int) $hits > 0) : false;
        $qry->close();

        return $applies;
    }
}

if (!function_exists('bdsis_save_ecoli_strains')) {
    /**
     * Persist one E.coli block's pathology-type results into
     * rcdc_ecoli_pcr_result_table3.
     *
     * The form used to post six independent Positive/Negative dropdowns; it now
     * posts a single multi-select of the pathology types found. The stored shape
     * is unchanged: each of the six strains still gets its own row, holding
     * 'Positive' when the user selected it and 'Negative' when they did not.
     *
     * Each strain is UPDATEd when a row for it already exists under this block
     * and INSERTed when it does not, so a block that is missing a strain row
     * (some historical records only stored five) gets the missing one written
     * rather than silently skipped.
     *
     * Existence is decided against (prt2_record_id, ecoli_strain_id) -- the
     * table's own primary key -- rather than against the record_id the form
     * posts back. The form is now an unbounded list of blocks, and a stale or
     * crafted rsltid[i][x] pointing at another block's row would otherwise let
     * one block overwrite another's stored result. The key cannot lie.
     *
     * This is the one and only implementation of the strain-persistence logic;
     * the save handler calls it once per posted block.
     *
     * @param  mysqli $bdsis
     * @param  int    $prt2RecordId rcdc_ecoli_pcr_result_table2.record_id
     * @param  array  $selected     strain_ids the user marked Positive
     * @param  array  $strainIds    the strain_ids this block covers
     * @return void
     */
    function bdsis_save_ecoli_strains($bdsis, $prt2RecordId, $selected, $strainIds)
    {
        $prt2RecordId = (int) $prt2RecordId;
        if ($prt2RecordId <= 0) {
            return;
        }
        $selected = array_map('strval', (array) $selected);

        $selqry = $bdsis->prepare("SELECT record_id FROM rcdc_ecoli_pcr_result_table3 WHERE prt2_record_id=? AND ecoli_strain_id=?");
        $updqry = $bdsis->prepare("UPDATE rcdc_ecoli_pcr_result_table3 SET strain_result=? WHERE prt2_record_id=? AND ecoli_strain_id=?");
        $insqry = $bdsis->prepare("INSERT INTO rcdc_ecoli_pcr_result_table3(prt2_record_id, ecoli_strain_id, strain_result) VALUES(?, ?, ?)");

        foreach ((array) $strainIds as $strainId) {
            $strainId = (string) $strainId;
            if ($strainId === '') {
                continue;
            }
            $result = in_array($strainId, $selected, true) ? 'Positive' : 'Negative';

            $selqry->bind_param("is", $prt2RecordId, $strainId);
            $selqry->execute();
            $selqry->store_result();
            $exists = $selqry->num_rows > 0;
            $selqry->free_result();

            if ($exists) {
                $updqry->bind_param("sis", $result, $prt2RecordId, $strainId);
                $updqry->execute();
            } else {
                $insqry->bind_param("iss", $prt2RecordId, $strainId, $result);
                $insqry->execute();
            }
        }
    }
}

if (!function_exists('bdsis_subject_has_ecoli')) {
    /**
     * Does this subject have E.coli recorded in the Bacteriology Result section?
     *
     * E.coli is two master rows in ms_enteric_bacterial_pathogen_table:
     * '025' (LF E.coli) and '026' (NLF E.coli). Either one counts.
     *
     * This is one half of the gate on the Rotavirus genotype field -- the other
     * half is the ELISA Rotavirus result being 'Positive'. It is evaluated
     * against the database on both the render path (lab/lab.php, for the
     * server-side initial visibility) and the save path (lab/iu-lab.php), so a
     * posted flag is never trusted.
     *
     * @param  mysqli $bdsis
     * @param  string $sid   subject_id
     * @return bool
     */
    function bdsis_subject_has_ecoli($bdsis, $sid)
    {
        if (!($bdsis instanceof mysqli) || $sid === null || $sid === '') {
            return false;
        }

        $qry = $bdsis->prepare(
            "SELECT 1 FROM bacteriology_result_table2
              WHERE subject_id = ? AND pathogen_id IN ('025','026') LIMIT 1"
        );
        if (!$qry) {
            return false;
        }
        $qry->bind_param("s", $sid);
        $qry->execute();
        $qry->store_result();
        $found = $qry->num_rows > 0;
        $qry->close();

        return $found;
    }
}

