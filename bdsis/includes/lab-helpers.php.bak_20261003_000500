if(!function_exists('bdsis_bact_resistance_panels_html')){
    /**
     * The two conditional sub-panels rendered inside a pathogen row's AST
     * panel: ESBL Test and Carbapenemase Test (mCIM, then eCIM). Both
     * start hidden unless the row already holds a saved result; the
     * browser shows them when the routine zones trigger them
     * (bpResistanceSync) and iu-lab.php re-derives the triggers on save.
     * Field names are indexed by row like the rest of the block.
     */
    function bdsis_bact_resistance_panels_html($idx, $resist, $esblAgents)
    {
        $hv = function($v){ return htmlspecialchars((string)$v, ENT_QUOTES); };
        /* $cls: extra classes for the <select> (e.g. the result pill). */
        $sel = function($name, $id, $opts, $cur, $placeholder, $attrs = '', $cls = '') use ($hv) {
            $s = '<select class="form-control'.($cls !== '' ? ' '.$cls : '').'" name="'.$name.'" id="'.$id.'" '.$attrs.'>';
            $s .= '<option value="">'.$hv($placeholder).'</option>';
            foreach($opts as $o){ $s .= '<option value="'.$hv($o).'"'.((string)$o === (string)$cur ? ' selected' : '').'>'.$hv($o).'</option>'; }
            return $s.'</select>';
        };
        $e = (is_array($resist) && isset($resist['esbl']) && is_array($resist['esbl'])) ? $resist['esbl'] : null;
        $c = (is_array($resist) && isset($resist['cpe'])  && is_array($resist['cpe']))  ? $resist['cpe']  : null;

        /* Layout (lab-results.css): every toggled container (#bpEsbl, #bpCpe,
           #bpEcim, #bpEcimNa, #bpMcimHint and the cell wrappers) is a plain block
           so style.display='block' cannot collapse a grid; the rows inside are
           .row.lr-line on the same 3 / 3 / 2 / 4 columns as the routine panel.
           Each field keeps its name, id, handler and required state. */
        $gridHead = function($c1, $c2, $c3, $c4){
            return '<div class="row lr-grid-head d-none d-md-flex"><div class="col-md-3">'.$c1.'</div><div class="col-md-3">'.$c2.'</div>'
                 . '<div class="col-md-2">'.$c3.'</div><div class="col-md-4">'.$c4.'</div></div>';
        };
        $help = function($text){ return '<div class="lr-help"><i class="fas fa-info-circle" aria-hidden="true"></i><span>'.$text.'</span></div>'; };

        /* ---- ESBL Test ---- */
        $h  = '<div class="lr-reveal bp-esbl" id="bpEsbl'.$idx.'" style="display:'.($e ? 'block' : 'none').';">';
        $h .= '<div class="lr-subcard lr-subcard--esbl">';
        $h .= '<div class="lr-subcard__head"><h4 class="lr-subcard__title">ESBL Test</h4>'
            . '<span class="lr-trigger"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i>Required &mdash; <span class="bp-esbl-why">'.$hv($e ? implode(', ', $e['triggered_by']) : '').'</span> Resistant</span></div>';
        $h .= $gridHead('Antibiotic', 'Method', 'Zone (mm)', 'Increase vs plain disc');
        foreach($esblAgents as $code => $ag){
            $cur  = ($e && isset($e['agents'][$code])) ? $e['agents'][$code] : array('method'=>'', 'zone'=>'');
            $mId  = 'bpEsblMethod'.$idx.'_'.$code;
            $zId  = 'bpEsblZone'.$idx.'_'.$code;
            $h .= '<div class="row lr-line">';
            $h .= '<div class="col-md-3 lr-cell lr-cell--name"><span class="lr-agent">'.$hv($ag['label']).' <small>'.$ag['content'].'</small></span>'
                . '<span class="lr-agent-sub">'.$hv($ag['agent']).'</span></div>';
            $h .= '<div class="col-md-3 lr-cell"><label class="lr-cell-label" for="'.$mId.'">'.$hv($ag['label']).' method:</label>'
                . $sel('esbl_method['.$idx.']['.$code.']', $mId, bdsis_esbl_methods(), $cur['method'], 'Select Method', 'onchange="bpEsblInterpret(\''.$idx.'\');"').'</div>';
            $h .= '<div class="col-6 col-md-2 lr-cell"><label class="lr-cell-label" for="'.$zId.'">Zone (mm)<span class="sr-only">, '.$hv($ag['label']).'</span>:</label>'
                . '<input type="number" step="any" min="0" name="esbl_zone['.$idx.']['.$code.']" id="'.$zId.'"'
                . ' class="form-control text-center bp-esbl-zone" data-code="'.$hv($code).'" data-pair="'.$hv($ag['pair']).'" data-rule="'.$hv($ag['rule']).'"'
                . ' value="'.$hv($cur['zone']).'" oninput="bpEsblInterpret(\''.$idx.'\');" /></div>';
            if($ag['pair'] !== ''){
                $dId = 'bpEsblDiff'.$idx.'_'.$code;
                $h .= '<div class="col-6 col-md-4 lr-cell"><label class="lr-cell-label" for="'.$dId.'">Increase<span class="sr-only"> vs '.$hv($ag['pair']).'</span>:</label>'
                    . '<input type="text" class="form-control lr-pill bp-esbl-diff" id="'.$dId.'" readonly tabindex="-1" placeholder="Increase vs '.$hv($ag['pair']).'" /></div>';
            }else{
                $h .= '<div class="col-6 col-md-4 lr-cell"><span class="lr-muted-cell">Plain disc &mdash; reference</span></div>';
            }
            $h .= '</div>';
        }
        $h .= '<div class="row lr-line lr-line--result">'
            . '<div class="col-md-8 lr-cell lr-cell--name"><span class="lr-agent">Final ESBL Status <span class="required-star" aria-hidden="true">*</span></span>'
