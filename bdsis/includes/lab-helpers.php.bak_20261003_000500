if (!function_exists('bdsis_processed_by_label')) {
    /**
     * Render a stored "processed by" value for display.
     *
     * "Processed by" used to be a dropdown of staff usernames backed by a
     * foreign key, so historical rows hold a username. It is now a free-text
     * field, so newer rows hold whatever the operator typed. Resolve the value
     * against commondb.user_profile_table and fall back to the raw text when
     * there is no matching user -- that keeps pre-existing records displaying
     * the staff member's full name while supporting free text going forward.
     *
     * @param  string|null $value    stored processed_by value
     * @param  mysqli|null $commondb connection to the commondb schema
     * @return string                display label ('' when nothing is stored)
     */
    function bdsis_processed_by_label($value, $commondb)
    {
        if ($value === null || $value === '') {
            return '';
        }
        if (!($commondb instanceof mysqli)) {
            return $value;
        }

        $lookup = $commondb->query(
            "SELECT fullname FROM user_profile_table WHERE username='"
            . $commondb->real_escape_string($value) . "'"
        );
        if ($lookup && $lookup->num_rows > 0) {
            list($fullname) = $lookup->fetch_row();
            if ($fullname !== null && $fullname !== '') {
                return $fullname;
            }
        }

        return $value;
    }
}

