     * @return array code => array('code','label','agent','content','pair','rule')
     */
    function bdsis_esbl_agents($bdsis)
    {
        static $cache = null;
        if ($cache !== null) { return $cache; }
        $cache = array();

        if ($bdsis instanceof mysqli) {
            try {
                $res = $bdsis->query("SELECT code, short_label, antimicrobial_agent, content, pair_code, rule_mm
                                        FROM ms_esbl_agent_table WHERE status='1' ORDER BY sort_order ASC, code ASC");
                if ($res) {
                    while (list($code, $label, $agent, $content, $pair, $rule) = $res->fetch_row()) {
                        $cache[(string)$code] = array(
                            'code' => (string)$code, 'label' => (string)$label, 'agent' => (string)$agent,
                            'content' => (string)$content, 'pair' => ($pair === null ? '' : (string)$pair),
                            'rule' => ($rule === null ? null : (float)$rule),
                        );
                    }
                    $res->free();
                }
            } catch (mysqli_sql_exception $e) {
                // Table does not exist in schema; fallback array below handles rendering
                $cache = array();
            }
        }

        if (count($cache) === 0) {
            $cache = array(
                'CTX'   => array('code'=>'CTX',   'label'=>'CTX',    'agent'=>'Cefotaxime',              'content'=>'30 &#181;g',    'pair'=>'',    'rule'=>null),
                'CTXCV' => array('code'=>'CTXCV', 'label'=>'CTX/CV', 'agent'=>'Cefotaxime-clavulanate',  'content'=>'30/10 &#181;g', 'pair'=>'CTX', 'rule'=>5.0),
                'CAZ'   => array('code'=>'CAZ',   'label'=>'CAZ',    'agent'=>'Ceftazidime',             'content'=>'30 &#181;g',    'pair'=>'',    'rule'=>null),
                'CAZCV' => array('code'=>'CAZCV', 'label'=>'CAZ/CV', 'agent'=>'Ceftazidime-clavulanate', 'content'=>'30/10 &#181;g', 'pair'=>'CAZ', 'rule'=>5.0),
            );
        }
        return $cache;
    }
}

if (!function_exists('bdsis_ast_breakpoints')) {
    /**
     * Disk-diffusion breakpoints, code => array(sus, int1, int2, res), for the
     * routine panel (method 01). Same rows the save loop reads per agent.
     *
     * @param  mysqli $bdsis
     * @return array
     */
    function bdsis_ast_breakpoints($bdsis)
    {
        $out = array();
        $res = ($bdsis instanceof mysqli)
            ? $bdsis->query("SELECT code, susceptible, intermediate1, intermediate2, resistance FROM ms_ast_table WHERE ast_method_id='01'")
            : false;
        if ($res) {
            while (list($code, $sus, $int1, $int2, $r) = $res->fetch_row()) {
                $out[strtoupper(trim((string)$code))] = array($sus, $int1, $int2, $r);
            }
            $res->free();
        }
        return $out;
    }
}

if (!function_exists('bdsis_ast_interpret_zone')) {
    /**
     * The AST loop's interpretation, verbatim (same order, same comparisons):
     *   zone <= resistance -> Resistant; int1..int2 -> Intermediate; >= sus -> Susceptible.
     * '' and -99 (not tested) give ''.
     *
     * @param  string $zone posted zone
     * @param  array  $bp   array(sus, int1, int2, res)
     * @return string
     */
    function bdsis_ast_interpret_zone($zone, $bp)
    {
        $zone = trim((string)$zone);
        if ($zone === '' || $zone === '-99' || !is_numeric($zone)) { return ''; }
        list($sus, $int1, $int2, $res) = $bp;
        $rslt = '';
        if ($zone <= $res) { $rslt = 'Resistant'; }
        if ($zone >= $int1 && $zone <= $int2) { $rslt = 'Intermediate'; }
        if ($zone >= $sus) { $rslt = 'Susceptible'; }
        return $rslt;
    }
}

if (!function_exists('bdsis_mcim_interpret')) {
    /**
     * mCIM (CLSI M100, 2026-10-10 spec revision -- zone-only):
     *   zone >= 19 mm (clear zone)   -> Negative       Carbapenemase not detected
     *   zone 16-18 mm                -> Indeterminate  Repeat testing recommended
     *   zone 6-15 mm                 -> Positive       Carbapenemase detected
     *
     * The "Point Colonies within zone?" Yes/No tie-breaker was retired on
     * 2026-10-10 at the client's request. The 16-18 mm band now always
     * reads as Indeterminate; the lab repeats the test rather than inferring
     * from colony growth. A blank, non-numeric or sub-disc (< 6 mm) zone is
     * unclassified exactly as before, so the pill stays blank.
     *
     * The $colonies parameter is retained for backward compatibility with
     * older callers (and with any edit-mode record that still carries a
     * mcim_colonies value) but is now ignored.
     *
     * @param  mixed  $zone      mm
     * @param  mixed  $colonies  retained for signature compatibility; ignored
     * @return string Positive | Negative | Indeterminate | '' (not classifiable)
     */
    function bdsis_mcim_interpret($zone, $colonies = null)
    {
        if (!bdsis_cim_zone_valid($zone)) { return ''; }
        $z = (float)$zone;
        if ($z >= 19) { return 'Negative'; }
        if ($z <= 15) { return 'Positive'; }
        return 'Indeterminate';
    }
}

if (!function_exists('bdsis_ecim_interpret')) {
    /**
     * eCIM read against mCIM: an eCIM zone >= 5 mm larger than the mCIM zone
     * = metallo-beta-lactamase; otherwise a serine carbapenemase.
     *
     * difference = eCIM zone - mCIM zone. A negative difference (eCIM smaller
     * than mCIM) is below 5 and so reads as serine, exactly as the rule is
     * written; it is not rejected, because nothing in the requirement says so.
     *
     * @return string 'Metallo-β-lactamase (MBL) detected' | 'Serine carbapenemase detected' | ''
     */
    function bdsis_ecim_interpret($ecimZone, $mcimZone)
    {
        // START ESBL / CARBAPENEMASE CHANGE
        if (!bdsis_cim_zone_valid($ecimZone) || !bdsis_cim_zone_valid($mcimZone)) { return ''; }
        /* Wording as the requirement writes it (β). The tables are utf8 and the
           connection utf8mb4, so the character is stored as-is. */
        return (((float)$ecimZone - (float)$mcimZone) >= 5)
            ? 'Metallo-β-lactamase (MBL) detected'
            : 'Serine carbapenemase detected';
        // END ESBL / CARBAPENEMASE CHANGE
    }
}

if (!function_exists('bdsis_resistance_plan_core')) {
    /**
     * The ESBL / carbapenemase rules, independent of where the isolate lives.
     *
     * Bacteriology isolates and E. coli pathotype records record the same two
     * confirmatory tests under the same CLSI rules; only the key they hang off
     * and the names their form fields post under differ. Both therefore call
     * this, so a rule can never be right in one panel and wrong in the other.
     *
     * \@param  mysqli   $bdsis
     * \@param  array    $results code => interpretation already recorded for this
     *                           isolate ('Resistant', 'Intermediate', ...)
     * \@param  string   $label   panel name, used in the refusal messages
     * \@param  callable $field   fn($name, $sub = null) => the posted value
     * \@return array 'ok', 'error', 'esbl', 'cpe'
     */
    function bdsis_resistance_plan_core($bdsis, $results, $label, $field)
    {
        $plan = array('ok' => true, 'error' => '', 'esbl' => null, 'cpe' => null);
        $fail = function ($msg) use (&$plan) { $plan['ok'] = false; $plan['error'] = $msg; return $plan; };
        $results = is_array($results) ? $results : array();

        $trig   = bdsis_bact_trigger_codes();
        $esblBy = array();
        foreach ($trig['esbl'] as $c) { if (isset($results[$c]) && $results[$c] === 'Resistant') { $esblBy[] = $c; } }
        $cpeBy  = array();
        /* Resistant-only CPE trigger per 2026-10-05 spec. Isolates whose
           only carbapenem result is Intermediate no longer require the
           mCIM/eCIM confirmatory flow. */
        foreach ($trig['cpe'] as $c)  { if (isset($results[$c]) && $results[$c] === 'Resistant') { $cpeBy[] = $c; } }

        /* 2. ESBL. */
        if (count($esblBy) > 0) {
            $why     = $label . ': ESBL test is required because ' . implode(', ', $esblBy) . ' is Resistant -- ';
            $agents  = bdsis_esbl_agents($bdsis);
            $methods = bdsis_esbl_methods();
            $entered = array();
            foreach ($agents as $code => $ag) {
                $m = $field('esbl_method', $code);
                $z = $field('esbl_zone', $code);
                if ($m === '' && $z === '') { continue; }
                if ($z === '' || !is_numeric($z) || (float)$z < 0) { return $fail($why . 'enter a valid zone diameter for ' . $ag['label'] . '.'); }
                if (!in_array($m, $methods, true)) { return $fail($why . 'choose the method for ' . $ag['label'] . '.'); }
                $entered[$code] = array('method' => $m, 'zone' => (float)$z);
            }
            if (count($entered) === 0) { return $fail($why . 'enter at least one ESBL antibiotic zone.'); }

            /* Combination disk rule: >= rule_mm increase with clavulanate over the
               plain disc = ESBL producer. Applied whenever a pair is complete and
               read by combination disk; it overrides a hand-picked interpretation
               so what is stored can never contradict the discs. */
            $result = $field('esbl_result');
            $auto   = null;
            foreach ($agents as $code => $ag) {
                if ($ag['pair'] === '' || $ag['rule'] === null) { continue; }
                if (!isset($entered[$code]) || !isset($entered[$ag['pair']])) { continue; }
                // START ESBL / CARBAPENEMASE CHANGE
                /* The rule compares two combination-disk readings, so BOTH discs of
                   the pair must have been read that way -- not just the clavulanate
                   one, which is all this used to check. */
                if ($entered[$code]['method'] !== 'Combination Disk Test'
                    || $entered[$ag['pair']]['method'] !== 'Combination Disk Test') { continue; }
                // END ESBL / CARBAPENEMASE CHANGE
                if (($entered[$code]['zone'] - $entered[$ag['pair']]['zone']) >= $ag['rule']) { $auto = 'ESBL producer'; break; }
                if ($auto === null) { $auto = 'Non-ESBL producer'; }
            }
            if ($auto !== null) { $result = $auto; }
            if (!in_array($result, bdsis_esbl_interpretations(), true)) { return $fail($why . 'select the interpretation (ESBL producer / Non-ESBL producer).'); }
            $plan['esbl'] = array('triggered_by' => $esblBy, 'result' => $result, 'agents' => $entered);
        }

        // START ESBL / CARBAPENEMASE CHANGE
        /* 3. Carbapenems Test (2026-10-07 standalone-Carba-NP semantics).
              Both the Carbapenemase Detection (mCIM / eCIM) flow and the
              standalone Carba NP Test live under the same `cpe` plan slot.
              Each section is validated section-aware: if the user hasn't
              engaged with it (all fields blank), the section is skipped.
              If they have, it's validated fully.

              mCIM is the only first-step method accepted today; the UI
              auto-posts mcim_method = mCIM. eCIM is only validated when
              mCIM is Positive. Carba NP is a parallel confirmation path
              with its own two tubes; the save and load pipeline persist
              carba_np_tube_a/b in dedicated columns (migration 2026-10-05). */
        /* 3. Carbapenems Test (2026-10-07 standalone-Carba-NP semantics + 2026-10-17 Module A sync & persistence).
              Both the Carbapenemase Detection (Module A screening + Module B mCIM / eCIM) flow and the
              standalone Carba NP Test live under the same `cpe` plan slot. */
        $eptZ = $field('ept_zone_mm');
        if ($eptZ === '') { $eptZ = $field('ept_val'); }
        if ($eptZ === '') { $eptZ = $field('cpe_screen_zone', 'EPT'); }
        $eptI = $field('ept_interpretation');
        if ($eptI === '') { $eptI = $field('cpe_screen_interp', 'EPT'); }

        $imiZ = $field('imi_zone_mm');
        if ($imiZ === '') { $imiZ = $field('imi_val'); }
        if ($imiZ === '') { $imiZ = $field('cpe_screen_zone', 'IMI'); }
        $imiI = $field('imi_interpretation');
        if ($imiI === '') { $imiI = $field('cpe_screen_interp', 'IMI'); }

        $merZ = $field('mer_zone_mm');
        if ($merZ === '') { $merZ = $field('mer_val'); }
        if ($merZ === '') { $merZ = $field('cpe_screen_zone', 'MER'); }
        $merI = $field('mer_interpretation');
        if ($merI === '') { $merI = $field('cpe_screen_interp', 'MER'); }

        $scrR = $field('carbapenemase_screening_result');
        if ($scrR === '') { $scrR = $field('carbapenemase_screen_res'); }
        if ($scrR === '') { $scrR = $field('cpe_screen_result'); }

        $finR = $field('final_carbapenemase_result');
        if ($finR === '') { $finR = $field('final_carbapenemase_res'); }
        if ($finR === '') { $finR = $field('cpe_result'); }

        $hasModuleA = ($eptZ !== '' || $imiZ !== '' || $merZ !== '' || $scrR !== '' || $finR !== '');

        if (count($cpeBy) > 0 || $hasModuleA) {
            $why = $label . ': Carbapenems Test -- ';
            $ca  = strtoupper($field('cpe_agent'));
            $mm  = $field('mcim_method');
            $mz  = $field('mcim_zone');
            if ($mz === '') { $mz = $field('mcim_val'); }
            $mc  = $field('mcim_colonies');
            if ($ca !== '' && !in_array($ca, $trig['cpe'], true))      { return $fail($why . 'choose the carbapenem antibiotic (' . implode(' / ', $trig['cpe']) . ').'); }
            if ($mm !== '' && !in_array($mm, bdsis_mcim_methods(), true)) { return $fail($why . 'choose the method.'); }
            if ($mm === 'eCIM')                                        { return $fail($why . 'eCIM is performed only after a Positive mCIM. Choose mCIM as the method and record the eCIM reading in the eCIM row.'); }

            $cpe = array(
                'triggered_by' => $cpeBy, 'agent' => ($ca !== '' ? $ca : 'MER'),
                'mcim_method' => ($mm !== '' ? $mm : 'mCIM'),
                'mcim_zone' => null, 'mcim_colonies' => null, 'mcim_result' => null,
                'ecim_method' => null, 'ecim_zone' => null, 'ecim_result' => null, 'result' => ($finR !== '' ? $finR : ''),
                'carba_np_tube_a' => null, 'carba_np_tube_b' => null,
                'carba_np_result' => null, 'carba_np_interpretation' => null,
                'ept_zone_mm'                    => ($eptZ !== '') ? $eptZ : null,
                'ept_interpretation'            => ($eptI !== '') ? $eptI : null,
                'imi_zone_mm'                    => ($imiZ !== '') ? $imiZ : null,
                'imi_interpretation'            => ($imiI !== '') ? $imiI : null,
                'mer_zone_mm'                    => ($merZ !== '') ? $merZ : null,
                'mer_interpretation'            => ($merI !== '') ? $merI : null,
                'carbapenemase_screening_result' => ($scrR !== '') ? $scrR : null,
                'final_carbapenemase_result'     => ($finR !== '') ? $finR : null,
            );

            /* ---- Carbapenemase Detection (mCIM + eCIM) -- section-aware ----
               If the user left the mCIM zone blank, treat the mCIM section
               as "not performed" and skip its validation. The Carba NP block
               below may still carry the record. (The Yes/No "Point Colonies
               within zone" tie-breaker was retired 2026-10-10 at the
               client's request; the engagement check now only cares about
               the zone value, and the 16-18 mm band always reads as
               Indeterminate.) */
            $mcimEngaged = ($mz !== '');
            if ($mm === 'mCIM' && $mcimEngaged) {
                if (!bdsis_cim_zone_valid($mz))                        { return $fail($why . 'enter the mCIM zone diameter in whole millimetres (6 mm or more).'); }
                $mr = bdsis_mcim_interpret($mz);
                if ($mr === '')                                         { return $fail($why . 'the mCIM reading could not be interpreted.'); }
                $cpe['mcim_zone']     = (float)$mz;
                $cpe['mcim_colonies'] = null;   /* field removed from UI 2026-10-10 */
                $cpe['mcim_result']   = $mr;
                if ($mr === 'Positive') {
                    $why2 = $label . ': eCIM is required because mCIM is Positive -- ';
                    $em = $field('ecim_method');
                    $ez = $field('ecim_zone');
                    if ($ez === '') { $ez = $field('ecim_val'); }
                    if (!in_array($em, bdsis_ecim_methods(), true))    { return $fail($why2 . 'choose the eCIM method.'); }
                    if (!bdsis_cim_zone_valid($ez))                    { return $fail($why2 . 'enter the eCIM zone diameter in whole millimetres (6 mm or more).'); }
                    $cpe['ecim_method'] = $em;
                    $cpe['ecim_zone']   = (float)$ez;
                    $cpe['ecim_result'] = bdsis_ecim_interpret($ez, $mz);
                }
                $cpe['result'] = bdsis_carbapenemase_result($mr, $cpe['ecim_result']);
                if ($cpe['final_carbapenemase_result'] === null || $cpe['final_carbapenemase_result'] === '') {
                    $cpe['final_carbapenemase_result'] = $cpe['result'];
                }
            } elseif ($mm !== 'mCIM' && $mm !== '' && $mm !== 'Carba NP') {
                /* Legacy manual-interpretation methods (PCR / E-test / Other)
                   are no longer in the first-step dropdown but existing
                   records save-roundtrip cleanly through this branch. */
                if ($mz !== '' && (!is_numeric($mz) || (float)$mz < 0)) { return $fail($why . 'enter a valid zone diameter, or leave it blank.'); }
                $ci = $field('cpe_interp');
                if ($ci !== '') {
                    if (!in_array($ci, bdsis_cpe_interpretations(), true)) { return $fail($why . 'select the interpretation (Carbapenemase Positive / Carbapenemase Negative).'); }
                    $cpe['mcim_zone'] = ($mz === '') ? null : (float)$mz;
                    $cpe['result']    = $ci;
                    if ($cpe['final_carbapenemase_result'] === null || $cpe['final_carbapenemase_result'] === '') {
                        $cpe['final_carbapenemase_result'] = $ci;
                    }
                }
            }

            /* If the mCIM flow produced nothing, we still fall through below
               to the standalone Carba NP block, which may or may not save the
               row. The null-plan test runs after both sections. */
            $plan['cpe'] = $cpe;
        }
        // END ESBL / CARBAPENEMASE CHANGE

        /* ---- Carba NP Test -- section-aware, trigger-INDEPENDENT -----------
           2026-10-12 fix: Carba NP is a biochemical confirmation that labs
           can run on ANY isolate, not just one whose routine panel tripped
           the CPE trigger. The UI shows the Carba NP card as a sibling of
           the Carbapenemase Detection panel inside #bpConf; previously the
           save validation was nested inside the CPE trigger block, so when
           only ESBL (or AmpC) triggered, the tubes were silently dropped on
           submit. Validation now runs here regardless of $cpeBy, and the
           tubes land on bacteriology_resistance_table whether the CPE panel
           triggered or not. If CPE did not trigger, a minimal $cpe carrier
           is created with cpe_triggered recorded as 0 (via empty
           triggered_by) so reports still read the row correctly. */
        $cnA = $field('carba_np_tube_a');
        $cnB = $field('carba_np_tube_b');
        if ($cnA !== '' || $cnB !== '') {
            $whyCn = $label . ': Carba NP Test -- ';
            if ($cnA === '' || $cnB === '') { return $fail($whyCn . 'enter both Tube A and Tube B, or leave both blank.'); }
            $cnAopts = bdsis_carba_np_tube_a_options();
            $cnBopts = bdsis_carba_np_tube_b_options();
            /* Accept the pre-2026-10-07 Tube A wording as a legacy fallback
               (bdsis_carba_np_normalise_tube_a handles it). */
            $cnAcanon = bdsis_carba_np_normalise_tube_a($cnA);
            if (!in_array($cnAcanon, $cnAopts, true)) { return $fail($whyCn . 'Tube A has an invalid value.'); }
            if (!in_array($cnB, $cnBopts, true))      { return $fail($whyCn . 'Tube B has an invalid value.'); }
            $cnRes = bdsis_carba_np_result($cnAcanon, $cnB);
            if ($cnRes === '')                        { return $fail($whyCn . 'this Tube A / Tube B combination could not be interpreted.'); }
            $cnInterp = bdsis_carba_np_interpret($cnAcanon, $cnB);

            if (!isset($plan['cpe']) || $plan['cpe'] === null) {
                /* CPE didn't trigger but Carba NP was run. Create a minimal
                   carrier row -- empty triggered_by so cpe_triggered persists
                   as 0, every mCIM/eCIM field null, Carba NP columns filled
                   with the user's tubes and the server-recomputed outputs. */
                $plan['cpe'] = array(
                    'triggered_by' => array(),
                    'agent' => null,
                    'mcim_method' => null, 'mcim_zone' => null,
                    'mcim_colonies' => null, 'mcim_result' => null,
                    'ecim_method' => null, 'ecim_zone' => null, 'ecim_result' => null,
                    'result' => $cnInterp,
                    'carba_np_tube_a'        => $cnAcanon,
                    'carba_np_tube_b'        => $cnB,
                    'carba_np_result'        => $cnRes,
                    'carba_np_interpretation' => $cnInterp,
                    'ept_zone_mm'                    => ($eptZ !== '') ? $eptZ : null,
                    'ept_interpretation'            => ($eptI !== '') ? $eptI : null,
                    'imi_zone_mm'                    => ($imiZ !== '') ? $imiZ : null,
                    'imi_interpretation'            => ($imiI !== '') ? $imiI : null,
                    'mer_zone_mm'                    => ($merZ !== '') ? $merZ : null,
                    'mer_interpretation'            => ($merI !== '') ? $merI : null,
                    'carbapenemase_screening_result' => ($scrR !== '') ? $scrR : null,
                    'final_carbapenemase_result'     => ($finR !== '') ? $finR : null,
                );
            } else {
                $plan['cpe']['carba_np_tube_a']        = $cnAcanon;
                $plan['cpe']['carba_np_tube_b']        = $cnB;
                $plan['cpe']['carba_np_result']        = $cnRes;
                $plan['cpe']['carba_np_interpretation'] = $cnInterp;
                /* If the mCIM flow produced nothing, the Carba NP interpretation
                   becomes the row's overall carbapenemase_result so downstream
                   reports still have one carbapenemase outcome. */
                if ($plan['cpe']['result'] === '') {
                    $plan['cpe']['result'] = $cnInterp;
                }
            }
        }

        /* Null-plan guard: if the CPE row carries NEITHER an mCIM result NOR
           Carba NP tubes NOR an overall carbapenemase result NOR Module A screening data,
           there is nothing to persist and we drop the row entirely. Replace-semantics on save
           will clear any previously stored row. */
        $hasCarbaScreenData = (isset($plan['cpe']) && is_array($plan['cpe'])
            && (!empty($plan['cpe']['ept_zone_mm'])
                || !empty($plan['cpe']['imi_zone_mm'])
                || !empty($plan['cpe']['mer_zone_mm'])
                || !empty($plan['cpe']['carbapenemase_screening_result'])
                || !empty($plan['cpe']['final_carbapenemase_result'])));

        if (isset($plan['cpe']) && is_array($plan['cpe'])
            && $plan['cpe']['mcim_result']    === null
            && $plan['cpe']['carba_np_tube_a'] === null
            && $plan['cpe']['result']          === ''
            && !$hasCarbaScreenData) {
            $plan['cpe'] = null;
        }

        return $plan;
    }
}

if (!function_exists('bdsis_bact_resistance_plan')) {
    /**
     * Validate and interpret one pathogen row's confirmatory tests from the post.
     *
     * Re-derives the triggers from the posted routine zones, then checks that a
     * triggered test is complete and computes the final interpretations. Nothing
     * is written here; the caller stores the returned plan with
     * bdsis_bact_save_resistance() once the row exists. Fields belonging to a
     * test that was NOT triggered are ignored, and eCIM is ignored unless mCIM
     * is Positive.
     *
     * @param  mysqli $bdsis
     * @param  mixed  $rowIdx      form row index (pathogen[i])
     * @param  string $label       row label for messages, e.g. "Enteric Pathogen 2"
     * @param  array  $codes       posted code[i] (agentIdx => code)
     * @param  array  $zones       posted zone[i] (agentIdx => zone)
     * @param  array  $post        the whole request array
     * @param  array  $breakpoints bdsis_ast_breakpoints()
     * @return array 'ok', 'error', 'esbl' (null|array), 'cpe' (null|array)
     */
    function bdsis_bact_resistance_plan($bdsis, $rowIdx, $label, $codes, $zones, $post, $breakpoints)
    {
        $plan = array('ok' => true, 'error' => '', 'esbl' => null, 'cpe' => null);
        $fail = function ($msg) use (&$plan) { $plan['ok'] = false; $plan['error'] = $msg; return $plan; };
        $field = function ($name, $sub = null) use ($post, $rowIdx) {
            $v = '';
            if (isset($post[$name]) && is_array($post[$name]) && isset($post[$name][$rowIdx])) {
                $v = $post[$name][$rowIdx];
            } elseif ($name === 'carba_np_tube_a' && isset($post['carba_tube_a']) && is_array($post['carba_tube_a']) && isset($post['carba_tube_a'][$rowIdx])) {
                $v = $post['carba_tube_a'][$rowIdx];
            } elseif ($name === 'carba_np_tube_b' && isset($post['carba_tube_b']) && is_array($post['carba_tube_b']) && isset($post['carba_tube_b'][$rowIdx])) {
                $v = $post['carba_tube_b'][$rowIdx];
            } elseif (isset($post[$name]) && is_string($post[$name])) {
                $v = $post[$name];
            } elseif ($name === 'carba_np_tube_a' && isset($post['carba_tube_a']) && is_string($post['carba_tube_a'])) {
                $v = $post['carba_tube_a'];
            } elseif ($name === 'carba_np_tube_b' && isset($post['carba_tube_b']) && is_string($post['carba_tube_b'])) {
                $v = $post['carba_tube_b'];
            }
            if ($sub !== null) { $v = (is_array($v) && isset($v[$sub])) ? $v[$sub] : ''; }
            return is_array($v) ? '' : trim((string)$v);
        };

        /* 1. Routine results, exactly as the AST loop will store them. */
        $results = array();
        foreach ((array)$codes as $agentIdx => $rawCode) {
            $code = strtoupper(trim((string)$rawCode));
            if ($code === '' || !isset($breakpoints[$code])) { continue; }
            $zone = (is_array($zones) && isset($zones[$agentIdx])) ? $zones[$agentIdx] : '';
            $results[$code] = bdsis_ast_interpret_zone($zone, $breakpoints[$code]);
        }
        return bdsis_resistance_plan_core($bdsis, $results, $label, $field);
    }
}

if (!function_exists('bdsis_resistance_tables')) {
    /**
     * Where an isolate's confirmatory results are stored.
     *
     * Two owners, one schema: a bacteriology isolate keys off
     * bacteriology_result_table2.record_id, an E. coli pathotype record off
     * rcdc_ecoli_pcr_result_table3.record_id. The column lists are identical,
     * which is what lets one set of functions serve both.
     *
     * @param  string $owner 'bact' | 'ecoli'
     * @return array  'key', 'main', 'esbl'
     */
    function bdsis_resistance_tables($owner)
    {
        return ((string)$owner === 'ecoli')
            ? array('key' => 'prt3_record_id', 'main' => 'ecoli_resistance_table',        'esbl' => 'ecoli_esbl_table')
            : array('key' => 'brt2_id',        'main' => 'bacteriology_resistance_table', 'esbl' => 'bacteriology_esbl_table');
    }
}

if (!function_exists('bdsis_resistance_delete')) {
    /** Remove one isolate's stored ESBL / carbapenemase results. @return bool */
    function bdsis_resistance_delete($bdsis, $owner, $id)
    {
        $id = (int)$id;
        if ($id <= 0 || !($bdsis instanceof mysqli)) { return false; }
        $t = bdsis_resistance_tables($owner);
        foreach (array($t['esbl'], $t['main']) as $table) {
            $q = $bdsis->prepare("DELETE FROM " . $table . " WHERE " . $t['key'] . "=?");
            if (!$q) { return false; }
            $q->bind_param("i", $id);
            $ok = $q->execute();
            $q->close();
            if (!$ok) { return false; }
        }
        return true;
    }
}

if (!function_exists('bdsis_resistance_save')) {
    /**
     * Store a validated plan (replace semantics). A null plan, or one with
     * neither test triggered, simply clears what was stored.
     *
     * @return bool
     */
    function bdsis_resistance_save($bdsis, $owner, $id, $plan, $user, $today)
    {
        $id = (int)$id;
        $t = bdsis_resistance_tables($owner);
        $ampcBackup = null;
        $chkAmpc = @$bdsis->query("SELECT ampc_triggered, ampc_trigger_agents, ampc_result, ampc_fox_method, ampc_fox_val, ampc_fox_value, ampc_fox_int, ampc_fep_method, ampc_fep_val, ampc_fep_value, ampc_fep_int, ampc_phenotype_result, recorded_by, recorded_on FROM " . $t['main'] . " WHERE " . $t['key'] . "=" . $id);
        if ($chkAmpc && $chkAmpc->num_rows > 0) {
            $rowAmpc = $chkAmpc->fetch_assoc();
            if (!empty($rowAmpc['ampc_triggered']) || !empty($rowAmpc['ampc_result']) || !empty($rowAmpc['ampc_fox_val'])) {
                $ampcBackup = $rowAmpc;
            }
            $chkAmpc->free();
        }

        if (!bdsis_resistance_delete($bdsis, $owner, $id)) { return false; }
        if (!is_array($plan) || ($plan['esbl'] === null && $plan['cpe'] === null)) {
            if ($ampcBackup) {
                $uAmpc = @$bdsis->prepare("INSERT INTO " . $t['main'] . " (" . $t['key'] . ", esbl_triggered, cpe_triggered, ampc_triggered, ampc_trigger_agents, ampc_result, ampc_fox_method, ampc_fox_val, ampc_fox_value, ampc_fox_int, ampc_fep_method, ampc_fep_val, ampc_fep_value, ampc_fep_int, ampc_phenotype_result, recorded_by, recorded_on) VALUES (?, 0, 0, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
                if ($uAmpc) {
                    $uAmpc->bind_param("iissssssssssssss", $id, $ampcBackup['ampc_triggered'], $ampcBackup['ampc_trigger_agents'], $ampcBackup['ampc_result'], $ampcBackup['ampc_fox_method'], $ampcBackup['ampc_fox_val'], $ampcBackup['ampc_fox_value'], $ampcBackup['ampc_fox_int'], $ampcBackup['ampc_fep_method'], $ampcBackup['ampc_fep_val'], $ampcBackup['ampc_fep_value'], $ampcBackup['ampc_fep_int'], $ampcBackup['ampc_phenotype_result'], $ampcBackup['recorded_by'], $ampcBackup['recorded_on']);
                    $uAmpc->execute();
                    $uAmpc->close();
                }
            }
            return true;
        }
        $e = $plan['esbl'];
        $c = $plan['cpe'];

        /* Carba NP columns are added across two migrations:
             2026-10-05-carba-np-columns.sql  -> carba_np_tube_a / carba_np_tube_b
             2026-10-12-carba-np-stored.sql   -> carba_np_result / carba_np_interpretation
           2026-10-17-carba-screening-persistence.sql -> ept_zone_mm, ept_interpretation, etc.
           Each tier is probed independently; the INSERT below includes
           whichever columns the live schema actually has. */
        $hasCarbaCols = function_exists('bdsis_carba_np_columns_exist')
                        && bdsis_carba_np_columns_exist($bdsis);
        $hasCarbaRes  = $hasCarbaCols && function_exists('bdsis_carba_np_result_columns_ensure')
                        && bdsis_carba_np_result_columns_ensure($bdsis);
        $hasScreenCols = function_exists('bdsis_carba_screening_columns_ensure')
                        && bdsis_carba_screening_columns_ensure($bdsis);

        if ($hasScreenCols && $hasCarbaRes) {
            $q = $bdsis->prepare(
                "INSERT INTO " . $t['main'] . "
                   (" . $t['key'] . ", esbl_triggered, esbl_trigger_agents, esbl_result,
                    cpe_triggered, cpe_trigger_agents, cpe_agent, mcim_method, mcim_zone, mcim_colonies, mcim_result,
                    ecim_method, ecim_zone, ecim_result, carbapenemase_result,
                    carba_np_tube_a, carba_np_tube_b, carba_np_result, carba_np_interpretation,
                    carba_tube_a, carba_tube_b, carba_system_result, carba_interpretation,
                    ept_zone_mm, ept_interpretation, imi_zone_mm, imi_interpretation,
                    mer_zone_mm, mer_interpretation, carbapenemase_screening_result, final_carbapenemase_result,
                    recorded_by, recorded_on)
                 VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)");
        } elseif ($hasCarbaRes) {
            $q = $bdsis->prepare(
                "INSERT INTO " . $t['main'] . "
                   (" . $t['key'] . ", esbl_triggered, esbl_trigger_agents, esbl_result,
                    cpe_triggered, cpe_trigger_agents, cpe_agent, mcim_method, mcim_zone, mcim_colonies, mcim_result,
                    ecim_method, ecim_zone, ecim_result, carbapenemase_result,
                    carba_np_tube_a, carba_np_tube_b, carba_np_result, carba_np_interpretation,
                    carba_tube_a, carba_tube_b, carba_system_result, carba_interpretation,
                    recorded_by, recorded_on)
                 VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)");
        } elseif ($hasCarbaCols) {
            $q = $bdsis->prepare(
                "INSERT INTO " . $t['main'] . "
                   (" . $t['key'] . ", esbl_triggered, esbl_trigger_agents, esbl_result,
                    cpe_triggered, cpe_trigger_agents, cpe_agent, mcim_method, mcim_zone, mcim_colonies, mcim_result,
                    ecim_method, ecim_zone, ecim_result, carbapenemase_result,
                    carba_np_tube_a, carba_np_tube_b, carba_tube_a, carba_tube_b,
                    recorded_by, recorded_on)
                 VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)");
        } else {
            $q = $bdsis->prepare(
                "INSERT INTO " . $t['main'] . "
                   (" . $t['key'] . ", esbl_triggered, esbl_trigger_agents, esbl_result,
                    cpe_triggered, cpe_trigger_agents, cpe_agent, mcim_method, mcim_zone, mcim_colonies, mcim_result,
                    ecim_method, ecim_zone, ecim_result, carbapenemase_result, recorded_by, recorded_on)
                 VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)");
        }
        if (!$q) { return false; }
        $esblT = $e ? 1 : 0;   $esblBy = $e ? implode(',', $e['triggered_by']) : null;   $esblR = $e ? $e['result'] : null;
        /* cpe_triggered reflects whether the routine panel's CARBAPENEMS
           tripped the mCIM trigger -- NOT merely whether the row exists. A
           row that carries only Carba NP data (and no CPE trigger) must
           persist with cpe_triggered=0 so reports and the resistance plan
           reload still read "no CPE panel engaged". 2026-10-12 change: moved
           from `$c ? 1 : 0` to an explicit triggered_by check. */
        $cpeT  = ($c && !empty($c['triggered_by'])) ? 1 : 0;
        $cpeBy = $c ? implode(',', (array)$c['triggered_by']) : null;
        $ca    = ($c && isset($c['agent'])) ? $c['agent'] : null;
        $mm = $c ? $c['mcim_method'] : null;   $mz = $c ? $c['mcim_zone'] : null;   $mc = $c ? $c['mcim_colonies'] : null;   $mr = $c ? $c['mcim_result'] : null;
        $em = $c ? $c['ecim_method'] : null;   $ez = $c ? $c['ecim_zone'] : null;   $er = $c ? $c['ecim_result'] : null;      $cr = $c ? $c['result'] : null;
        $cnA = ($c && isset($c['carba_np_tube_a'])) ? $c['carba_np_tube_a'] : (isset($c['carba_tube_a']) ? $c['carba_tube_a'] : null);
        $cnB = ($c && isset($c['carba_np_tube_b'])) ? $c['carba_np_tube_b'] : (isset($c['carba_tube_b']) ? $c['carba_tube_b'] : null);
        $cnR = ($c && isset($c['carba_np_result']))         ? $c['carba_np_result']         : (isset($c['carba_system_result']) ? $c['carba_system_result'] : null);
        $cnI = ($c && isset($c['carba_np_interpretation'])) ? $c['carba_np_interpretation'] : (isset($c['carba_interpretation']) ? $c['carba_interpretation'] : null);

        $eptZ = ($c && isset($c['ept_zone_mm']) && $c['ept_zone_mm'] !== '') ? (string)$c['ept_zone_mm'] : null;
        $eptI = ($c && isset($c['ept_interpretation']) && $c['ept_interpretation'] !== '') ? (string)$c['ept_interpretation'] : null;
        $imiZ = ($c && isset($c['imi_zone_mm']) && $c['imi_zone_mm'] !== '') ? (string)$c['imi_zone_mm'] : null;
        $imiI = ($c && isset($c['imi_interpretation']) && $c['imi_interpretation'] !== '') ? (string)$c['imi_interpretation'] : null;
        $merZ = ($c && isset($c['mer_zone_mm']) && $c['mer_zone_mm'] !== '') ? (string)$c['mer_zone_mm'] : null;
        $merI = ($c && isset($c['mer_interpretation']) && $c['mer_interpretation'] !== '') ? (string)$c['mer_interpretation'] : null;
        $scrR = ($c && isset($c['carbapenemase_screening_result']) && $c['carbapenemase_screening_result'] !== '') ? (string)$c['carbapenemase_screening_result'] : null;
        $finR = ($c && isset($c['final_carbapenemase_result']) && $c['final_carbapenemase_result'] !== '') ? (string)$c['final_carbapenemase_result'] : ($cr !== null ? $cr : null);

        $user = (string)$user; $today = (string)$today;
        if ($hasScreenCols && $hasCarbaRes) {
            $q->bind_param("iississsdsssdssssssssssssssssssss", $id, $esblT, $esblBy, $esblR, $cpeT, $cpeBy, $ca,
                           $mm, $mz, $mc, $mr, $em, $ez, $er, $cr, $cnA, $cnB, $cnR, $cnI, $cnA, $cnB, $cnR, $cnI,
                           $eptZ, $eptI, $imiZ, $imiI, $merZ, $merI, $scrR, $finR, $user, $today);
        } elseif ($hasCarbaRes) {
            $q->bind_param("iississsdsssdssssssssssss", $id, $esblT, $esblBy, $esblR, $cpeT, $cpeBy, $ca,
                           $mm, $mz, $mc, $mr, $em, $ez, $er, $cr, $cnA, $cnB, $cnR, $cnI, $cnA, $cnB, $cnR, $cnI, $user, $today);
        } elseif ($hasCarbaCols) {
            $q->bind_param("iississsdsssdssssssss", $id, $esblT, $esblBy, $esblR, $cpeT, $cpeBy, $ca,
                           $mm, $mz, $mc, $mr, $em, $ez, $er, $cr, $cnA, $cnB, $cnA, $cnB, $user, $today);
        } else {
            $q->bind_param("iississsdsssdssss", $id, $esblT, $esblBy, $esblR, $cpeT, $cpeBy, $ca,
                           $mm, $mz, $mc, $mr, $em, $ez, $er, $cr, $user, $today);
        }
        $ok = $q->execute();
        $q->close();
        if (!$ok) { return false; }

        if ($e) {
            $d = $bdsis->prepare("INSERT INTO " . $t['esbl'] . " (" . $t['key'] . ", agent_code, esbl_method, zone_diameter) VALUES (?,?,?,?)");
            if (!$d) { return false; }
            foreach ($e['agents'] as $code => $row) {
                $code = (string)$code; $m = (string)$row['method']; $z = (float)$row['zone'];
                $d->bind_param("issd", $id, $code, $m, $z);
                if (!$d->execute()) { $d->close(); return false; }
            }
            $d->close();
        }
        if ($ampcBackup) {
            $uAmpc = @$bdsis->prepare("UPDATE " . $t['main'] . " SET ampc_triggered=?, ampc_trigger_agents=?, ampc_result=?, ampc_fox_method=?, ampc_fox_val=?, ampc_fox_value=?, ampc_fox_int=?, ampc_fep_method=?, ampc_fep_val=?, ampc_fep_value=?, ampc_fep_int=?, ampc_phenotype_result=? WHERE " . $t['key'] . "=?");
            if ($uAmpc) {
                $uAmpc->bind_param("isssssssssssi", $ampcBackup['ampc_triggered'], $ampcBackup['ampc_trigger_agents'], $ampcBackup['ampc_result'], $ampcBackup['ampc_fox_method'], $ampcBackup['ampc_fox_val'], $ampcBackup['ampc_fox_value'], $ampcBackup['ampc_fox_int'], $ampcBackup['ampc_fep_method'], $ampcBackup['ampc_fep_val'], $ampcBackup['ampc_fep_value'], $ampcBackup['ampc_fep_int'], $ampcBackup['ampc_phenotype_result'], $id);
                $uAmpc->execute();
                $uAmpc->close();
            }
        }
        return true;
    }
}

if (!function_exists('bdsis_resistance_load')) {
    /**
     * One isolate's stored results, for the form and the reports. null when
     * nothing is stored (or the tables are not installed).
     *
     * @return array|null 'esbl' => null|array('triggered_by','result','agents'),
     *                    'cpe'  => null|array(mcim_*, ecim_*, 'result')
     */
    function bdsis_resistance_load($bdsis, $owner, $id)
    {
        $id = (int)$id;
        if ($id <= 0 || !($bdsis instanceof mysqli)) { return null; }
        $t = bdsis_resistance_tables($owner);

        /* Pull the Carba NP tube columns only when the 2026-10-05 migration
           has been applied, and the computed result + interpretation columns
           only when the 2026-10-12 follow-up has been applied.
           IMPORTANT: only select the REAL columns (carba_np_*).
           carba_tube_a / carba_tube_b / carba_system_result / carba_interpretation
           are form/PHP aliases only and do NOT exist in the table. */
        $hasCarbaCols = function_exists('bdsis_carba_np_columns_exist')
                        && bdsis_carba_np_columns_exist($bdsis);
        $hasCarbaRes  = $hasCarbaCols && function_exists('bdsis_carba_np_result_columns_ensure')
                        && bdsis_carba_np_result_columns_ensure($bdsis);
        $hasScreenCols = function_exists('bdsis_carba_screening_columns_exist')
                        && bdsis_carba_screening_columns_exist($bdsis);

        // FIXED: only real DB columns
        $extraCols = $hasCarbaRes
            ? ', carba_np_tube_a, carba_np_tube_b, carba_np_result, carba_np_interpretation'
            : ($hasCarbaCols ? ', carba_np_tube_a, carba_np_tube_b' : '');

        if ($hasScreenCols) {
            $extraCols .= ', ept_zone_mm, ept_interpretation, imi_zone_mm, imi_interpretation, mer_zone_mm, mer_interpretation, carbapenemase_screening_result, final_carbapenemase_result';
        }

        $res = @$bdsis->query("SELECT esbl_triggered, esbl_trigger_agents, esbl_result, cpe_triggered, cpe_trigger_agents, cpe_agent,
                                      mcim_method, mcim_zone, mcim_colonies, mcim_result, ecim_method, ecim_zone, ecim_result, carbapenemase_result" . $extraCols . "
                                 FROM " . $t['main'] . " WHERE " . $t['key'] . "=" . $id);
        if (!$res || $res->num_rows === 0) { return null; }
        $r = $res->fetch_assoc();
        $res->free();
        $out = array('esbl' => null, 'cpe' => null);

        if ((int)$r['esbl_triggered'] === 1) {
            $agents = array();
            $d = @$bdsis->query("SELECT agent_code, esbl_method, zone_diameter FROM " . $t['esbl'] . " WHERE " . $t['key'] . "=" . $id);
            if ($d) {
                while (list($code, $m, $z) = $d->fetch_row()) {
                    $agents[(string)$code] = array('method' => (string)$m, 'zone' => ($z === null ? '' : (string)$z));
                }
                $d->free();
            }
            $out['esbl'] = array(
                'triggered_by' => array_filter(explode(',', (string)$r['esbl_trigger_agents'])),
                'result' => (string)$r['esbl_result'],
                'agents' => $agents,
            );
        }

        /* 2026-10-12 / 2026-10-17: a row may exist for Carba NP data alone or Module A screening data alone. */
        $hasCpeTrigger = ((int)$r['cpe_triggered'] === 1);

        // Safe read – only the real columns exist
        $cnA = !empty($r['carba_np_tube_a']) ? (string)$r['carba_np_tube_a'] : '';
        $cnB = !empty($r['carba_np_tube_b']) ? (string)$r['carba_np_tube_b'] : '';
        $cnR = !empty($r['carba_np_result']) ? (string)$r['carba_np_result'] : '';
        $cnI = !empty($r['carba_np_interpretation']) ? (string)$r['carba_np_interpretation'] : '';

        $hasCarbaNpData     = ($cnA !== '' || $cnB !== '');
        $hasCarbaResultData = ($cnR !== '' || $cnI !== '');

        $eptZ = !empty($r['ept_zone_mm']) ? (string)$r['ept_zone_mm'] : '';
        $eptI = !empty($r['ept_interpretation']) ? (string)$r['ept_interpretation'] : '';
        $imiZ = !empty($r['imi_zone_mm']) ? (string)$r['imi_zone_mm'] : '';
        $imiI = !empty($r['imi_interpretation']) ? (string)$r['imi_interpretation'] : '';
        $merZ = !empty($r['mer_zone_mm']) ? (string)$r['mer_zone_mm'] : '';
        $merI = !empty($r['mer_interpretation']) ? (string)$r['mer_interpretation'] : '';
        $scrR = !empty($r['carbapenemase_screening_result']) ? (string)$r['carbapenemase_screening_result'] : '';
        $finR = !empty($r['final_carbapenemase_result']) ? (string)$r['final_carbapenemase_result'] : '';
        $hasScreenData = ($eptZ !== '' || $imiZ !== '' || $merZ !== '' || $scrR !== '' || $finR !== '');

        if ($hasCpeTrigger || $hasCarbaNpData || $hasCarbaResultData || $hasScreenData) {
            $out['cpe'] = array(
                'triggered_by' => array_filter(explode(',', (string)$r['cpe_trigger_agents'])),
                'agent' => (string)$r['cpe_agent'],
                'mcim_method' => (string)$r['mcim_method'],
                'mcim_zone' => ($r['mcim_zone'] === null ? '' : (string)$r['mcim_zone']),
                'mcim_colonies' => (string)$r['mcim_colonies'],
                'mcim_result' => (string)$r['mcim_result'],
                'ecim_method' => (string)$r['ecim_method'],
                'ecim_zone' => ($r['ecim_zone'] === null ? '' : (string)$r['ecim_zone']),
                'ecim_result' => (string)$r['ecim_result'],
                'result' => (string)$r['carbapenemase_result'],

                // Real columns
                'carba_np_tube_a'         => $cnA,
                'carba_np_tube_b'         => $cnB,
                'carba_np_result'         => $cnR,
                'carba_np_interpretation' => $cnI,

                // PHP / form aliases (kept for UI compatibility)
                'carba_tube_a'            => $cnA,
                'carba_tube_b'            => $cnB,
                'carba_system_result'     => $cnR,
                'carba_interpretation'    => $cnI,

                'ept_zone_mm'                    => $eptZ,
                'ept_interpretation'            => $eptI,
                'imi_zone_mm'                    => $imiZ,
                'imi_interpretation'            => $imiI,
                'mer_zone_mm'                    => $merZ,
                'mer_interpretation'            => $merI,
                'carbapenemase_screening_result' => $scrR,
                'final_carbapenemase_result'     => ($finR !== '' ? $finR : (string)$r['carbapenemase_result']),
            );
        }

        return ($out['esbl'] === null && $out['cpe'] === null) ? null : $out;
    }
}

