        /* ---- AmpC β-Lactamase Test (immediately after ESBL combination-disk text) ----
           Per the client's spec, this block sits BETWEEN the ESBL Test above
           and the Carbapenem Test below -- not at the end of the panel group.
           Trigger (CTX + CRO + CAZ all Resistant), auto-pool CTX/CRO/FEP zones
           from the routine AST, manual FOX entry, and the "Final AmpC Status"
           combined rule all live in includes/lab-ampc.php; nothing else in
           this file is touched by this move. */
        if (function_exists('bdsis_ampc_panel_html')) {
            $ampcSaved = (is_array($resist) && isset($resist['ampc']) && is_array($resist['ampc'])) ? $resist['ampc'] : null;
            $h .= bdsis_ampc_panel_html($idx, $ampcSaved);
        }

        /* ---- Carbapenemase Detection (2026-10-07 redesign) --------------------
           Module A -- Carbapenemase Screening (auto):
             Three carbapenems (Ertapenem EPT, Imipenem IMI, Meropenem MER) are
             auto-displayed; zone and interpretation are pulled live from the
             routine ABST above by bpCarbaScreenSync() in lab.php. The screening
             result is auto-computed Positive when any of
                 EPT <= 18 mm   OR   IMI <= 19 mm   OR   MEM <= 19 mm
             else Negative.
           Module B -- Carbapenemase Confirmation (shown only when Module A =
           Positive): fixed MER + readonly mCIM method + manual Zone + pinpoint
           colonies dropdown + auto-interpreted mCIM result (stored in the
           legacy mcim_result column as Positive / Negative / Indeterminate).
           mCIM/eCIM Combination (shown only when mCIM = Positive): eCIM zone
           entry; difference = eCIM - mCIM; final result:
             mCIM Negative      -> Carbapenemase not detected
             mCIM Positive + eCIM >= mCIM + 5  -> Metallo-beta-lactamase detected
             mCIM Positive + eCIM <  mCIM + 5  -> Serine carbapenemase detected
             mCIM Indeterminate -> Testing inconclusive
           Save path: no schema change. Method is always "mCIM" (hidden input);
           eCIM method is always "mCIM/eCIM"; the mcim_* and ecim_* columns
           carry what the existing bdsis_resistance_save already writes. */

        $cMethod  = $c ? $c['mcim_method'] : 'mCIM';
        $cStoredResult = $c ? (string)$c['mcim_result'] : '';
        $moduleBOpen = $c && ($cStoredResult !== '');   // show Module B on load when the record carries any mCIM result
        $ecimOn = ($cStoredResult === 'Positive');

        /* 2026-10-12: $c may now be populated for a row that carries ONLY
           Carba NP data (no CPE trigger, no mCIM reading). Keep #bpCpe
           hidden in that case so the user doesn't see a Carbapenemase
           Detection panel open against an isolate whose routine never
           tripped the CPE screen. The standalone Carba NP card is rendered
           further down and always shows itself. */
        $hasResistantCarbapenem = false;
        if ($c) {
            if (!empty($c['triggered_by'])) {
                $hasResistantCarbapenem = true;
            }
            if ((isset($c['ept_interpretation']) && $c['ept_interpretation'] === 'Resistant') ||
                (isset($c['imi_interpretation']) && $c['imi_interpretation'] === 'Resistant') ||
                (isset($c['mer_interpretation']) && $c['mer_interpretation'] === 'Resistant')) {
                $hasResistantCarbapenem = true;
            }
        }
        $showCpeCard = $hasResistantCarbapenem;
        $h .= '<div class="lr-reveal bp-cpe" id="bpCpe'.$idx.'" style="display:'.($showCpeCard ? 'block' : 'none').';">';
        $h .= '<div class="lr-subcard lr-subcard--cpe">';
        $h .= '<div class="lr-subcard__head"><h4 class="lr-subcard__title">Carbapenemase Detection</h4>'
            . '<span class="lr-trigger"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i>Required &mdash; <span class="bp-cpe-why">'.$hv($c && !empty($c['triggered_by']) ? implode(', ', $c['triggered_by']) : '').'</span> Resistant</span></div>';

        /* --- Module A: Carbapenemase Screening (auto) -----------------------
           Thresholds (2026-10-10 spec): ETA <= 18 mm (inclusive), IPM < 19 mm
           (strictly less), MEM <= 19 mm (inclusive). The per-row 'cmp' field
           drives both the help text and the client-side comparator so the
           inclusive vs exclusive distinction stays in one place. */
        /* 2026-10-14: Module A is dual-perspective. Under a DD routine the
           three screening inputs carry zone diameters in mm; under a MIC
           routine they carry MIC values in µg/mL and the thresholds are
           different numbers in the opposite direction. The DD wording is
           rendered as the default (correct before any JS runs, and for
           the DD majority) and every mm-specific string is tagged so
           bpCarbaScreenModeCopy() in lab.php can swap it when the row's
           Method is MIC. Mirrors the bp-ampc-value-unit mechanism the
           AmpC panel already uses for the same reason. */
        $ddHint  = 'Auto-pulled from the ABST reading above; editable when missing.';
        $micHint = 'Auto-pulled from the ABST — type here if a reading is missing.';
        $h .= '<div class="bp-cpe-module">'
            . '<h5 class="bp-cpe-module__title">Module A &mdash; Carbapenemase Screening</h5>'
            . '<span class="lr-agent-sub bp-cpe-screen-hint"'
            . ' data-dd-hint="'.$hv($ddHint).'" data-mic-hint="'.$hv($micHint).'">'
            . $hv($ddHint) . '</span>';
        $h .= '<div class="row lr-grid-head d-none d-md-flex" style="margin-top:.5rem;">'
            . '<div class="col-md-5">Antibiotic</div>'
            . '<div class="col-md-3"><span class="bp-cpe-screen-unit">Zone (mm)</span></div>'
            . '<div class="col-md-4">Interpretation</div></div>';
        $screenRows = array(
            'EPT' => array('name' => 'Ertapenem',  'content' => '10 µg', 'thr' => 18, 'cmp' => 'lte', 'micthr' => 1),
            'IMI' => array('name' => 'Imipenem',   'content' => '10 µg', 'thr' => 19, 'cmp' => 'lt',  'micthr' => 2),
            'MER' => array('name' => 'Meropenem',  'content' => '10 µg', 'thr' => 19, 'cmp' => 'lte', 'micthr' => 2),
        );
        foreach ($screenRows as $code => $row) {
            $zId = 'bpCarbaScreenZone'.$idx.'_'.$code;
            $rId = 'bpCarbaScreenInterp'.$idx.'_'.$code;
            $cmp = (isset($row['cmp']) && $row['cmp'] === 'lt') ? 'lt' : 'lte';
            $thrTitle = 'Positive if zone ' . ($cmp === 'lt' ? '&lt; ' : '&le; ') . (int)$row['thr'] . ' mm';
            $micThr      = isset($row['micthr']) ? $row['micthr'] : null;
            $micThrTitle = ($micThr === null) ? $thrTitle
                         : 'Positive if MIC &gt; ' . $micThr . ' µg/mL';

            $cKey = strtolower($code);
            $curZ = ($c && isset($c[$cKey.'_zone_mm']) && $c[$cKey.'_zone_mm'] !== '') ? (string)$c[$cKey.'_zone_mm'] : '';
            $curI = ($c && isset($c[$cKey.'_interpretation']) && $c[$cKey.'_interpretation'] !== '') ? (string)$c[$cKey.'_interpretation'] : '';

            $h .= '<div class="row lr-line">';
            $h .= '<div class="col-md-5 lr-cell lr-cell--name"><span class="lr-agent">'.$hv($row['name']).' <small>'.$hv($row['content']).'</small></span>'
                . '<span class="lr-agent-sub">'.$hv($code).'</span></div>';
            $h .= '<div class="col-6 col-md-3 lr-cell"><label class="lr-cell-label" for="'.$zId.'"><span class="bp-cpe-screen-unit">Zone (mm)</span>:</label>'
                . '<input type="number" min="0" max="512" step="any" class="form-control text-center bp-cpe-screen-zone"'
                . ' id="'.$zId.'" name="'.$cKey.'_zone_mm['.$idx.']" data-code="'.$hv($code).'" data-field="'.$cKey.'_zone_mm" data-threshold="'.(int)$row['thr'].'" data-threshold-cmp="'.$cmp.'"'
                . ($micThr === null ? '' : ' data-mic-threshold="'.$hv($micThr).'"')
                . ' data-dd-title="'.$thrTitle.' (editable; auto-pulled from ABST reading above)"'
                . ' data-mic-title="'.$micThrTitle.' (editable; auto-pulled from ABST reading above)"'
                . ' value="'.$hv($curZ).'" placeholder="Zone" title="'.$thrTitle.'" oninput="bpCarbaScreenManualInput(this, \''.$idx.'\', \''.$hv($code).'\');" />'
                . '<input type="hidden" name="'.$cKey.'_zone_mm" id="'.$cKey.'_zone_mm_'.$idx.'" value="'.$hv($curZ).'" />'
                . '<input type="hidden" name="'.$cKey.'_val['.$idx.']" id="'.$cKey.'_val_'.$idx.'" value="'.$hv($curZ).'" />'
                . '<input type="hidden" name="'.$cKey.'_val" value="'.$hv($curZ).'" />'
                . '</div>';
            $h .= '<div class="col-6 col-md-4 lr-cell"><label class="lr-cell-label" for="'.$rId.'">Interpretation:</label>'
                . '<input type="text" class="form-control lr-pill bp-cpe-screen-interp" id="'.$rId.'"'
                . ' name="'.$cKey.'_interpretation['.$idx.']" data-field="'.$cKey.'_interpretation"'
                . ' value="'.$hv($curI).'" readonly tabindex="-1" placeholder="&ndash;" />'
                . '<input type="hidden" name="'.$cKey.'_interpretation" id="'.$cKey.'_interpretation_'.$idx.'" value="'.$hv($curI).'" />'
                . '<input type="hidden" name="cpe_screen_interp['.$idx.']['.$hv($code).']" value="'.$hv($curI).'" />'
                . '</div>';
            $h .= '</div>';
        }
        $curScreen = ($c && isset($c['carbapenemase_screening_result'])) ? (string)$c['carbapenemase_screening_result'] : '';
        /* Screening Result row (auto-computed Positive/Negative). */
        $h .= '<div class="row lr-line lr-line--result">'
            . '<div class="col-md-8 lr-cell lr-cell--name"><span class="lr-agent">Carbapenemase Screening Result</span></div>'
            . '<div class="col-md-4 lr-cell"><label class="lr-cell-label" for="bpCpeScreenResult'.$idx.'">Screening Result:</label>'
            . '<input type="text" class="form-control lr-pill bp-cpe-screen-result" id="bpCpeScreenResult'.$idx.'"'
            . ' name="carbapenemase_screening_result['.$idx.']"'
            . ' title="Positive when any carbapenem meets its threshold, else Negative. Module B opens on Positive."'
            . ' value="'.$hv($curScreen).'" readonly tabindex="-1" placeholder="Pending" />'
            . '<input type="hidden" name="carbapenemase_screening_result" id="carbapenemase_screening_result_'.$idx.'" value="'.$hv($curScreen).'" />'
            . '<input type="hidden" name="carbapenemase_screen_res['.$idx.']" id="carbapenemase_screen_res_'.$idx.'" value="'.$hv($curScreen).'" />'
            . '<input type="hidden" name="carbapenemase_screen_res" value="'.$hv($curScreen).'" />'
            . '<input type="hidden" name="cpe_screen_result['.$idx.']" value="'.$hv($curScreen).'" />'
            . '</div></div>';
        $h .= '</div>';   /* /.bp-cpe-module (Module A) */

        /* --- Module B: Carbapenemase Confirmation (shown only on screen Pos) --- */
        $h .= '<div class="bp-cpe-module bp-cpe-module-b" id="bpCpeModuleB'.$idx.'" style="display:'.($moduleBOpen ? 'block' : 'none').';">';
        /* 2026-10-14 UI cleanup: the sub-label restated the Antibiotic and
           Method values that the two readonly fields immediately below already
           display, and both of those carry their own "Fixed per protocol" /
           "Auto-set: mCIM" tooltips. */
        $h .= '<h5 class="bp-cpe-module__title">Module B &mdash; Carbapenemase Confirmation</h5>';
        /* Row 1 -- Antibiotic (fixed) + Method (readonly "mCIM"). */
        $h .= '<div class="row lr-line" style="margin-top:.5rem;">';
        $h .= '<div class="col-md-6 lr-cell"><label class="lr-cell-label" for="bpCpeAgent'.$idx.'">Antibiotic:</label>'
            . '<input type="text" class="form-control" id="bpCpeAgent'.$idx.'" value="Meropenem (MER) &mdash; 10 µg" readonly tabindex="-1" title="Fixed per protocol" />'
            . '<input type="hidden" name="cpe_agent['.$idx.']" value="MER" /></div>';
        $h .= '<div class="col-md-6 lr-cell"><label class="lr-cell-label" for="bpMcimMethod'.$idx.'">Method:</label>'
            . '<input type="text" class="form-control bp-cpe-method bp-cpe-method--auto" id="bpMcimMethod'.$idx.'"'
            . ' value="mCIM" readonly tabindex="-1" title="Auto-set: mCIM" />'
            . '<input type="hidden" name="mcim_method['.$idx.']" value="mCIM" /></div>';
        $h .= '</div>';
        /* Row 2 -- Zone (manual) + mCIM Interpretation pill (auto). The
           "Point Colonies within zone?" Yes/No tie-breaker was retired on
           2026-10-10 at the client's request, so the zone and its
           interpretation now sit side-by-side on one aligned row. */
        $h .= '<div class="row lr-line">';
        /* 2026-10-14 UI cleanup: the full-width "Rules:" caption row that used
           to sit under this row is gone; the same three bands now hover on the
           zone input and on its interpretation pill. No clinical rule is
           discarded here, it is only moved off the page body. */
        $mcimRules = 'Zone >= 19 mm -> Negative (carbapenemase not detected). '
                   . '16-18 mm -> Indeterminate (testing inconclusive). '
                   . '6-15 mm -> Positive (carbapenemase detected).';
        $h .= '<div class="col-md-6 lr-cell"><label class="lr-cell-label" for="bpMcimZone'.$idx.'">Zone Diameter (mm):</label>'
            . '<input type="number" step="any" min="0" max="512" name="mcim_zone['.$idx.']" id="bpMcimZone'.$idx.'" class="form-control text-center"'
            . ' title="'.$hv($mcimRules).'"'
            . ' value="'.$hv($c ? $c['mcim_zone'] : '').'" oninput="bpMcimInterpret(\''.$idx.'\');" />'
            . '<input type="hidden" name="mcim_val['.$idx.']" id="mcim_val_'.$idx.'" value="'.$hv($c ? $c['mcim_zone'] : '').'" />'
            . '<input type="hidden" name="mcim_val" value="'.$hv($c ? $c['mcim_zone'] : '').'" /></div>';
        $h .= '<div class="col-md-6 lr-cell"><label class="lr-cell-label" for="bpMcimResult'.$idx.'">mCIM Interpretation:</label>'
            . '<input type="text" name="mcim_result['.$idx.']" id="bpMcimResult'.$idx.'" class="form-control lr-pill bp-cpe-interp-label" readonly tabindex="-1"'
            . ' title="'.$hv($mcimRules).'"'
            . ' placeholder="Pending" value="'.$hv($cStoredResult).'" />'
            . '<input type="hidden" name="mcim_res['.$idx.']" id="mcim_res_'.$idx.'" value="'.$hv($cStoredResult).'" />'
            . '<input type="hidden" name="mcim_res" value="'.$hv($cStoredResult).'" /></div>';
        $h .= '</div>';

        /* --- mCIM/eCIM Combination Test (shown only on mCIM Positive) --- */
        $h .= '<div class="lr-reveal bp-ecim" id="bpEcim'.$idx.'" style="display:'.($ecimOn ? 'block' : 'none').';">';
        $h .= '<div class="lr-subcard__head" style="margin-top:.75rem;">'
            . '<h5 class="bp-cpe-module__title" style="font-size:1rem;">mCIM / eCIM Combination Test</h5>'
            . '</div>';
        /* 2026-10-14 UI cleanup: the MBL / serine cut-off moved from this
           sub-label onto the Increase and eCIM Result controls below, where the
           reader is actually looking when the number appears. */
        $ecimRule = 'Increase >= 5 mm -> Metallo-beta-lactamase (MBL). Below 5 mm -> serine carbapenemase.';
        /* ecim_method is auto-set to "eCIM" via hidden input. (The second step
           of the mCIM/eCIM workflow IS eCIM; server validation accepts "eCIM"
           as one of bdsis_ecim_methods().) */
        $h .= '<input type="hidden" name="ecim_method['.$idx.']" value="eCIM" />';
        $h .= '<div class="row" style="margin-top:.5rem;">';
        $h .= '<div class="col-md-3"><label class="lr-mini-label" for="bpCombMcimZone'.$idx.'">mCIM Zone (mm):</label>'
            . '<input type="text" class="form-control text-center" id="bpCombMcimZone'.$idx.'" value="'.$hv($c ? $c['mcim_zone'] : '').'" readonly tabindex="-1" placeholder="(from Module B)" /></div>';
        $h .= '<div class="col-md-3"><label class="lr-mini-label" for="bpEcimZone'.$idx.'">eCIM Zone (mm):</label>'
            . '<input type="number" step="any" min="0" max="512" name="ecim_zone['.$idx.']" id="bpEcimZone'.$idx.'" class="form-control text-center"'
            . ' value="'.$hv($c ? $c['ecim_zone'] : '').'" oninput="bpEcimInterpret(\''.$idx.'\');" />'
            . '<input type="hidden" name="ecim_val['.$idx.']" id="ecim_val_'.$idx.'" value="'.$hv($c ? $c['ecim_zone'] : '').'" />'
            . '<input type="hidden" name="ecim_val" value="'.$hv($c ? $c['ecim_zone'] : '').'" /></div>';
            . '<input type="hidden" name="ecim_val['.$idx.']" id="ecim_val_'.$idx.'" value="'.$hv($c ? $c['ecim_zone'] : '').'" /></div>';
        $h .= '<div class="col-md-3"><label class="lr-mini-label" for="bpEcimDiff'.$idx.'">Increase (eCIM &minus; mCIM):</label>'
            . '<input type="text" class="form-control text-center lr-pill" id="bpEcimDiff'.$idx.'" readonly tabindex="-1"'
            . ' title="'.$hv($ecimRule).'" placeholder="&ndash;" /></div>';
        $h .= '<div class="col-md-3"><label class="lr-mini-label" for="bpEcimResult'.$idx.'">eCIM Result:</label>'
            . '<input type="text" name="ecim_result['.$idx.']" id="bpEcimResult'.$idx.'" class="form-control lr-pill" readonly tabindex="-1"'
            . ' title="'.$hv($ecimRule).'" placeholder="Pending" value="'.$hv($c ? $c['ecim_result'] : '').'" />'
            . '<input type="hidden" name="ecim_res['.$idx.']" id="ecim_res_'.$idx.'" value="'.$hv($c ? $c['ecim_result'] : '').'" />'
            . '<input type="hidden" name="ecim_res" value="'.$hv($c ? $c['ecim_result'] : '').'" /></div>';
            . '<input type="hidden" name="ecim_res['.$idx.']" id="ecim_res_'.$idx.'" value="'.$hv($c ? $c['ecim_result'] : '').'" /></div>';
        $h .= '</div>';
        $h .= '</div>';   /* /#bpEcim{idx} */
        /* Placeholder when eCIM is not required (mCIM Negative / Indeterminate). */
        $cEcimNoteStyle = $ecimOn ? 'display:none;' : 'display:block;';
        $h .= '<div class="lr-reveal bp-ecim-na" id="bpEcimNa'.$idx.'" style="'.$cEcimNoteStyle.'">'
            . '<label class="lr-cell-label" for="bpEcimNaText'.$idx.'">mCIM / eCIM Combination Test:</label>'
            . '<input type="text" class="form-control lr-pill" id="bpEcimNaText'.$idx.'"'
            . ' value="Not required (mCIM is Negative or Indeterminate)" readonly tabindex="-1" /></div>';
        $h .= '</div>';   /* /#bpCpeModuleB{idx} */

        /* Final Carbapenemase Detection result -- auto-generated. Stored in
           carbapenemase_result (via cpe_result[idx] and final_carbapenemase_result). bpMcimInterpret / bpEcimInterpret
           in lab.php keep this in sync as the user edits. */
        $curFinal = ($c && !empty($c['final_carbapenemase_result'])) ? (string)$c['final_carbapenemase_result'] : ($c ? (string)$c['result'] : '');
        $h .= '<div class="row lr-line lr-line--result">'
            . '<div class="col-md-8 lr-cell lr-cell--name"><span class="lr-agent">Final Carbapenemase Detection Result</span></div>'
            . '<div class="col-md-4 lr-cell"><label class="lr-cell-label" for="bpCpeResult'.$idx.'">Final Result:</label>'
            . '<input type="text" name="final_carbapenemase_result['.$idx.']" id="bpCpeResult'.$idx.'" class="form-control lr-pill" readonly tabindex="-1"'
            . ' title="Auto-generated from mCIM and eCIM. One of: carbapenemase not detected, metallo-beta-lactamase detected, serine carbapenemase detected, testing inconclusive."'
            . ' placeholder="Pending" value="'.$hv($curFinal).'" />'
            . '<input type="hidden" name="final_carbapenemase_result" id="final_carbapenemase_result_'.$idx.'" value="'.$hv($curFinal).'" />'
            . '<input type="hidden" name="final_carbapenemase_result['.$idx.']" id="final_carbapenemase_result_'.$idx.'" value="'.$hv($curFinal).'" />'
            . '<input type="hidden" name="final_carbapenemase_res['.$idx.']" id="final_carbapenemase_res_'.$idx.'" value="'.$hv($curFinal).'" />'
            . '<input type="hidden" name="final_carbapenemase_res" value="'.$hv($curFinal).'" />'
            . '<input type="hidden" name="cpe_result['.$idx.']" value="'.$hv($curFinal).'" />'
            . '</div></div>';

        $h .= '</div></div>';   /* /.lr-subcard /#bpCpe{idx} */

        /* ---- Carba NP Test (standalone, 2026-10-07) --------------------------
           Rendered as its own card right after the Carbapenemase Detection
           panel. Visible only when the Carbapenemase Detection module is
           opened ($showCpeCard on render, and synced client-side with #bpCpe). */
        if (function_exists('bdsis_carba_np_standalone_panel_html')) {
            $h .= bdsis_carba_np_standalone_panel_html($idx, $c, $showCpeCard);
        }

        /* AmpC panel is now rendered BEFORE the Carbapenem Test above
           (immediately after the ESBL combination-disk help text) per the
           client's updated placement spec. The call site at the top of
           this function is the single source of truth for AmpC rendering. */

        return $h;
    }
}

if (!function_exists('bdsis_ecoli_resistance_panels')) {
    /**
     * The ESBL / carbapenemase panels for one E. coli pathotype record, ready to
     * drop under its AST tiles (lab/load-ecoli-ast.php).
     *
     * Empty when there is no saved pathotype record to hang the results on: the
     * confirmatory tables key off rcdc_ecoli_pcr_result_table3.record_id, so
     * until the PCR pathotype is saved there is nothing to store against.
     *
     * \@return string
     */
    function bdsis_ecoli_resistance_panels($bdsis, $prt3rid)
    {
        $id = (int)$prt3rid;
        if ($id <= 0 || !($bdsis instanceof mysqli)) { return ''; }
        $idx = bdsis_ecoli_resistance_key($id);
        $html = bdsis_bact_resistance_panels_html($idx, bdsis_ecoli_load_resistance($bdsis, $id), bdsis_esbl_agents($bdsis));
        return '<div class="col-12 eco-resistance" data-ecoidx="' . htmlspecialchars($idx, ENT_QUOTES) . '" data-prt3="' . $id . '">' . $html . '</div>';
    }
}

