if (!function_exists('bdsis_carba_np_result')) {
    /**
     * System Result -- Positive / Negative / Invalid per the 2026-10-07
     * standalone Carba NP Test spec. Separate from the Interpretation
     * Output below (both are surfaced in the UI as two fields).
     *
     *   Rule 1: A = Red/red-orange + B = Light orange, dark yellow, or yellow -> Positive
     *   Rule 2: A = Red/red-orange + B = Red or red-orange                    -> Negative
     *   Rule 3: A = Red/red-orange + B = Orange                               -> Invalid
     *   Rule 4: A = Orange, ..., yellow (bad control) + B = any               -> Invalid
     */
    function bdsis_carba_np_result($tubeA, $tubeB)
    {
        $A_OK      = 'Red or red-orange';
        $A_INVALID = 'Orange, light orange, dark yellow or yellow';
        $a = bdsis_carba_np_normalise_tube_a($tubeA);
        $b = trim((string)$tubeB);
        if ($a === $A_INVALID) { return 'Invalid'; }                                /* rule 4 */
        if ($a === $A_OK) {
            if ($b === 'Light orange, dark yellow, or yellow') { return 'Positive'; }  /* rule 1 */
            if ($b === 'Red or red-orange')                    { return 'Negative'; }  /* rule 2 */
            if ($b === 'Orange')                               { return 'Invalid'; }   /* rule 3 */
        }
        return '';
    }
}
