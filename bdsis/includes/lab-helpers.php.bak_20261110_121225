if (!function_exists('bdsis_ecoli_resistance_plan')) {
    /**
     * Validate the ESBL / carbapenemase panels posted with one E. coli AST panel.
     *
     * Same rules as a bacteriology isolate -- the shared core decides -- only the
     * posted field layout differs.
     *
     * @param  mysqli $bdsis
     * @param  string $prt3rid rcdc_ecoli_pcr_result_table3.record_id
     * @param  string $label   panel name, used in the refusal messages
     * @param  array  $results bdsis_ecoli_ast_results()
     * @param  array  $post    $_POST
     * @return array  'ok', 'error', 'esbl', 'cpe'
     */
    function bdsis_ecoli_resistance_plan($bdsis, $prt3rid, $label, $results, $post)
    {
        $key = bdsis_ecoli_resistance_key($prt3rid);
        $field = function ($name, $sub = null) use ($post, $key) {
            $v = '';
            if (isset($post[$name]) && is_array($post[$name]) && isset($post[$name][$key])) {
                $v = $post[$name][$key];
            } elseif ($name === 'carba_np_tube_a' && isset($post['carba_tube_a']) && is_array($post['carba_tube_a']) && isset($post['carba_tube_a'][$key])) {
                $v = $post['carba_tube_a'][$key];
            } elseif ($name === 'carba_np_tube_b' && isset($post['carba_tube_b']) && is_array($post['carba_tube_b']) && isset($post['carba_tube_b'][$key])) {
                $v = $post['carba_tube_b'][$key];
            } elseif (isset($post[$name]) && is_string($post[$name])) {
                $v = $post[$name];
            } elseif ($name === 'carba_np_tube_a' && isset($post['carba_tube_a']) && is_string($post['carba_tube_a'])) {
                $v = $post['carba_tube_a'];
            } elseif ($name === 'carba_np_tube_b' && isset($post['carba_tube_b']) && is_string($post['carba_tube_b'])) {
                $v = $post['carba_tube_b'];
            }
            if ($sub !== null) { $v = (is_array($v) && isset($v[$sub])) ? $v[$sub] : ''; }
            return is_array($v) ? '' : trim((string)$v);
        };
        return bdsis_resistance_plan_core($bdsis, $results, $label, $field);
    }
