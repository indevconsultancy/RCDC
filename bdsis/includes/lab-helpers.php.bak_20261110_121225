if (!function_exists('bdsis_subject_cid_no_column_ensure')) {
    /**
     * Idempotent auto-migration for the cid_no column (2026-10-08). Called
     * from case.php and iu-case.php on page load, so the feature turns on
     * the first time any user opens Case Management after a deploy -- no
     * manual phpMyAdmin step required. Follows the same pattern as
     * bdsis_bact_mic_table_ensure() for the MIC table.
     *
     * Handles the three states a staging DB can be in:
     *   1. Column missing            -> ADD cid_no VARCHAR(50) NULL AFTER subject_id
     *   2. Column exists at < 50     -> MODIFY cid_no VARCHAR(50) NULL
     *   3. Column already at >= 50   -> no-op (true)
     *
     * A failed ALTER (no privilege, locked table, etc.) silently returns
     * false, and the probe stays returning false too -- so the UI stays
     * hidden and no save path throws. Nothing is written and nothing is
     * logged into the response stream.
     *
     * @return bool  true iff a 50-char (or wider) cid_no column now exists
     */
    function bdsis_subject_cid_no_column_ensure($bdsis)
    {
        if (!($bdsis instanceof mysqli)) { return false; }
        $q = @$bdsis->query("SHOW COLUMNS FROM subject_information_table LIKE 'cid_no'");
        $col = ($q && $q->num_rows > 0) ? $q->fetch_assoc() : null;
        if ($q) { $q->free(); }
        if ($col === null) {
            /* State 1: ADD fresh. */
            return (bool)@$bdsis->query("ALTER TABLE subject_information_table ADD COLUMN cid_no VARCHAR(50) NULL AFTER subject_id");
        }
        /* State 2 vs 3: inspect declared width. The Type column reads like
           "varchar(32)" / "varchar(50)" from mysqli, so a simple regex is
           enough and avoids pulling in information_schema. */
        $width = 0;
        if (preg_match('/varchar\((\d+)\)/i', (string)($col['Type'] ?? ''), $m)) { $width = (int)$m[1]; }
        if ($width >= 50) { return true; }   /* State 3 */
        /* State 2: widen in place. Stored values are preserved. */
        return (bool)@$bdsis->query("ALTER TABLE subject_information_table MODIFY COLUMN cid_no VARCHAR(50) NULL");
    }
}
if (!function_exists('bdsis_normalize_cid_no')) {
    /**
     * Normalise a CID No. value: trim, strip anything that isn't A-Z, a-z,
     * or 0-9, cap at 50 characters (widened 2026-10-08 to match the spec'd
     * VARCHAR(50) column), return null when the result is empty. The field
     * is optional and alphanumeric, so this function also serves as the
     * sole input gate -- its return value goes straight into the
     * prepared-statement bind without any further escaping.
     */
    function bdsis_normalize_cid_no($v)
    {
        $v = (is_scalar($v)) ? trim((string)$v) : '';
        if ($v === '') { return null; }
        $v = preg_replace('/[^A-Za-z0-9]/', '', $v);
        if ($v === '') { return null; }
        return mb_substr($v, 0, 50);
    }
}
