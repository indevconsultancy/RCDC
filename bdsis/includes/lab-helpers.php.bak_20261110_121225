    /**
     * Idempotent: adds carba_np_result + carba_np_interpretation columns to
     * bacteriology_resistance_table if they are missing. 2026-10-12 schema.
     * Memoises a TRUE result only, so a failed ALTER (e.g. the DB account
     * doesn't hold ALTER) is retried next request. Mirrors the standalone
     * migration file db-migrations/2026-10-12-carba-np-stored.sql exactly, so
     * applying the SQL manually after this ran is a no-op.
     *
     * Prerequisite: the tube_a / tube_b columns from the 2026-10-05 migration
     * must already be present (the AFTER clause anchors to carba_np_tube_b).
     * When they are not, the ensure returns false and the save/load path
     * falls back to compute-on-display -- the user's data is NEVER lost; it
     * is just not persisted as its own column until both migrations run.
     *
     * @return bool  true iff both result columns are now present on the table
     */
    function bdsis_carba_np_result_columns_ensure($bdsis)
    {
        static $ok = null;
        if ($ok === true) { return true; }
        if (!($bdsis instanceof mysqli)) { return false; }
        $q = @$bdsis->query("SHOW COLUMNS FROM bacteriology_resistance_table LIKE 'carba_np_result'");
        $has = ($q && $q->num_rows > 0);
        if ($q) { $q->free(); }
        if ($has) { $ok = true; return true; }
        if (!function_exists('bdsis_carba_np_columns_exist')
            || !bdsis_carba_np_columns_exist($bdsis)) { return false; }
        $sql = "ALTER TABLE bacteriology_resistance_table "
             . "ADD COLUMN carba_np_result        VARCHAR(32) NULL AFTER carba_np_tube_b, "
             . "ADD COLUMN carba_np_interpretation VARCHAR(64) NULL AFTER carba_np_result";
