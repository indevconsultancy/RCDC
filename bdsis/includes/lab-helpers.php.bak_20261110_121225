if(!function_exists('bdsis_bact_resistance_panels_html')){
    /**
     * The two conditional sub-panels rendered inside a pathogen row's AST
     * panel: ESBL Test and Carbapenemase Test (mCIM, then eCIM). Both
     * start hidden unless the row already holds a saved result; the
     * browser shows them when the routine zones trigger them
     * (bpResistanceSync) and iu-lab.php re-derives the triggers on save.
