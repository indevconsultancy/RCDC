        $q->bind_param("i", $id);
        $q->execute();
        $q->bind_result($name);
        $found = $q->fetch();
        $q->close();
        return ($found && trim((string)$name) !== '') ? trim((string)$name) . ' AST' : 'E.coli AST';
    }
