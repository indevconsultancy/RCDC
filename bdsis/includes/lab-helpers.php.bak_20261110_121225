    /**
     * Interpretation Output -- paired text for the System Result above.
     * Same 4-rule matrix; new display vocabulary (2026-10-07 spec).
     */
    function bdsis_carba_np_interpret($tubeA, $tubeB)
    {
        $r = bdsis_carba_np_result($tubeA, $tubeB);
        if ($r === 'Positive') { return 'Carbapenemase producer'; }
        if ($r === 'Negative') { return 'No carbapenemase detected'; }
        if ($r === 'Invalid')  { return 'Invalid'; }
        return '';
    }
}
