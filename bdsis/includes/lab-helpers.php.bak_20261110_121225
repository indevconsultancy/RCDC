    function bdsis_bact_resistance_panels_html($idx, $resist, $esblAgents)
    {
        $hv = function($v){ return htmlspecialchars((string)$v, ENT_QUOTES); };
        /* $cls: extra classes for the <select> (e.g. the result pill). */
        $sel = function($name, $id, $opts, $cur, $placeholder, $attrs = '', $cls = '') use ($hv) {
