if (!function_exists('bdsis_resistance_report_rows_for')) {
    /**
     * AMR Summary table rows for an already-loaded record (2026-10-08 spec).
     *
     * Replaces the old detailed multi-row ESBL / Carbapenems / mCIM / eCIM
     * breakdown with a single 4-column summary table whose rows read:
     *   Resistance mechanism | Confirmatory test | Key result | Final phenotype
     *
     * The outer table surrounding this fragment carries 8 logical columns, so
     * each of the four summary columns takes colspan=2. A row prints only
     * when the record holds data for that mechanism, so the section stays
     * blank when nothing is triggered or stored.
     *
     * Final-phenotype cell is bold per the spec.
     *
     * @return string
     */
    function bdsis_resistance_report_rows_for($bdsis, $r)
    {
        if ($r === null) { return ''; }
        $h = function ($v) { return htmlspecialchars((string)$v, ENT_QUOTES); };
        $esbl = isset($r['esbl']) ? $r['esbl'] : null;
        $cpe  = isset($r['cpe'])  ? $r['cpe']  : null;
        $ampc = isset($r['ampc']) ? $r['ampc'] : null;
        if ($esbl === null && $cpe === null && $ampc === null) { return ''; }

        $cell = function ($txt, $bold = false) use ($h) {
            $t = trim((string)$txt);
            $t = ($t === '') ? '&ndash;' : $h($t);
            return $bold ? ('<B>' . $t . '</B>') : $t;
        };
        $diffFmt = function ($d) {
            $s = ($d >= 0 ? '+' : '') . rtrim(rtrim(number_format($d, 1, '.', ''), '0'), '.');
            return $s . ' mm';
        };

        $rows = '';

        /* ---- Row 1 -- ESBL ----------------------------------------------- */
        if ($esbl !== null) {
            /* Key result: largest zone diff across the four CTX/CAZ pair sets
               (plain vs +CLA). The combination disc test opens on any one of
               CAZ/CTX/CPD/CRO, so look at every stored pair and surface the
               biggest increase so the reader sees the strongest evidence. */
            $keyRes  = '';
            $maxDiff = null;
            if (isset($esbl['agents']) && is_array($esbl['agents']) && function_exists('bdsis_esbl_agents')) {
                $agents = bdsis_esbl_agents($bdsis);
                foreach ($agents as $code => $ag) {
                    if (!isset($esbl['agents'][$code])) { continue; }
                    $row = $esbl['agents'][$code];
                    if (empty($ag['pair']) || !isset($esbl['agents'][$ag['pair']])) { continue; }
                    $z1 = isset($row['zone']) ? trim((string)$row['zone']) : '';
                    $z2 = isset($esbl['agents'][$ag['pair']]['zone']) ? trim((string)$esbl['agents'][$ag['pair']]['zone']) : '';
                    if ($z1 === '' || $z2 === '' || !is_numeric($z1) || !is_numeric($z2)) { continue; }
                    $d = (float)$z1 - (float)$z2;
                    if ($maxDiff === null || $d > $maxDiff) { $maxDiff = $d; }
                }
            }
            if ($maxDiff !== null) { $keyRes = $diffFmt($maxDiff); }

            /* Final phenotype: human form of the stored ESBL result; "detected"
               wording when the test confirmed the enzyme. */
            $esblResult = isset($esbl['result']) ? trim((string)$esbl['result']) : '';
            if ($esblResult === '')                      { $pheno = 'Incomplete'; }
            elseif (stripos($esblResult, 'posit') !== false || stripos($esblResult, 'detect') !== false)
                                                          { $pheno = 'ESBL detected'; }
            else                                          { $pheno = 'ESBL negative'; }

            $rows .= '<tr>'
                   . '<td colspan=2><label>' . $cell('ESBL') . '</label></td>'
                   . '<td colspan=2><label>' . $cell('CTX/CAZ + clavulanate') . '</label></td>'
                   . '<td colspan=2><label>' . $cell($keyRes) . '</label></td>'
                   . '<td colspan=2><label>' . $cell($pheno, true) . '</label></td>'
                   . '</tr>';
        }

        /* ---- Row 2 -- AmpC ----------------------------------------------- */
        if ($ampc !== null) {
            /* Key result: FEP + R-count summary, so the reader sees the
               screening evidence that drove the inhibitor-test decision.
               Expected shape: "FEP S | R: CTX, CRO, FOX". */
            $keyRes = '';
            if (isset($ampc['agents']) && is_array($ampc['agents'])) {
                $fep = isset($ampc['agents']['FEP']['result']) ? trim((string)$ampc['agents']['FEP']['result']) : '';
                $rCodes = array();
                foreach (array('CTX','CRO','FOX') as $code) {
                    if (isset($ampc['agents'][$code]['result']) && $ampc['agents'][$code]['result'] === 'Resistant') {
                        $rCodes[] = $code;
                    }
                }
                $parts = array();
                if ($fep !== '')         { $parts[] = 'FEP ' . substr($fep, 0, 1); }
                if (count($rCodes) > 0)  { $parts[] = 'R: ' . implode(', ', $rCodes); }
                $keyRes = implode(' | ', $parts);
            }

            $ampcResult = isset($ampc['result']) ? trim((string)$ampc['result']) : '';
            if ($ampcResult === 'AmpC producer')        { $pheno = 'AmpC detected'; }
            elseif ($ampcResult === 'AmpC negative')    { $pheno = 'AmpC negative'; }
            elseif ($ampcResult === '')                 { $pheno = 'Incomplete'; }
            else                                        { $pheno = $ampcResult; }

            $rows .= '<tr>'
                   . '<td colspan=2><label>' . $cell('AmpC') . '</label></td>'
                   . '<td colspan=2><label>' . $cell('AmpC inhibitor test') . '</label></td>'
                   . '<td colspan=2><label>' . $cell($keyRes) . '</label></td>'
                   . '<td colspan=2><label>' . $cell($pheno, true) . '</label></td>'
                   . '</tr>';
        }

        /* ---- Row 3 -- Carbapenemase -------------------------------------- */
        if ($cpe !== null) {
            /* Key result: eCIM-mCIM diff (same calculation the mCIM/eCIM
               Combination Test writes to the UI). When eCIM wasn't run,
               fall back to the mCIM result so the row still carries the
               strongest available evidence. */
            $keyRes  = '';
            $mcimZ   = isset($cpe['mcim_zone']) ? trim((string)$cpe['mcim_zone']) : '';
            $ecimZ   = isset($cpe['ecim_zone']) ? trim((string)$cpe['ecim_zone']) : '';
            $mcimRes = isset($cpe['mcim_result']) ? trim((string)$cpe['mcim_result']) : '';
            if ($ecimZ !== '' && $mcimZ !== '' && is_numeric($ecimZ) && is_numeric($mcimZ)) {
                $keyRes = $diffFmt((float)$ecimZ - (float)$mcimZ) . ' vs mCIM';
            } elseif ($mcimRes !== '') {
                $keyRes = 'mCIM ' . $mcimRes;
            }

            $cpeResult = isset($cpe['result']) ? trim((string)$cpe['result']) : '';
            if (stripos($cpeResult, 'metallo') !== false || stripos($cpeResult, 'MBL') !== false)
                                                                       { $pheno = 'MBL detected'; }
            elseif (stripos($cpeResult, 'serine') !== false)           { $pheno = 'Serine carbapenemase detected'; }
            elseif (stripos($cpeResult, 'not detected') !== false)     { $pheno = 'Carbapenemase not detected'; }
            elseif (stripos($cpeResult, 'producer') !== false)         { $pheno = 'Carbapenemase producer'; }
            elseif (stripos($cpeResult, 'inconclusive') !== false)     { $pheno = 'Testing inconclusive'; }
            elseif ($cpeResult !== '')                                 { $pheno = $cpeResult; }
            else                                                       { $pheno = 'Incomplete'; }

            $rows .= '<tr>'
                   . '<td colspan=2><label>' . $cell('Carbapenemase') . '</label></td>'
                   . '<td colspan=2><label>' . $cell('mCIM + eCIM') . '</label></td>'
                   . '<td colspan=2><label>' . $cell($keyRes) . '</label></td>'
                   . '<td colspan=2><label>' . $cell($pheno, true) . '</label></td>'
                   . '</tr>';
        }

        /* ---- Header + body wrapper rows (sit inside the surrounding 8-col
               AST table so no new <table> is opened). ---------------------- */
        $html  = '<tr><td colspan=8><label><B>AMR Summary:</B></label></td></tr>';
        $html .= '<tr>'
               . '<td colspan=2><label><B>Resistance mechanism</B></label></td>'
               . '<td colspan=2><label><B>Confirmatory test</B></label></td>'
               . '<td colspan=2><label><B>Key result</B></label></td>'
               . '<td colspan=2><label><B>Final phenotype</B></label></td>'
               . '</tr>';
        $html .= $rows;
        return $html;
    }
}

if (!function_exists('bdsis_ecoli_ast_results')) {
    /**
     * What one E. coli AST panel has actually recorded: code => interpretation.
     *
     * This is what the ESBL / carbapenemase triggers read, and it is deliberately
     * the RECORDED interpretation rather than anything re-derived from a number:
     *
     *   Disk Diffusion  the zone read through the same CLSI thresholds the save
     *                   applies, so the trigger and the stored ast_result agree.
     *   MIC             the reader's own S / I / R / SDD / N/A. An MIC value is
     *                   never classified here -- 16 mg/L means nothing without a
     *                   breakpoint for that organism, so only what the reader
     *                   stated counts. SDD and N/A trigger nothing.
     *
     * @param  mysqli $bdsis
     * @param  string $methodId    ms_ast_method_table id posted for the panel
     * @param  string $letter      the panel's suffix in the flat field names (a..l)
     * @param  array  $post        $_POST
     * @param  array  $breakpoints bdsis_ast_breakpoints()
     * @param  array  $micRows     validated rows from bdsis_ecoli_mic_parse()
     * @return array  code => interpretation
     */
    function bdsis_ecoli_ast_results($bdsis, $methodId, $letter, $post, $breakpoints, $micRows = array())
    {
        $out = array();
        $methodId = (string)$methodId;

        if ($methodId === '01') {
            $cntrKey = 'cntr' . $letter;
            $cntr = (isset($post[$cntrKey]) && !is_array($post[$cntrKey])) ? (int)$post[$cntrKey] : 0;
            for ($i = 1; $i <= $cntr; $i++) {
                $cKey = 'code' . $letter . $i;
                $zKey = 'zone' . $letter . $i;
                $code = (isset($post[$cKey]) && !is_array($post[$cKey])) ? strtoupper(trim((string)$post[$cKey])) : '';
                $zone = (isset($post[$zKey]) && !is_array($post[$zKey])) ? $post[$zKey] : '';
                if ($code === '' || !isset($breakpoints[$code])) { continue; }
                $out[$code] = bdsis_ast_interpret_zone($zone, $breakpoints[$code]);
            }
            return $out;
        }

        if ($methodId === bdsis_mic_method_id()) {
            foreach ((array)$micRows as $codeKey => $row) {
                if (!is_array($row)) { continue; }
                /* Accept both the new code-indexed format from bdsis_bact_mic_parse_post()
                   (code => array('value','result')) and the old free-list format from
                   bdsis_ecoli_mic_parse() (list rows with 'code' key). */
                if (isset($row['code'])) {
                    /* Old free-list format. */
                    $c = strtoupper((string)$row['code']);
                    $out[$c] = isset($row['result']) ? (string)$row['result'] : '';
                } else {
                    /* New code-indexed format (string key is the antibiotic code). */
                    $c = strtoupper((string)$codeKey);
                    $out[$c] = isset($row['result']) ? (string)$row['result'] : '';
                }
            }
        }
        return $out;
    }
}

if (!function_exists('bdsis_ecoli_panel_label')) {
