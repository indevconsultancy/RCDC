if (!function_exists('bdsis_normalize_date')) {
    /**
     * Normalise a posted date to the YYYY-MM-DD that MySQL DATE columns expect.
     *
     * Every date field in the app is now a native <input type="date">, which
     * always submits YYYY-MM-DD, so in normal use this is a pass-through. It
     * exists because the previous jQuery UI picker submitted dd-mm-yyyy and the
     * save handlers interpolated that straight into DATE columns -- MySQL cannot
     * parse it and silently stored 0000-00-00. Twenty-four values across the
     * subject, clinical, sample and bacteriology tables were lost that way,
     * including the hospital visit date on the four most recent cases.
     *
     * Returns null for an empty or unparseable value so callers store a real
     * NULL rather than the zero date, which sorts and filters as a valid day.
     *
     * @param  string|null $value
     * @return string|null YYYY-MM-DD, or null
     */
    function bdsis_normalize_date($value)
    {
        if ($value === null) { return null; }
        $value = trim((string) $value);
        if ($value === '' || $value === '0000-00-00') { return null; }

        // Already the storage format.
        if (preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $value, $m)) {
            return checkdate((int) $m[2], (int) $m[3], (int) $m[1]) ? $value : null;
        }

        // Legacy picker output and common hand-typed forms: d-m-Y and d/m/Y.
        // Day-first, not month-first: the old picker was configured dd-mm-yy and
        // the users are in Bhutan, so 03-04-2026 means 3 April.
        if (preg_match('/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})$/', $value, $m)) {
            $d = (int) $m[1]; $mo = (int) $m[2]; $y = (int) $m[3];
            return checkdate($mo, $d, $y) ? sprintf('%04d-%02d-%02d', $y, $mo, $d) : null;
        }

        $ts = strtotime($value);
        return $ts === false ? null : date('Y-m-d', $ts);
    }
}

/* ===========================================================================
   Conditional ESBL / Carbapenemase (mCIM, eCIM) testing -- Bacteriology AST.
   ---------------------------------------------------------------------------
   The routine disk-diffusion panel decides whether a confirmatory test is
   required for an isolate:
     ESBL test        any of CAZ / CTX / CPD / CRO Resistant
     mCIM             any of IMI / EPT / MER Resistant or Intermediate
   The triggers are re-derived server side from the posted zones on every save
   (lab/iu-lab.php), using the very breakpoints the AST loop applies, and the
   FINAL interpretations are stored (bacteriology_resistance_table) so reports
   print what was signed off rather than recomputing it.
   Tables: sql/2026-09-08_esbl_carbapenemase.sql.
   =========================================================================== */

if (!function_exists('bdsis_bact_trigger_codes')) {
    /**
     * Routine-panel agents (ms_ast_table.code, method 01) that trigger a test.
