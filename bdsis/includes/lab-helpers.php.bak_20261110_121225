            . '<div class="col-md-8 lr-cell lr-cell--name"><span class="lr-agent">Final ESBL Status <span class="required-star" aria-hidden="true">*</span></span></div>'
            . '<div class="col-md-4 lr-cell"><label class="lr-cell-label" for="bpEsblResult'.$idx.'">Final ESBL Status:</label>'
            . $sel('esbl_result['.$idx.']', 'bpEsblResult'.$idx, bdsis_esbl_interpretations(), ($e ? $e['result'] : ''), 'Select Interpretation', 'required title="'.$hv($esblRule).'"', 'lr-pill-select').'</div></div>';
