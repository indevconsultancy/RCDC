if (!function_exists('bdsis_restricted_proby_options_html')) {
    /**
     * Render the <option> list for the restricted Processed by dropdown.
     *
     * Outputs:
     * - Default placeholder: <option value="">Select Staff</option>
     * - The 6 standard staff names from bdsis_restricted_proby_names()
     * - If $selected is provided and matches one of the 6 names (either exact or
     *   via username resolution from user_profile_table), that option carries `selected`.
     * - If $selected is a legacy name/username outside the 6 names, an extra option
     *   is rendered with `selected` so historical records retain their selection.
     *
     * @param  string|null $selected Current saved value (full name or username)
     * @param  mysqli|null $commondb Common DB connection for username resolution
     * @return string
     */
    function bdsis_restricted_proby_options_html($selected = '', $commondb = null)
    {
        $selected = ($selected !== null) ? trim((string)$selected) : '';
        $resolvedLabel = '';
        if ($selected !== '') {
            $resolvedLabel = bdsis_processed_by_label($selected, $commondb);
            if ($resolvedLabel === '' || $resolvedLabel === null) {
                $resolvedLabel = $selected;
            }
        }

        $names = bdsis_restricted_proby_names();
        $matched = false;
        $optionsHtml = '';

        foreach ($names as $n) {
            $isSelected = false;
            if ($selected !== '') {
                if (strcasecmp($n, $selected) === 0 || strcasecmp($n, $resolvedLabel) === 0) {
                    $isSelected = true;
                    $matched = true;
                }
            }
            $h = htmlspecialchars($n, ENT_QUOTES);
            $optionsHtml .= '<option value="' . $h . '"' . ($isSelected ? ' selected' : '') . '>' . $h . '</option>';
        }

        $out = '<option value=""' . ((!$matched && $selected === '') ? ' selected' : '') . '>Select Staff</option>';

        // If a non-empty saved value didn't match any of the 6 names, preserve it as a selected option
        if ($selected !== '' && !$matched) {
            $valH = htmlspecialchars($selected, ENT_QUOTES);
            $lblH = htmlspecialchars($resolvedLabel, ENT_QUOTES);
            $out .= '<option value="' . $valH . '" selected>' . $lblH . '</option>';
        }

        $out .= $optionsHtml;
        return $out;
    }
}

