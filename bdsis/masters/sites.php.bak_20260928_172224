/* Sites / Health Centers live in commondb.ms_health_center_table and are
   shared by every sibling RCDC surveillance system. BDSIS lets an Administrator
   edit the BDSIS-relevant fields (name, dzongkhag, active status, dsis
   participation) and soft-retire a centre; a hard delete would orphan
   subject_information_table FKs across every sibling app, so it is not
   offered. Non-admin roles see the table read-only.

   Editable columns:
     center_name       display label everywhere
     dzongkhag_code    district scoping in every system
     status            0 hides the centre from active pick lists everywhere
     dsis              BDSIS participation only (this system's chooser + reports)

   NOT editable here (kept in the shared administration portal):
     center_id         primary key, referenced as FK by every sibling app
     center_code       subject-id prefix in BDSIS ("<code>-<yy>-<seq>"); a
                       rename here would silently split a centre's history */

$canWrite  = bdsis_masters_can_write('sites');
$canDelete = bdsis_masters_can_delete('sites');

/* All dzongkhags for the edit form dropdown. */
$dzOptions = array();
$dz = $commondb->query("SELECT dzongkhag_code, dzongkhag_name FROM ms_dzongkhag_table ORDER BY dzongkhag_name");
if ($dz) { while (list($dc, $dn) = $dz->fetch_row()) { $dzOptions[(string)$dc] = (string)$dn; } $dz->free(); }

/* Edit-mode: ?edit=<center_id>. Only meaningful for admins. */
$editCid = ($canWrite && isset($_GET['edit'])) ? (string)$_GET['edit'] : '';
$editRow = null;
if ($editCid !== '') {
    $q = $commondb->prepare("SELECT center_id, center_code, center_name, dzongkhag_code, status, dsis
                               FROM ms_health_center_table WHERE center_id=?");
    if ($q) {
        $q->bind_param("s", $editCid); $q->execute();
        $q->bind_result($ec, $ecode, $ename, $edzc, $est, $edsis);
        if ($q->fetch()) {
            $editRow = array('cid'=>(string)$ec,'ccode'=>(string)$ecode,'cname'=>(string)$ename,
                             'dzc'=>(string)$edzc,'status'=>(int)$est,'dsis'=>(int)$edsis);
        }
        $q->close();
    }
    if (!$editRow) { $editCid = ''; }
}
$isEdit = ($editRow !== null);

$rows = array();
$sql  = "SELECT h.center_id, h.center_code, h.center_name, h.dzongkhag_code, d.dzongkhag_name, h.status, h.dsis
           FROM ms_health_center_table h
           LEFT JOIN ms_dzongkhag_table d ON d.dzongkhag_code = h.dzongkhag_code
          ORDER BY h.center_name";
$res = $commondb->query($sql);
if ($res) {
    while (list($cid, $ccode, $cname, $dzc, $dzn, $st, $dsis) = $res->fetch_row()) {
        $rows[] = array(
            'cid'=>(string)$cid, 'ccode'=>(string)$ccode, 'cname'=>(string)$cname,
            'dzc'=>(string)$dzc, 'dzn'=>(string)$dzn,
            'status'=>(int)$st, 'dsis'=>(int)$dsis,
        );
    }
    $res->free();
}

/* BDSIS-side reference count per centre: how many subjects each site owns.
   Used to explain why a soft-retire matters and to gate the retire action
   on cross-app-safe grounds. */
$bdsisRefs = array();
foreach ($rows as $r) {
    $q = $bdsis->prepare("SELECT COUNT(*) FROM subject_information_table WHERE center_id=?");
    if ($q) {
        $cid = $r['cid'];
        $q->bind_param("s", $cid); $q->execute();
        $q->bind_result($n); $q->fetch(); $q->close();
        $bdsisRefs[$r['cid']] = (int)$n;
    }
}
