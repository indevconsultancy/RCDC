<?php
/* Sites / Health Centers live in commondb.ms_health_center_table and are
   shared by every sibling RCDC surveillance system. BDSIS shows them here
   read-only for reference. The one BDSIS-scoped write is the `dsis` flag --
   it decides only whether a site is offered in the case chooser and BDSIS
   reports, so toggling it does not affect any other system. Every other edit
   (add site, rename, change dzongkhag or status) belongs in the shared
   administration portal (COMMONNEW). */

$rows = array();
$sql = "SELECT h.center_id, h.center_code, h.center_name, h.dzongkhag_code, d.dzongkhag_name, h.status, h.dsis
          FROM ms_health_center_table h
          LEFT JOIN ms_dzongkhag_table d ON d.dzongkhag_code = h.dzongkhag_code
         ORDER BY h.center_name";
$res = $commondb->query($sql);
if ($res) {
    while (list($cid, $ccode, $cname, $dzc, $dzn, $st, $dsis) = $res->fetch_row()) {
        $rows[] = array(
            'cid'=>(string)$cid, 'ccode'=>(string)$ccode, 'cname'=>(string)$cname,
            'dzc'=>(string)$dzc, 'dzn'=>(string)$dzn,
            'status'=>(int)$st, 'dsis'=>(int)$dsis,
        );
    }
    $res->free();
}
