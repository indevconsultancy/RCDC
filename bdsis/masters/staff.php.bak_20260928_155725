/* Processing / Processed By listing. Not a master in the current design:
   `Processed by` was moved to a free-text field by the 2026-07-21
   `processed-by-freetext` migration (see bdsis_processed_by_label() and the
   free-text note in lab-helpers.php). The E. coli AST staff picker still
   backs onto commondb.user_profile_table filtered by the same acl/usercat
   criteria the AST form uses; that filtered set is what this page shows,
   read-only. Adds and edits belong in the shared user administration portal
   (COMMONNEW), because a single username can be granted access to any subset
   of the 10 sibling systems and BDSIS is not authoritative for it. */

$sql = "SELECT up.username, up.fullname, up.center_id, IFNULL(hc.center_name, ''), usa.access_level, usa.user_category
          FROM user_profile_table up
          JOIN user_system_access_table usa ON usa.username = up.username
          LEFT JOIN ms_health_center_table hc ON hc.center_id = up.center_id
         WHERE usa.system_id = 6
           AND usa.access_level IN (2, 3)
           AND usa.user_category IN (3, 13)
         ORDER BY up.fullname";
$rows = array();
$res = $commondb->query($sql);
if ($res) {
    while (list($un, $fn, $cid, $cn, $acl, $uc) = $res->fetch_row()) {
        $rows[] = array('un'=>(string)$un, 'fn'=>(string)$fn, 'cid'=>(string)$cid, 'cn'=>(string)$cn, 'acl'=>(string)$acl, 'uc'=>(string)$uc);
    }
    $res->free();
}
