    <div class="chart-card" style="--chart-accent:var(--nt-primary)">
      <div class="chart-card__head">
        <h3 class="chart-card__title">Samples by Sentinel Site</h3>
        <p class="chart-card__sub">Target is at least 100 samples per site per year (about 9 per month)</p>
      </div>
      <div class="chart-card__body"><div id="siteChart" style="height:360px;"></div></div>
    </div>
  </div>
</div>

<script type="text/javascript">
$(function () {
  var months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  /* ---------- Per-chart Year filter, exposed via each chart's export menu.
     Every chart already carries the default Highcharts context menu (Fullscreen,
     Print, Download, View Data). We APPEND a "View year <YYYY>" entry per year
     the surveillance dataset knows about. Clicking one re-uses the existing top-
     level toolbar filter -- it sets the same #col_year <select> and submits its
     form, so the dashboard reloads server-side with the chosen year and every
     KPI, table and chart re-renders from a single, canonical source of truth
     (chart.php's own PHP queries).

     Nothing else about the export menu changes: the standard items stay in the
     standard order, we only add a separator + the year list after them. If the
     user picks the year already being viewed we no-op so a click on the current
     year does not trigger a needless full-page reload. */
  var mdYearDefs = {};
  var mdYearKeys = [];
<?php foreach ($years as $y): $key = 'mdYear_' . (int)$y; ?>
  mdYearDefs['<?= $key ?>'] = {
    text: 'View year <?= (int)$y ?><?= $y == $year ? " • current" : "" ?>',
    onclick: function () {
      var sel = document.getElementById('col_year');
      if (!sel) { return; }
      if (parseInt(sel.value, 10) === <?= (int)$y ?>) { return; }   /* already viewing this year */
      sel.value = '<?= (int)$y ?>';
      if (sel.form) { sel.form.submit(); }
    }
  };
  mdYearKeys.push('<?= $key ?>');
<?php endforeach; ?>

  var exp = {
    scale: 3,
    fallbackToExportServer: false,
    menuItemDefinitions: mdYearDefs,
    buttons: {
      contextButton: {
        menuItems: [
          'viewFullscreen', 'printChart', 'separator',
          'downloadPNG', 'downloadJPEG', 'downloadPDF', 'downloadSVG', 'separator',
          'downloadCSV', 'downloadXLS', 'viewData',
          'separator'
        ].concat(mdYearKeys)
      }
    }
  };

  /* Shared chart styling. Typography, axis and tooltip treatment only -- no
     series, categories or values are touched here, so every figure still comes
     from the queries above. Each chart's own options are merged over this. */
  Highcharts.setOptions({
    chart: {
      backgroundColor: 'transparent',
      style: { fontFamily: "'Source Sans Pro', -apple-system, 'Segoe UI', Roboto, sans-serif" },
      spacing: [8, 8, 8, 8]
    },
    title: { style: { fontSize: '14px', fontWeight: '700', color: '#1e293b' } },
    xAxis: {
      lineColor: '#e2e8f0', tickColor: '#e2e8f0',
      labels: { style: { color: '#64748b', fontSize: '11px' } },
      title: { style: { color: '#64748b', fontSize: '11px', fontWeight: '600' } }
    },
    yAxis: {
      gridLineColor: '#eef2f7', gridLineDashStyle: 'Dot',
      labels: { style: { color: '#64748b', fontSize: '11px' } },
      title: { style: { color: '#64748b', fontSize: '11px', fontWeight: '600' } }
    },
    legend: {
      itemStyle: { color: '#475569', fontWeight: '600', fontSize: '11px' },
      itemHoverStyle: { color: '#0f172a' }
    },
    tooltip: {
      backgroundColor: 'rgba(15,23,42,.92)', borderWidth: 0, borderRadius: 8,
      style: { color: '#fff', fontSize: '12px' }, shadow: false
    },
    plotOptions: {
      series: {
        borderWidth: 0,
        dataLabels: { style: { fontSize: '10px', fontWeight: '600', textOutline: 'none', color: '#475569' } }
      }
    },
    credits: { enabled: false }
  });

  Highcharts.chart('trendChart', {
    chart:{ type:'line', zoomType:'x' }, credits:{enabled:false}, title:{text:null}, exporting:exp,
    xAxis:{ categories:months }, yAxis:{ min:0, title:{text:'Diarrhoea cases'}, allowDecimals:false,
      plotLines:[{ value:<?=$threshold?>, color:'#dc3545', dashStyle:'Dash', width:1,
        label:{ text:'Outbreak threshold (mean + 2 SD = <?=$threshold?>)', style:{fontSize:'9px', color:'#dc3545'} } }] },
    tooltip:{ shared:true, valueSuffix:' cases' },
    series:[
      { name:'<?=$year?>', data:<?=$trendThis?>, color:'#17a2b8', lineWidth:3, marker:{enabled:true} },
      { name:'<?=$prev?>', data:<?=$trendPrev?>, color:'#adb5bd', dashStyle:'ShortDash' },
      { name:'Above threshold', type:'scatter', data:<?=$outbreakJ?>, color:'#dc3545',
        marker:{ symbol:'circle', radius:6 }, tooltip:{ pointFormat:'<b>{point.y} cases</b> (elevated)' } }
    ]
  });

  Highcharts.chart('prevalenceChart', {
    chart:{ type:'bar' }, credits:{enabled:false}, title:{text:null}, exporting:exp,
    xAxis:{ categories:<?=$prevCatJ?>, labels:{style:{fontSize:'11px'}} },
    yAxis:{ min:0, title:{text:'Isolates'}, allowDecimals:false },
    legend:{enabled:false}, tooltip:{ valueSuffix:' isolates' },
    plotOptions:{ bar:{ dataLabels:{enabled:true} } },
    series:[{ name:'Isolates', data:<?=$prevValJ?>, color:'#dc3545' }]
  });

  Highcharts.chart('methodChart', {
    chart:{ type:'column' }, credits:{enabled:false}, title:{text:null}, exporting:exp,
    xAxis:{ categories:<?=json_encode($methCat)?> },
    yAxis:{ min:0, title:{text:'Subjects'}, allowDecimals:false },
    tooltip:{ shared:true, valueSuffix:' subjects' },
    plotOptions:{ column:{ dataLabels:{enabled:true} } },
    series:[
      { name:'Tested', data:<?=$methTestedJ?>, color:'#adb5bd' },
      { name:'Positive', data:<?=$methPosJ?>, color:'#6f42c1' }
    ]
  });

  Highcharts.chart('segChart', {
    chart:{ type:'bar' }, credits:{enabled:false}, title:{text:null}, exporting:exp,
    xAxis:{ categories:<?=$segCatsJ?>, labels:{style:{fontSize:'10px'}} },
    yAxis:{ min:0, title:{text:'Cases / isolates'}, allowDecimals:false, stackLabels:{enabled:false} },
    tooltip:{ valueSuffix:' detections' },
    plotOptions:{ series:{ stacking:'normal' } },
    series:[
      { name:'Bacterial (Culture)', data:<?=$segBactJ?>, color:'#dc3545' },
      { name:'Viral / Antigen (ELISA)', data:<?=$segElisaJ?>, color:'#17a2b8' },
      { name:'E. coli pathotype (PCR)', data:<?=$segPcrJ?>, color:'#f39c12' }
    ]
  });

  Highcharts.chart('geoChart', {
    chart:{ type:'bar' }, credits:{enabled:false}, title:{text:null}, exporting:exp,
    xAxis:{ categories:<?=$geoCatJ?>, labels:{style:{fontSize:'10px'}} },
    yAxis:{ min:0, title:{text:'Cases'}, allowDecimals:false },
    legend:{enabled:false}, tooltip:{ valueSuffix:' cases' },
    plotOptions:{ bar:{ dataLabels:{enabled:true}, color:'#28a745' } },
    series:[{ name:'Cases', data:<?=$geoValJ?> }]
  });

  Highcharts.chart('ageSexChart', {
    chart:{ type:'column' }, credits:{enabled:false}, title:{text:null}, exporting:exp,
    xAxis:{ categories:<?=$ageGroupsJ?>, title:{text:'Age group (years)'} },
    yAxis:{ min:0, title:{text:'Cases'}, allowDecimals:false, stackLabels:{enabled:true} },
    tooltip:{ shared:true, valueSuffix:' cases' },
    plotOptions:{ column:{ stacking:'normal' } },
    series:[ { name:'Male', data:<?=$ageMJ?>, color:'#3c8dbc' }, { name:'Female', data:<?=$ageFJ?>, color:'#d81b60' } ]
  });

  Highcharts.chart('yoyChart', {
    chart:{ type:'column' }, credits:{enabled:false}, title:{text:null}, exporting:exp,
    xAxis:{ categories:<?=$yoyCatJ?> }, yAxis:{ min:0, title:{text:'Diarrhoea cases'}, allowDecimals:false },
    legend:{enabled:false}, tooltip:{ valueSuffix:' cases' },
    plotOptions:{ column:{ dataLabels:{enabled:true} } },
    series:[{ name:'Cases', data:<?=$yoyDataJ?> }]
  });

  Highcharts.chart('seasonChart', {
    chart:{ type:'areaspline' }, credits:{enabled:false}, title:{text:null}, exporting:exp,
    xAxis:{ categories:months }, yAxis:{ min:0, title:{text:'Avg cases / month'} },
    legend:{enabled:false}, tooltip:{ valueSuffix:' cases (avg)' },
    plotOptions:{ areaspline:{ fillOpacity:0.3, color:'#f39c12' } },
    series:[{ name:'Avg cases', data:<?=$seasJ?> }]
  });

  Highcharts.chart('amrChart', {
    chart:{ type:'bar' }, credits:{enabled:false}, title:{text:null}, exporting:exp,
    xAxis:{ categories:<?=$amrCatJ?>, labels:{style:{fontSize:'11px'}} },
    yAxis:{ min:0, title:{text:'No. of isolates tested'}, allowDecimals:false, reversedStacks:false },
    tooltip:{ shared:true },
    plotOptions:{ series:{ stacking:'normal' } },
    series:[
      { name:'Resistant', data:<?=$amrRJ?>, color:'#dc3545' },
      { name:'Intermediate', data:<?=$amrIJ?>, color:'#f39c12' },
      { name:'Susceptible', data:<?=$amrSJ?>, color:'#28a745' }
    ]
  });

  Highcharts.chart('siteChart', {
    chart:{ type:'column' }, credits:{enabled:false}, title:{text:null}, exporting:exp,
    xAxis:{ categories:<?=$siteNamesJ?>, crosshair:true, title:{text:'Sentinel Sites'}, labels:{style:{fontSize:'10px'}} },
    yAxis:{ min:0, title:{text:'Samples'}, allowDecimals:false,
      plotLines:[{ value:100, color:'#28a745', dashStyle:'Dash', width:1, label:{text:'Annual target (100)', style:{fontSize:'9px'}} }] },
    tooltip:{ shared:true, valueSuffix:' samples' }, legend:{ itemStyle:{fontSize:'10px'} },
    plotOptions:{ column:{ stacking:'normal' } },
    series:<?=$siteSeriesJ?>
  });
});
</script>
