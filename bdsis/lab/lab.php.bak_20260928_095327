            if($stsname[1]=="NR"){$stsValue2="Not Required";} else if($stsname[1]=="R"){$stsValue2="Required"; $dispbypon2="";} else{$stsname[1]="NR"; $stsValue2="Not Required"; $dispbypon2="disabled";}
        }else{
            $stsname[1]="NR"; $stsValue2="Not Required";$dispbypon2="disabled";
        }
    
    
        
        if(isset($pathid[2])){
            if($pathid[2]=="" OR $pathid[2]=="025" OR $pathid[2]=="026" OR $pathid[2]=="101" OR $stsname[2]=="NR"){$displayast3="style='display:none;'";} else{$displayast3="style='display:block;'";}
            if($pathid[2]!="NR"){
                // $rid=$sid."_P3";
                $logQry3 = $bdsis->query("SELECT processed_by,processed_on FROM bacteriology_result_table2 WHERE subject_id='".$sid."' AND e_pathogen='P3'");
                list($pby3,$pon3)=$logQry3->fetch_row();
                $processQry3 = $commondb->query("SELECT fullname FROM user_profile_table WHERE username='".$pby3."'");
                list($pbyname3)=$processQry3->fetch_row();
                $dispbypon3="";
            }
        }
        else{$pby3='';$pbyname3='Select'; $pon3=''; $dispbypon3="disabled"; $displayast3="style='display:none;'";}

        /* if(isset($pathid[2]) AND $pathid[2]!=""){$pvalue3 = $pathid[2]; $pname3 = $pathname[2]; } else {$pvalue3 = "NR"; $pname3 = "Not Required";}
        if(isset($stsname[2])){
            if($stsname[2]=="NR"){$stsValue3 = "Not Required";} else if($stsname[2]=="R"){$stsValue3 = "Required";} else{$stsValue3 = "Select Status";}
        }else{
            $stsname[2]=''; $stsValue3 = "Select Status";
        } */

        if(isset($pathid[2]) AND $pathid[2]!=""){ $pvalue3 = $pathid[2]; $pname3 = $pathname[2];} else {$pvalue3 = "NR"; $pname3 = "Not Required";}
        if(isset($stsname[2])){ 
            if($stsname[2]=="NR"){$stsValue3="Not Required"; $dispbypon3="";} else if($stsname[2]=="R"){$stsValue3="Required";} else{$stsname[2]="NR"; $stsValue3="Not Required"; $dispbypon3="disabled";}
        }else{
            $stsname[2]="NR"; $stsValue3="Not Required"; $dispbypon3="disabled";
        }
        
        /* ------------------------------------------------------------------
           Dynamic Enteric Pathogen rows.

           The form used to expose exactly three fixed pathogen slots. It now
           renders one row per pathogen already recorded for the subject (or a
           single blank row when there is none) plus a "+ Add Pathogen" button
           that clones the hidden <template> below. Field names are arrays
           indexed by row: pathogen[i], status[i], proby[i], prodate[i],
           recid[i] and code[i][j] / zone[i][j] for the AST list.
           ------------------------------------------------------------------ */
        /* Pathogens that may no longer be CHOSEN, but must still display on records
           that already carry them. Empty for now -- NLF E.coli ('026') was previously
           retired here but has been reinstated so it appears in the pick list again.
           The retirement mechanism (third element of $pathogenOptList + the skip in
           bdsis_bact_pathogen_block()) is kept intact so a future retirement is a
           one-line change. */
        $bpRetiredPathogens = array();

        $pathogenOptList = array();
        $poQry = $bdsis->query($pathogenList);
        while(list($poId,$poName)=$poQry->fetch_row()){
            /* Third element flags a retired pathogen: kept in the list so the block
               builder can still render it when it is the saved value, but skipped
               when offering choices. Carrying the flag here means the builder needs
               no database handle of its own. */
            $pathogenOptList[] = array($poId, $poName, in_array((string)$poId, $bpRetiredPathogens, true));
        }

        $bactRows = array();
        /* CAST the numeric part so that P10 sorts after P9 instead of after P1. */
        $bactRowQry = $bdsis->query("SELECT record_id, pathogen_id, ast_status, processed_by, processed_on FROM bacteriology_result_table2 WHERE subject_id='".$bdsis->real_escape_string($sid)."' ORDER BY CAST(SUBSTRING(e_pathogen,2) AS UNSIGNED) ASC, record_id ASC");
        if($bactRowQry){
            while(list($brRecId,$brPathId,$brSts,$brPby,$brPon)=$bactRowQry->fetch_row()){
                $bactRows[] = array('recid'=>$brRecId, 'pathogen'=>$brPathId, 'status'=>$brSts, 'proby'=>$brPby, 'prodate'=>$brPon);
            }
        }
        if(count($bactRows)==0){
            $bactRows[] = array('recid'=>'', 'pathogen'=>'', 'status'=>'', 'proby'=>'', 'prodate'=>'');
        }

        if(!function_exists('bdsis_bact_ast_rows')){
            /**
             * AST antimicrobial list for one pathogen row. Returns the stored
             * zone diameters/results when the row already has them, otherwise a
             * blank list built from ms_ast_table.
             */
            function bdsis_bact_ast_rows($bdsis, $recid, $pathogenId)
            {
                /* Each row also carries that antibiotic's CLSI breakpoints so the form can
                   interpret a typed zone immediately, using the same thresholds iu-lab.php
                   applies on save. */
                $blank = "SELECT code,antimicrobial_agent,'','',susceptible,intermediate1,intermediate2,resistance FROM ms_ast_table WHERE ast_method_id='01' AND status='1' ORDER BY antimicrobial_agent ASC";
                $recid = (string)$recid;
                $pathogenId = (string)$pathogenId;

                /* Stored readings for this isolate, keyed by antimicrobial code. */
                $stored = array();
                if($recid!=="" AND $pathogenId!=="" AND $pathogenId!=="025" AND $pathogenId!=="026" AND $pathogenId!=="101"){
                    $sq = $bdsis->query("SELECT bat.antimicrobial_code,bat.zone_diameter,bat.ast_result FROM bacteriology_ast_table bat, ms_ast_table mat WHERE bat.antimicrobial_code=mat.code AND bat.brt2_id='".$bdsis->real_escape_string($recid)."' AND mat.ast_method_id='01' AND mat.status=1");
                    if($sq){
                        while(list($sCode,$sZone,$sRslt)=$sq->fetch_row()){
                            $stored[(string)$sCode] = array('zone'=>$sZone, 'rslt'=>$sRslt);
                        }
                        $sq->free();
                    }
                }

                /* The ACTIVE master list drives the panel, for a saved isolate as well
                   as a new one. It used to be driven by the isolate's own stored rows,
                   so an antimicrobial added to the master after the record was created
                   never appeared on it again -- which is why the ESBL and carbapenemase
                   triggers could not fire on existing records: CAZ, CTX, CPD, IMI, EPT
                   and MER were simply absent from the form. Only Ceftriaxone, already
                   stored historically, could ever trigger.

                   An agent with no stored reading on a saved isolate defaults to -99,
                   the sentinel this form already uses for "not tested": the save path
                   deletes -99 rows, so re-saving an old record writes nothing new and
                   changes nothing, while the agent is now there to be entered. A brand
                   new isolate still starts blank, exactly as before. */
                $isSaved = (count($stored) > 0);
                $rows = array();
                $qry = $bdsis->query($blank);
                while(list($code,$agent,$zone,$rslt,$sus,$int1,$int2,$res)=$qry->fetch_row()){
                    $code = (string)$code;
                    if(isset($stored[$code])){
                        $zone = $stored[$code]['zone'];
                        $rslt = $stored[$code]['rslt'];
                    }elseif($isSaved){
                        $zone = '-99';
                        $rslt = '';
                    }
                    $rows[] = array('code'=>$code, 'agent'=>$agent, 'zone'=>$zone, 'rslt'=>$rslt,
                                    'sus'=>$sus, 'int1'=>$int1, 'int2'=>$int2, 'res'=>$res);
                }
                return $rows;
            }
        }

        if(!function_exists('bdsis_bact_pathogen_block')){
            /**
             * Render one pathogen row (header fields + AST panel). Pass
             * '__IDX__' as $idx to build the client-side clone template.
             */
            function bdsis_bact_pathogen_block($idx, $row, $astRows, $pathogenOptList, $commondb, $resist = null, $esblAgents = array(), $locked = false)
            {
                $pid     = (string)(isset($row['pathogen']) ? $row['pathogen'] : '');
                $sts     = (string)(isset($row['status'])   ? $row['status']   : '');
                $recid   = (string)(isset($row['recid'])    ? $row['recid']    : '');
                $prodate = (string)(isset($row['prodate'])  ? $row['prodate']  : '');
                $proby   = bdsis_processed_by_label(isset($row['proby']) ? $row['proby'] : '', $commondb);

                /* 025/026/101 never carry an AST panel, neither does an unset or "Not Required" status. */
                $hide = ($pid==="" OR $pid==="025" OR $pid==="026" OR $pid==="101" OR $sts==="" OR $sts==="NR");
                $astStyle = $hide ? "display:none;" : "display:block;";

                /* A retired pathogen (e.g. NLF E.coli) is not offered for a new isolate,
                   but is still rendered when it is this row's saved value -- 793 rows across
                   791 subjects hold it. Omitting it would leave the select with nothing
                   selected and the next save would write whichever option came first. */
                $opts = '<option value="">Select Enteric Pathogen</option>';
                foreach($pathogenOptList as $opt){
                    $isSel   = ($pid!=="" AND (string)$opt[0]===$pid);
                    $retired = !empty($opt[2]);
                    if($retired AND !$isSel){ continue; }
                    $label = htmlspecialchars($opt[1], ENT_QUOTES) . ($retired ? ' (recorded earlier)' : '');
                    $opts .= '<option value="'.htmlspecialchars($opt[0], ENT_QUOTES).'"'.($isSel?' selected':'').'>'.$label.'</option>';
                }

                /* Presentation (lab-results.css): the block is a card -- header bar,
                   a row of the four pathogen fields, then the AST sub-cards. Names,
                   ids and handlers are unchanged. */
                $h  = '<div class="pathogen-block lr-card" id="bpBlock'.$idx.'" data-bpidx="'.$idx.'"'.($locked ? ' data-locked="1"' : '').'>';
                /* The Remove button is a SIBLING of the heading, never inside it.
                   A <button> is a labelable control, so while it sat inside a
                   <label> a click anywhere on the heading text was forwarded to it
                   and removed the row -- even on Enteric Pathogen 1, whose button
                   renumberPathogenRows() hides, because label activation ignores
                   visibility. The heading is no longer a <label> at all. */
                $h .= '<div class="lr-card__head">';
                $h .= '<div class="lr-card__title"><span class="lr-card__index"><i class="fas fa-bacterium" aria-hidden="true"></i></span>'
                    . '<span>Enteric Pathogen <span class="bp-seq">1</span></span></div>';
                $h .= '<button type="button" class="btn btn-sm lr-btn-danger-soft bp-remove" onclick="removePathogenRow(this, event);"><i class="fas fa-trash-alt" aria-hidden="true"></i>&nbsp;Remove</button>';
                $h .= '</div>';
                $h .= '<div class="row lr-fields">';
                $h .= '<input type="hidden" name="recid['.$idx.']" value="'.htmlspecialchars($recid, ENT_QUOTES).'" />';

                $h .= '<div class="form-group col-md-6 col-xl-3">';
                $h .= '<label class="col-form-label-sm" for="bpPathogen'.$idx.'">Enteric Pathogen:</label>';
                $h .= '<select class="form-control" name="pathogen['.$idx.']" id="bpPathogen'.$idx.'" required onchange="displayASTRow(\''.$idx.'\');">'.$opts.'</select>';
                $h .= '</div>';

                /* AST option set is context sensitive and is chosen from the SAVED
                   pathogen so edit/view opens correct before any JS runs:
                     025/026 (E.coli) -> Select Result / Positive / Negative, enabled.
                                         'Positive' means the E.coli PCR Result
                                         section applies to this isolate.
                     101              -> forced "Not Required", disabled (as before).
                     anything else    -> Select Status / Required / Not Required. */
                $isEcoliRow = ($pid==="025" OR $pid==="026");
                $lockNR     = ($pid==="101");
                $h .= '<div class="form-group col-md-6 col-xl-3">';
                $h .= '<label class="col-form-label-sm" for="bpStatus'.$idx.'">AST:</label>';
                $h .= '<select class="form-control" name="status['.$idx.']" id="bpStatus'.$idx.'" required'.($lockNR?' disabled':'').' onchange="displayASTRow(\''.$idx.'\');">';
                if($isEcoliRow){
                    $h .= '<option value=""'.((($sts!=="Positive") AND ($sts!=="Negative")) ? ' selected' : '').'>Select Result</option>';
                    $h .= '<option value="Positive"'.($sts==="Positive"?' selected':'').'>Positive</option>';
                    $h .= '<option value="Negative"'.($sts==="Negative"?' selected':'').'>Negative</option>';
                }else{
                    $h .= '<option value=""'.(($sts==="" AND !$lockNR)?' selected':'').'>Select Status</option>';
                    $h .= '<option value="R"'.($sts==="R"?' selected':'').'>Required</option>';
                    $h .= '<option value="NR"'.(($sts==="NR" OR $lockNR)?' selected':'').'>Not Required</option>';
                }
                $h .= '</select></div>';

                $h .= '<div class="form-group col-md-6 col-xl-3">';
                $h .= '<label class="col-form-label-sm" for="bpProby'.$idx.'">Processed by:</label>';
                $h .= '<input type="text" class="form-control" name="proby['.$idx.']" id="bpProby'.$idx.'" maxlength="50" placeholder="Enter name" required value="'.htmlspecialchars($proby, ENT_QUOTES).'" />';
                $h .= '</div>';

                $h .= '<div class="form-group col-md-6 col-xl-3">';
                $h .= '<label class="col-form-label-sm" for="bpProdate'.$idx.'">Date of processing:</label>';
                $h .= '<input type="date" name="prodate['.$idx.']" id="bpProdate'.$idx.'" class="form-control text-center datepicker" required value="'.htmlspecialchars($prodate, ENT_QUOTES).'" />';
                $h .= '</div>';
                $h .= '</div>';

                /* #bpAst is toggled with style.display by displayASTRow(), so it is a
                   plain block, not a .row. Each antibiotic is one .row.lr-line -- the
                   element bpAstInterpret() and bpAstPanelOf() reach with
                   closest('.row') -- holding the hidden code, the zone and the result,
                   on the shared 3 / 3 / 2 / 4 grid. */
                $h .= '<div class="lr-ast" id="bpAst'.$idx.'" style="'.$astStyle.'">';
                $h .= '<div class="lr-subcard lr-subcard--ast">';
                $h .= '<div class="lr-subcard__head"><h4 class="lr-subcard__title">Antimicrobial Susceptibility</h4>'
                    . '<span class="lr-subcard__meta">Disk diffusion &middot; interpreted as you type</span></div>';
                $h .= '<div class="row lr-grid-head d-none d-md-flex"><div class="col-md-3">Antibiotic</div><div class="col-md-3">Method</div>'
                    . '<div class="col-md-2">Zone (mm) <span class="required-star" aria-hidden="true">*</span></div><div class="col-md-4">Interpretation</div></div>';
                $j = 0;
                $nAst = count($astRows);
                foreach($astRows as $a){
                    $agentTxt = htmlspecialchars($a['agent'], ENT_QUOTES);
                    $zoneId   = 'bpZone'.$idx.'_'.$j;
                    $h .= '<div class="row lr-line'.($j === $nAst - 1 ? ' lr-line--last' : '').'">';
                    $h .= '<div class="col-md-3 lr-cell lr-cell--name"><span class="lr-agent">'.$agentTxt.'</span>';
                    $h .= '<input type="hidden" name="code['.$idx.']['.$j.']" value="'.htmlspecialchars($a['code'], ENT_QUOTES).'" /></div>';
                    $h .= '<div class="col-md-3 lr-cell d-none d-md-block"><span class="lr-chip">Disk Diffusion</span></div>';
                    /* Breakpoints travel with the field so bpAstInterpret() can fill the
                       result as the user types, using the very numbers iu-lab.php applies
                       on save. Reading them from ms_ast_table rather than hardcoding a
                       table in JS is what stops the two from drifting apart. */
                    $h .= '<div class="col-6 col-md-2 lr-cell"><label class="lr-cell-label" for="'.$zoneId.'">Zone (mm)<span class="sr-only">, '.$agentTxt.'</span>:</label>';
                    $h .= '<input type="number" name="zone['.$idx.']['.$j.']" id="'.$zoneId.'" value="'.htmlspecialchars((string)$a['zone'], ENT_QUOTES).'"'
                        . ' class="form-control text-center bp-zone" required'
                        . ' data-sus="'.htmlspecialchars((string)$a['sus'], ENT_QUOTES).'"'
                        . ' data-int1="'.htmlspecialchars((string)$a['int1'], ENT_QUOTES).'"'
                        . ' data-int2="'.htmlspecialchars((string)$a['int2'], ENT_QUOTES).'"'
                        . ' data-res="'.htmlspecialchars((string)$a['res'], ENT_QUOTES).'"'
                        . ' oninput="bpAstInterpret(this); bpResistanceSync(bpBlockIdx(this));" /></div>';
                    $h .= '<div class="col-6 col-md-4 lr-cell"><label class="lr-cell-label" for="'.$zoneId.'r">Result<span class="sr-only">, '.$agentTxt.'</span>:</label>';
                    $h .= '<input type="text" id="'.$zoneId.'r" value="'.htmlspecialchars((string)$a['rslt'], ENT_QUOTES).'" class="form-control lr-pill bp-astresult" readonly tabindex="-1" aria-label="AST result, '.$agentTxt.'" /></div>';
                    $h .= '</div>';
                    $j++;
                }
                $h .= '</div>';
                /* Conditional ESBL / carbapenemase sub-panels live INSIDE the AST panel so
                   they hide with it (E.coli, 101, Not Required). */
                $h .= bdsis_bact_resistance_panels_html($idx, $resist, $esblAgents);
                $h .= '</div>';
                $h .= '</div>';
                return $h;
            }
        }

        /* bdsis_bact_resistance_panels_html() now lives in includes/lab-helpers.php:
           the E.coli AST panel renders the same two sub-panels through
           lab/load-ecoli-ast.php, which does not include this page. */

        if (chkBacteriology($id, $bdsis)==0){$savebr = "Save";}else{$savebr = "Update";}
        if (chkeColiPcr($id, $bdsis)==0 AND chkeColiAst($id, $bdsis)==0) {$disupdatebr = "";}else{$disupdatebr = "disabled";}
        /* Append-only: an E.coli PCR or AST result is derived from the pathogen
           rows below, so those rows are fixed once one exists. Saving used to be
           disabled outright, which also blocked "+ Add Pathogen" from ever
           reaching the database. A new pathogen can now be appended and saved;
           the rows already on file are read-only here and immutable in
           iu-lab.php, which is where it is actually enforced. */
        $bactAppendOnly = ($disupdatebr === "disabled");
        if (bdsis_can('delete', 'bacteriology') AND chkBacteriology($id, $bdsis)==1 AND chkeColiPcr($id, $bdsis)==0 AND chkeColiAst($id, $bdsis)==0) {
            $deletebr = "<a href='delete.php?type=bacteriology&id=$id&siid=$id' class='btn bg-gradient-danger mx-5' onclick='return confirmDelete()'>Delete</a>";
        }else{$deletebr = "";}
       
       
