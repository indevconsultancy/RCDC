    $sid=$_GET["sid"];
    /**
     * E.coli PCR Result -- one block per E.coli isolate the subject has.
     *
     * WHICH BLOCKS EXIST is decided by bdsis_ecoli_pcr_applies() (see
     * includes/lab-helpers.php). That helper is the single definition of the
     * rule and is called from here, from the save path in lab/iu-lab.php and
     * from both report renderers, so the layers cannot drift apart.
     *
     * Blocks are enumerated from the subject's E.coli bacteriology rows ordered
     * by the numeric part of e_pathogen, so P10 sorts after P9 and the block
     * order follows the Bacteriology form. There is no cap: however many E.coli
     * rows the subject has, each isolate gets its own independent block.
     *
     * Rows that share a pathogen_id collapse into a single block.
     * rcdc_ecoli_pcr_result_table2 is keyed by (subject_id, ecoli_id) and holds
     * no reference back to a bacteriology row, so two blocks for the same
     * ecoli_id would both write to -- and clobber -- the same record. The
     * e_pathogen slots feeding a block are listed in its label instead.
     */
    $ecoliBlocks=array();
    $ecoliRowQry=$bdsis->query("SELECT brt.pathogen_id, brt.e_pathogen, mpt.enteric_pathogen FROM bacteriology_result_table2 brt, ms_enteric_bacterial_pathogen_table mpt WHERE brt.subject_id='".$sid."' AND brt.pathogen_id=mpt.pathogen_id AND brt.pathogen_id IN ('025','026') ORDER BY CAST(SUBSTRING(brt.e_pathogen,2) AS UNSIGNED)");
    if($ecoliRowQry){
        while(list($bpid,$bslot,$bpname)=$ecoliRowQry->fetch_row()){
            if(isset($ecoliBlocks[$bpid])){ $ecoliBlocks[$bpid]['slots'][]=$bslot; continue; }
            if(!bdsis_ecoli_pcr_applies($bdsis, $sid, $bpid)){ continue; }
            $ecoliBlocks[$bpid]=array('ecoli_id'=>$bpid, 'name'=>$bpname, 'slots'=>array($bslot));
        }
    }
    $ecoliBlocks=array_values($ecoliBlocks);

    if(count($ecoliBlocks)>0){

    /* Master list of E.coli pathology types offered by the PCR Result section. */
    $ecoliStrains=bdsis_ecoli_pcr_strains($bdsis);

    /* Sticky = at least one block carries saved PCR data, so the client-side
       live toggle driven by the Bacteriology AST selects must never hide the
       section. This mirrors clause 2 of bdsis_ecoli_pcr_applies(). */
    $ecoliPcrSticky=false;

    foreach($ecoliBlocks as $bi=>$blk){
        $ecoliBlocks[$bi]['recid']='';
        $ecoliBlocks[$bi]['result']='';
        $ecoliBlocks[$bi]['proby']='';
        $ecoliBlocks[$bi]['probyname']='';
        $ecoliBlocks[$bi]['prodate']='';
        $ecoliBlocks[$bi]['rid']=array();
        $ecoliBlocks[$bi]['sel']=array();
        $ecoliBlocks[$bi]['dis']='disabled';

        $blkQry=$bdsis->query("SELECT record_id, ecoli_strain_result, processed_by, processed_on FROM rcdc_ecoli_pcr_result_table2 WHERE subject_id='".$sid."' AND ecoli_id='".$bdsis->real_escape_string($blk['ecoli_id'])."' ORDER BY record_id ASC LIMIT 1");
        if($blkQry AND $blkQry->num_rows>0){
            list($bRid,$bRslt,$bPby,$bPon)=$blkQry->fetch_row();
            $ecoliPcrSticky=true;
            $ecoliBlocks[$bi]['recid']=$bRid;
            $ecoliBlocks[$bi]['result']=$bRslt;

            if($bRslt=="Positive" OR $bRslt=="Negative"){
                /**
                 * One query for all six pathology types. 'rid' keeps the existing
                 * table3 record_id per strain (empty when the row was never
                 * written) and 'sel' holds the strains stored Positive, which is
                 * what the multi-select pre-selects.
                 */
                $strainQry=$bdsis->query("SELECT ecoli_strain_id, record_id, strain_result FROM rcdc_ecoli_pcr_result_table3 WHERE prt2_record_id='".$bRid."'");
                while(list($estid,$erid,$erslt)=$strainQry->fetch_row()){
                    if(isset($ecoliStrains[$estid])){
                        $ecoliBlocks[$bi]['rid'][$estid]=$erid;
                        if($erslt=="Positive"){$ecoliBlocks[$bi]['sel'][]=$estid;}
                    }
                }
                $ecoliBlocks[$bi]['proby']=$bPby;
                $ecoliBlocks[$bi]['probyname']=bdsis_processed_by_label($bPby, $commondb);
                $ecoliBlocks[$bi]['prodate']=$bPon;
                $ecoliBlocks[$bi]['dis']='';
            }
            /* Pending / Not Done keeps the block empty and its processing fields
               disabled, exactly as before. */
        }
    }

    $ecoliRemarksQry=$bdsis->query("SELECT remarks FROM rcdc_ecoli_pcr_result_table1 WHERE subject_id='".$sid."'");
    if($ecoliRemarksQry->num_rows>0){
        list($ecoliRemarks)=$ecoliRemarksQry->fetch_row();
    }else{$ecoliRemarks='';}

    if (chkeColiPcr($sid, $bdsis)==0){$savepcr = "Save";}else{$savepcr = "Update";}
    if(chkeColiAst($sid, $bdsis)==0){$disupdatepcr = "";}else{$disupdatepcr = "disabled";}
