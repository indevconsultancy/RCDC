       Conditional ESBL / Carbapenemase (mCIM, eCIM) sub-panels.

       Triggers and rules mirror includes/lab-helpers.php
       (bdsis_bact_trigger_codes, bdsis_mcim_interpret, bdsis_ecim_interpret).
       Everything here is UX only: iu-lab.php re-derives the triggers from
       the posted zones and recomputes every interpretation before storing.
       -------------------------------------------------------------- */
    var BP_TRIGGER     = <?=json_encode(bdsis_bact_trigger_codes());?>;
    var BP_ESBL_AGENTS = <?=json_encode(array_values(array_map(function($a){ return array('code'=>$a['code'], 'pair'=>$a['pair'], 'rule'=>$a['rule']); }, bdsis_esbl_agents($bdsis))));?>;

    function bpBlockIdx(el){
        var b = (el && el.closest) ? el.closest('.pathogen-block') : null;
        return b ? b.getAttribute('data-bpidx') : null;
