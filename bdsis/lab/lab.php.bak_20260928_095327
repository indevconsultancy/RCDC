     *         view is where it stays.
     *
     * This is presentation only. What may actually be written is decided by
     * $labMaySave below and re-decided in iu-lab.php on every post.
     */
    $labFormMode = function($section) use ($labSections) {
        return empty($labSections[$section]) ? 'add' : 'view';
