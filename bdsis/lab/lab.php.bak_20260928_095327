	/**
	 * Show ONE block's PCR Result (pathology type) row only when that block's
	 * strain result is Positive or Negative, and clear/disable its pathology-type
	 * multi-select for Negative so all six types round-trip as Negative.
	 *
	 * Everything is addressed by the block index, so toggling or editing one
	 * block never touches another and any number of blocks is supported.
	 *
	 * A `required` control inside a display:none container makes the browser
	 * refuse to submit with a non-focusable-field error, so every required
	 * control in the section loses the attribute while hidden and gets it back
	 * when shown (tracked via data-was-required so nothing is invented).
	 */
	function toggleEcoliPcrSection(idx, val){
		var section=document.getElementById('ecoliPcrSection'+idx);
		var strainsel=document.getElementById('strainsel'+idx);
		if(!section || !strainsel){ return; }

		var show=(val=="Positive" || val=="Negative");
		section.style.display = show ? "" : "none";

		bpSetRequiredWithin(section, show);

		//Negative means every pathology type is Negative: nothing selected, no editing.
		if(val!="Positive"){
			for(var j=0;j<strainsel.options.length;j++){ strainsel.options[j].selected=false; }
		}
		strainsel.disabled=(val!="Positive");

		//Keep Select2 (if initialised on this select) in sync with the raw element.
		if(window.jQuery && jQuery(strainsel).data('select2')){
			jQuery(strainsel).trigger('change.select2');
		}
	}

