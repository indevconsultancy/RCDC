	var rotaHasEcoli = <?= $rotaHasEcoli ? 'true' : 'false';?>;

	// Show the Genotype dropdown only when BOTH conditions hold. When it is
	// hidden the value is cleared so a stale genotype is not posted after the
	// result is flipped away from Positive.
	/* The G type / P type groups are shown only when the subject has E.coli in
	   Bacteriology AND Rotavirus is Positive; flipping away from Positive clears
	   them so nothing stale is posted. (The single Genotype dropdown that shared
	   this gate has been removed.) */
	function toggleRotaGenotype(val){
		var show = (rotaHasEcoli && val=="Positive");
		var gp   = document.querySelectorAll('.rota-gp');
		var i;
		for(i=0;i<gp.length;i++){ gp[i].style.display = show ? 'block' : 'none'; }
		if(!show){
			var cb = document.querySelectorAll('.rota-gp-input');
			for(i=0;i<cb.length;i++){ cb[i].checked = false; }
		}
		bdsisRotaCompose();
	}

	/* "Selected genotype": G labels then P labels, run together, with UT spaced
	   off from its neighbours -- G1P[8], G4P[4]P[8], G8 UT. Mirrors
	   bdsis_rotavirus_gp_compose() in includes/lab-helpers.php. */
	function bdsisRotaCompose(){
		var out = document.getElementById('rotaGpComposed');
		if(!out){ return; }
		var boxes = document.querySelectorAll('.rota-gp-input');
		var text = '';
		for(var i=0;i<boxes.length;i++){
			if(!boxes[i].checked){ continue; }
			var lbl = document.querySelector('label[for="' + boxes[i].id + '"]');
			var word = lbl ? lbl.textContent.trim() : '';
			if(word === ''){ continue; }
			if(text === ''){ text = word; continue; }
			var spaced = (word.toUpperCase() === 'UT') || (text.slice(-2).toUpperCase() === 'UT');
			text += (spaced ? ' ' : '') + word;
		}
		out.value = text;
	}
	document.addEventListener('change', function(ev){
		if(ev.target && ev.target.classList && ev.target.classList.contains('rota-gp-input')){ bdsisRotaCompose(); }
	}, true);
