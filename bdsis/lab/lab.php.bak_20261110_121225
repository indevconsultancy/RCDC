             */
            function bdsis_bact_ast_rows($bdsis, $recid, $pathogenId)
            {
                /* Each row also carries that antibiotic's CLSI breakpoints so the form can
                   interpret a typed zone immediately, using the same thresholds iu-lab.php
                   applies on save. */
                $blank = "SELECT code,antimicrobial_agent,'','',susceptible,intermediate1,intermediate2,resistance FROM ms_ast_table WHERE ast_method_id='01' AND status='1' ORDER BY antimicrobial_agent ASC";
                $recid = (string)$recid;
                $pathogenId = (string)$pathogenId;

                /* Stored readings for this isolate, keyed by antimicrobial code. */
                $stored = array();
                if($recid!=="" AND $pathogenId!=="" AND $pathogenId!=="025" AND $pathogenId!=="026" AND $pathogenId!=="101"){
                    $sq = $bdsis->query("SELECT bat.antimicrobial_code,bat.zone_diameter,bat.ast_result FROM bacteriology_ast_table bat, ms_ast_table mat WHERE bat.antimicrobial_code=mat.code AND bat.brt2_id='".$bdsis->real_escape_string($recid)."' AND mat.ast_method_id='01' AND mat.status=1");
                    if($sq){
                        while(list($sCode,$sZone,$sRslt)=$sq->fetch_row()){
                            $stored[(string)$sCode] = array('zone'=>$sZone, 'rslt'=>$sRslt);
                        }
                        $sq->free();
                    }
                }

                /* The ACTIVE master list drives the panel, for a saved isolate as well
                   as a new one. It used to be driven by the isolate's own stored rows,
                   so an antimicrobial added to the master after the record was created
                   never appeared on it again -- which is why the ESBL and carbapenemase
                   triggers could not fire on existing records: CAZ, CTX, CPD, IMI, EPT
                   and MER were simply absent from the form. Only Ceftriaxone, already
                   stored historically, could ever trigger.

                   An agent with no stored reading on a saved isolate defaults to -99,
                   the sentinel this form already uses for "not tested": the save path
                   deletes -99 rows, so re-saving an old record writes nothing new and
                   changes nothing, while the agent is now there to be entered. A brand
                   new isolate still starts blank, exactly as before. */
                $isSaved = (count($stored) > 0);
                $rows = array();
                $qry = $bdsis->query($blank);
                while(list($code,$agent,$zone,$rslt,$sus,$int1,$int2,$res)=$qry->fetch_row()){
                    $code = (string)$code;
                    if(isset($stored[$code])){
                        $zone = $stored[$code]['zone'];
                        $rslt = $stored[$code]['rslt'];
                    }elseif($isSaved){
                        $zone = '-99';
                        $rslt = '';
                    }
                    $rows[] = array('code'=>$code, 'agent'=>$agent, 'zone'=>$zone, 'rslt'=>$rslt,
                                    'sus'=>$sus, 'int1'=>$int1, 'int2'=>$int2, 'res'=>$res);
                }
                return $rows;
            }
        }

