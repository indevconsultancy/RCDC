    /* Routine panel of one row: code -> {result, zone}. */
    function bpAstPanelOf(idx){
        var out = {}, panel = document.getElementById('bpAst'+idx);
        if(!panel){ return out; }
        var zones = panel.querySelectorAll('.bp-zone');
        for(var i=0;i<zones.length;i++){
            var row = zones[i].closest('.row'); if(!row){ continue; }
            var codeEl = row.querySelector('input[type="hidden"]');
            var resEl  = row.querySelector('.bp-astresult');
            if(!codeEl || !resEl){ continue; }
            out[(codeEl.value||'').toUpperCase()] = { result: resEl.value, zone: (zones[i].value||'').trim() };
        }
        return out;
    }

    /* Show/hide the two panels for one row from its routine results. */
    function bpResistanceSync(idx){
        if(idx === null || idx === undefined){ return; }
        bpResistanceApply(idx, bpAstPanelOf(idx));
    }

    /* The same decision, whoever produced the results: a pathogen row's routine
       zones, or an E.coli pathotype panel (Disk Diffusion zones or MIC
       interpretations). Only the source differs -- the triggers, the required
       fields and the rules below are one implementation. Confirmatory panels
       show live as soon as the trigger fires and hide when the trigger is
       cleared. The browser-side `required` attribute is stripped by
       bpSetRequiredWithin on every hide so a submit with a hidden-but-required
       field never gets refused by the browser.

       opts (optional):
         requireFields  true  -> mark confirmatory inputs required when visible
                        false -> show panels but keep inputs optional (MIC mode;
                                 the server-side MIC path validates them
                                 section-aware, so marking required would
                                 just block submit without a corresponding save)
         skipPrefill    true  -> don't copy zones from `panel` into the ESBL /
                                 AmpC confirmatory inputs (makes no sense when
                                 the source is MIC values, not mm zones) */
    function bpResistanceApply(idx, panel, opts){
        if(idx === null || idx === undefined){ return; }
        panel = panel || {};
        opts = opts || {};
        var requireFields = (opts.requireFields !== false);
        var skipPrefill   = (opts.skipPrefill === true);

        var esblBy = [], cpeBy = [], i;
        for(i=0;i<BP_TRIGGER.esbl.length;i++){
            var c = BP_TRIGGER.esbl[i];
            if(panel[c] && panel[c].result === 'Resistant'){ esblBy.push(c); }
        }
        var carbaCodes = ['IMI', 'EPT', 'MER', 'IPM', 'ETP', 'MEM'];
        for(i=0;i<carbaCodes.length;i++){
            var d = carbaCodes[i];
            if(panel[d] && panel[d].result === 'Resistant'){
                var normD = (d === 'ETP') ? 'EPT' : ((d === 'IPM') ? 'IMI' : ((d === 'MEM') ? 'MER' : d));
                if(cpeBy.indexOf(normD) === -1){ cpeBy.push(normD); }
            }
        }
        var esbl = document.getElementById('bpEsbl'+idx);
        if(esbl){
            var showE = esblBy.length > 0;
            esbl.style.display = showE ? 'block' : 'none';
            var whyE = esbl.querySelector('.bp-esbl-why'); if(whyE){ whyE.textContent = esblBy.join(', '); }
            bpSetRequiredWithin(esbl, showE && requireFields);
            if(showE && !skipPrefill){ bpEsblPrefill(idx, panel); bpEsblInterpret(idx); }
        }
        var cpe = document.getElementById('bpCpe'+idx);
        var carbaNp = document.getElementById('bpCarbaNpStd'+idx);
        if(cpe){
            var showC = (cpeBy.length > 0);
            cpe.style.display = showC ? 'block' : 'none';
            if(carbaNp){
                carbaNp.style.display = showC ? 'block' : 'none';
                if(typeof bpSetRequiredWithin === 'function'){ bpSetRequiredWithin(carbaNp, showC && requireFields); }
            }
            var whyC = cpe.querySelector('.bp-cpe-why');
            if(whyC){
                whyC.textContent = (cpeBy.length > 0) ? cpeBy.join(', ') : '';
            }
            bpSetRequiredWithin(cpe, showC && requireFields);
            /* Module A auto-pulls carbapenem zones from the DD panel and
               computes the screening Positive / Negative; Module B visibility
               follows. bpMcimInterpret runs inside Module A sync whenever
               Module B is open, so no separate call is needed here. */
            if(showC && typeof bpCarbaScreenSync === 'function'){
                bpCarbaScreenSync(idx);
            }
        } else if(carbaNp){
            carbaNp.style.display = 'none';
            if(typeof bpSetRequiredWithin === 'function'){ bpSetRequiredWithin(carbaNp, false); }
        }
        /* AmpC β-lactamase Phenotypic Test: separate trigger (CTX AND CRO
           both Resistant, per 2026-10-08 spec), separate panel, same source
           panel object. */
        bpAmpcApply(idx, panel, opts);
        /* Keep the pathogen-row stage stepper in sync with the current
           confirmatory panel visibility. */
        if(typeof bpStageSync === 'function'){ bpStageSync(idx); }
    }

    /* ----- MIC-driven conditional display (Phase 3 — strict phenotype) ------
       Direct per-section phenotype trigger evaluation. The user spec
       (2026-10-04, revised 2026-10-08) sets explicit MIC thresholds per
       confirmatory panel; the DD-based BP_TRIGGER (CAZ/CTX/CPD/CRO for
       ESBL; IMI/EPT/MER for CPE) is bypassed in MIC mode so CRO on the MIC
       panel does NOT trigger ESBL alone -- it only contributes to the
       AmpC both-must-exceed check.

         ESBL  : CTX > 1  OR  CAZ > 4  OR  CRO > 1
         CPE   : ETP > 0.5  OR  IPM > 1  OR  MEM > 1
         AmpC  : CTX > 1  AND  CRO > 1          (CAZ dropped 2026-10-08)

       Codes are read raw from .bp-mic-value inputs (not from the CLSI pill),
       since the CLSI breakpoint for CTX puts MIC=2 at Intermediate but the
       ESBL phenotype rule still wants it treated as a trigger. In MIC mode
       confirmatory inputs stay OPTIONAL (required=false) -- the server-side
       MIC path validates them section-aware and only when the user has
       entered any field in that section. */
    var MIC_PHENOTYPE = {
        /* ESBL (2026-10-05 spec): CTX > 1 OR CAZ > 4 OR CRO > 1. CRO was
           previously tracked only in the AmpC co-trigger map; the standalone
           ESBL rule now includes it so MIC isolates where only Ceftriaxone
           is elevated also open the ESBL panel. */
        esbl: { CTX: 1, CAZ: 4, CRO: 1 },
        cpe:  { ETP: 0.5, IPM: 1, MEM: 1 },
        /* AmpC (2026-10-08 spec): CAZ removed from the trigger pair -- the
           panel now opens on CTX > 1 AND CRO > 1 alone. */
        ampc: { CTX: 1, CRO: 1 }
    };
    function bpMicRawValues(idx){
        var out = {}, box = document.getElementById('bpMic'+idx);
        if(!box){ return out; }
        var vals = box.querySelectorAll('.bp-mic-value');
        for(var i=0;i<vals.length;i++){
            var code = (vals[i].getAttribute('data-code') || '').toUpperCase();
            if(!code){ continue; }
            var raw = (vals[i].value || '').trim();
            if(raw === ''){ out[code] = null; continue; }
            var m = raw.match(/\d+(\.\d+)?/);
            out[code] = m ? parseFloat(m[0]) : null;
        }
        return out;
    }
    function bpMicResistanceSync(idx){
        if(idx === null || idx === undefined){ return; }
        var vals = bpMicRawValues(idx);

        /* ESBL trigger: ANY of CTX > 1 or CAZ > 4. */
        var esblBy = [];
        for(var ec in MIC_PHENOTYPE.esbl){
            if(vals[ec] !== null && vals[ec] !== undefined && vals[ec] > MIC_PHENOTYPE.esbl[ec]){
                esblBy.push(ec);
            }
        }
        /* Check auto-calculated interpretations of the 3 key Carbapenems (EPT, IMI, MER). */
        var cpeBy = [];
        var micCarbaCodes = ['EPT', 'ETP', 'IMI', 'IPM', 'MER', 'MEM'];
        var micBox = document.getElementById('bpMic' + idx);
        if(micBox){
            var micRows = micBox.querySelectorAll('.bp-mic-row');
            for(var ri = 0; ri < micRows.length; ri++){
                var valEl = micRows[ri].querySelector('.bp-mic-value');
                var resEl = micRows[ri].querySelector('.bp-mic-result');
                if(valEl && resEl){
                    var cCode = (valEl.getAttribute('data-code') || '').toUpperCase();
                    if(micCarbaCodes.indexOf(cCode) !== -1){
                        var interpVal = (resEl.value || '').trim();
                        if(interpVal === 'Resistant'){
                            var normCode = (cCode === 'ETP') ? 'EPT' : ((cCode === 'IPM') ? 'IMI' : ((cCode === 'MEM') ? 'MER' : cCode));
                            if(cpeBy.indexOf(normCode) === -1){
                                cpeBy.push(normCode);
                            }
                        }
                    }
                }
            }
        }
        /* AmpC trigger (2026-10-08): BOTH CTX > 1 and CRO > 1 must hold.
           CAZ was dropped from the pair; the ampc map is now 2-wide. */
        var ampcTriggered = true, ampcBy = [];
        for(var ac in MIC_PHENOTYPE.ampc){
            if(vals[ac] !== null && vals[ac] !== undefined && vals[ac] > MIC_PHENOTYPE.ampc[ac]){
                ampcBy.push(ac);
            } else {
                ampcTriggered = false;
            }
        }

        /* Apply panel show/hide live. Required stays FALSE in MIC mode so the
           browser doesn't refuse to submit when the user is filling MIC
           values. Server-side section-aware preflight does the real check. */
        var esbl = document.getElementById('bpEsbl'+idx);
        if(esbl){
            var showE = esblBy.length > 0;
            esbl.style.display = showE ? 'block' : 'none';
            var whyE = esbl.querySelector('.bp-esbl-why');
            if(whyE){ whyE.textContent = esblBy.join(', '); }
            if(typeof bpSetRequiredWithin === 'function'){ bpSetRequiredWithin(esbl, false); }
        }
        var cpe = document.getElementById('bpCpe'+idx);
        var carbaNp = document.getElementById('bpCarbaNpStd'+idx);
        if(cpe){
            var showC = (cpeBy.length > 0);
            cpe.style.display = showC ? 'block' : 'none';
            if(carbaNp){
                carbaNp.style.display = showC ? 'block' : 'none';
                if(typeof bpSetRequiredWithin === 'function'){ bpSetRequiredWithin(carbaNp, false); }
            }
            var whyC = cpe.querySelector('.bp-cpe-why');
            if(whyC){
                whyC.textContent = (cpeBy.length > 0) ? cpeBy.join(', ') : '';
            }
            if(typeof bpSetRequiredWithin === 'function'){ bpSetRequiredWithin(cpe, false); }
            /* 2026-10-12: pull EPT / IMI / MER MIC values from the routine
               panel into Module A's three screening inputs, unlock them for
               manual entry when the routine hasn't provided a reading, run
               the per-agent S/R interpretation (EPT > 1, IMI > 2, MEM > 2
               -> Resistant), and derive the Screening Result + Module B
               visibility. Mirror of bpCarbaScreenSync's DD prefill but
               keyed off the MIC band table. */
            if(showC && typeof bpCarbaScreenSyncMic === 'function'){
                bpCarbaScreenSyncMic(idx);
            }
        } else if(carbaNp){
            carbaNp.style.display = 'none';
            if(typeof bpSetRequiredWithin === 'function'){ bpSetRequiredWithin(carbaNp, false); }
        }
        var ampc = document.getElementById('bpAmpc'+idx);
        if(ampc){
            ampc.style.display = ampcTriggered ? 'block' : 'none';
            var whyA = ampc.querySelector('.bp-ampc-why');
            if(whyA){ whyA.textContent = ampcTriggered ? ampcBy.join(', ') : 'CTX, CRO'; }
            if(typeof bpSetRequiredWithin === 'function'){ bpSetRequiredWithin(ampc, false); }
            /* 2026-10-12: when the AmpC panel is visible in MIC-routine mode,
               auto-pull CTX / CRO / FEP values from the routine MIC panel
               and promote the AmpC method dropdowns to 'MIC' so the panel
               interprets under the right band table instead of landing with
               empty inputs. Prefill is non-destructive: empty destinations
               only, never overwrites a user edit or a saved value. */
            if(ampcTriggered && typeof bpAmpcApplyMic === 'function'){
                bpAmpcApplyMic(idx);
            }
        }

        /* Also update the stage stepper, so the Confirmatory step lights up
           when any panel is now visible. */
        if(typeof bpStageSync === 'function'){ bpStageSync(idx); }
    }

    function bpResistanceSyncAll(){
        var blocks = document.querySelectorAll('#pathogenRows .pathogen-block');
        for(var i=0;i<blocks.length;i++){
            if(blocks[i].getAttribute('data-locked') === '1'){ continue; }   // fixed row: nothing to re-decide
            var idx = blocks[i].getAttribute('data-bpidx');
            /* Pick the sync that matches the row's current Method so a reload
               after a MIC save brings the ESBL / Carbapenem panels back on
               the strength of the MIC interpretations, not empty DD zones. */
            var methodEl = document.getElementById('bpMethod' + idx);
            if(methodEl && methodEl.value === '02'){ bpMicResistanceSync(idx); }
            else                                  { bpResistanceSync(idx);    }
            if(typeof bpStageSync === 'function'){ bpStageSync(idx); }
        }
    }

    /* ----- Stage stepper (visual-only workflow indicator) -------------------
       Derives the "furthest-reached" stage for one pathogen row from the
       live form state:

         Stage 1 — Pathogen selected AND AST status chosen.
         Stage 2 — any routine AST reading entered (DD zone or MIC value).
         Stage 3 — any confirmatory panel (ESBL / CPE / AmpC) is visible.
         Stage 4 — E. coli pathogen with ast_status = Positive (unlocks the
                   PCR / AST / downstream cards). For non-E.coli rows the
                   Downstream pip stays locked.

       UI-only. The server save path is unchanged; the stepper does not
       gate submission. It gives the user a quick visual read of where
       they are in the row's workflow. */
    function bpStageSync(idx){
        if(idx === null || idx === undefined){ return; }
        var strip = document.getElementById('bpStage' + idx);
        if(!strip){ return; }

        var pathEl   = document.getElementById('bpPathogen' + idx);
        var statusEl = document.getElementById('bpStatus'   + idx);
        var methodEl = document.getElementById('bpMethod'   + idx);
        var pid  = pathEl   ? (pathEl.value   || '').trim() : '';
        var sts  = statusEl ? (statusEl.value || '').trim() : '';
        var meth = methodEl ? (methodEl.value || '01').trim() : '01';

        /* Stage 1 — pathogen + AST status both set. The "101" (no isolate)
           pathogen and the NR status are terminal: Stage 1 only, no AST. */
        var stage1Done = (pid !== '' && sts !== '');
        var isNoIsolate = (pid === '101' || pid === '999');
        var isEcoli     = (pid === '025' || pid === '026');
        var isEcoliPositive = (isEcoli && sts === 'Positive');
        var isNR            = (sts === 'NR');

        /* Stage 2 — at least one routine AST reading entered. For DD, that
           means any .bp-zone with a non-empty, non-"-99" value. For MIC,
           any .bp-mic-value with a non-empty entry. */
        var stage2Done = false;
        if(stage1Done && !isNoIsolate && !isNR && !isEcoli){
            if(meth === '02'){
                var micIns = document.querySelectorAll('#bpMic' + idx + ' .bp-mic-value');
                for(var i=0;i<micIns.length;i++){
                    if(String(micIns[i].value || '').trim() !== ''){ stage2Done = true; break; }
                }
            } else {
                var zones = document.querySelectorAll('#bpDd' + idx + ' .bp-zone');
                for(var j=0;j<zones.length;j++){
                    var zv = String(zones[j].value || '').trim();
                    if(zv !== '' && zv !== '-99'){ stage2Done = true; break; }
                }
            }
        }

        /* Stage 3 — any confirmatory panel is currently visible (i.e. a
           trigger has fired). bpResistanceSync / bpMicResistanceSync are
           what set display:block on these elements. */
        var stage3Done = false;
        var confIds = ['bpEsbl', 'bpCpe', 'bpAmpc'];
        for(var k=0;k<confIds.length;k++){
            var el = document.getElementById(confIds[k] + idx);
            if(el && el.style && el.style.display === 'block'){ stage3Done = true; break; }
        }

        /* Stage 4 (Downstream) — only applies to E. coli Positive rows that
           open the PCR + AST + ELISA cards below. For other pathogens we
           mark the Downstream pip as locked. */
        var stage4Done = isEcoliPositive;
        var downstreamLocked = !isEcoli && !isEcoliPositive;

        /* Resolve the current stage. */
        var cur = 1;
        if(stage1Done){ cur = 2; }
        if(stage2Done || (stage1Done && (isNoIsolate || isNR))){
            /* NR / 101 completes workflow at Stage 2 since no AST applies. */
            cur = stage2Done ? 2 : 1;
            if(isNoIsolate || isNR){ cur = 2; }
        }
        if(stage3Done){ cur = 3; }
        if(stage4Done){ cur = 4; }

        strip.setAttribute('data-stage', String(cur));

        var downstreamLi = strip.querySelector('.lr-stage--4');
        if(downstreamLi){
            if(downstreamLocked){ downstreamLi.classList.add('lr-stage--locked'); }
            else                 { downstreamLi.classList.remove('lr-stage--locked'); }
        }
    }
    function bpStageSyncAll(){
        var blocks = document.querySelectorAll('#pathogenRows .pathogen-block');
        for(var i=0;i<blocks.length;i++){
            bpStageSync(blocks[i].getAttribute('data-bpidx'));
        }
    }


    /* ---------- Bacteriology MIC toggle + interpret (Phase 1) ----------------
       Mirrors the server-side logic in includes/lab-bact-mic.php. UX only --
       iu-lab.php re-reads method[rowIdx] from POST and re-derives every
       Interpretation from the MIC breakpoint map before storing.

       bpSetAstMethod(idx, method)   shows one AST sub-panel and hides the other.
                                     Only '01' and '02' are valid.
       bpBactMicInterpret(input)     fills the sibling Interpretation pill from
                                     the MIC value the user typed, using the
                                     per-input data-s / data-r thresholds. */
    function bpSetAstMethod(idx, method){
        var dd  = document.getElementById('bpDd'  + idx);
        var mic = document.getElementById('bpMic' + idx);
        var isMic = (String(method) === '02');
        if(dd){ dd.style.display  = isMic ? 'none'  : 'block'; }
        if(mic){ mic.style.display = isMic ? 'block' : 'none'; }
        /* Belt-and-braces: force all three confirmatory panels hidden BEFORE
           running the sync. Prevents any flash of visibility on method flip
           and guarantees the "blank grid = no confirmatory" contract even if
           the sync function is somehow replaced later. The sync below then
           re-reveals ONLY the panels whose triggers fire from the current
           (DD or MIC) grid. */
        var confIds = ['bpEsbl', 'bpCpe', 'bpAmpc', 'bpCarbaNpStd'];
        for(var i=0;i<confIds.length;i++){
            var p = document.getElementById(confIds[i] + idx);
            if(p){
                p.style.display = 'none';
                if(typeof bpSetRequiredWithin === 'function'){ bpSetRequiredWithin(p, false); }
            }
        }
        if(dd){ bpSetRequiredWithin(dd, !isMic); }
        try {
            if(isMic){
                if(typeof bpMicResistanceSync === 'function'){ bpMicResistanceSync(idx); }
            } else {
                if(typeof bpResistanceSync === 'function'){ bpResistanceSync(idx); }
            }
        } catch(e){}
        if(typeof bpStageSync === 'function'){ bpStageSync(idx); }
    }

    function bpBactMicInterpret(input){
        if(!input){ return; }
        var val = String(input.value || '').trim();
        var row = input.closest ? input.closest('.bp-mic-row') : null;
        var pill = row ? row.querySelector('.bp-mic-result') : null;
        if(!pill){
            /* Still want to re-evaluate the ESBL / Carbapenem triggers if the
               caller only passed the input without a pill lookup match. */
            var _idx = bpMicGridIdx(input);
            if(_idx !== null){ bpMicResistanceSync(_idx); }
            return;
        }
        if(val === ''){ pill.value = ''; }
        else {
            var m = val.match(/\d+(\.\d+)?/);
            if(!m){ pill.value = ''; }
            else {
                var num = parseFloat(m[0]);
                if(isNaN(num) || num <= 0){ pill.value = ''; }
                else {
                    var sThr = parseFloat(input.getAttribute('data-s'));
                    var rThr = parseFloat(input.getAttribute('data-r'));
                    var out = '';
                    if(!isNaN(sThr) && num <= sThr){ out = 'Susceptible'; }
                    else if(!isNaN(rThr) && num >= rThr){ out = 'Resistant'; }
                    else { out = 'Intermediate'; }
                    pill.value = out;
                }
            }
        }
        /* MIC-driven conditional display of ESBL / Carbapenem panels: whenever
           the interpretation pill is updated, re-evaluate the triggers for the
           whole panel. Only this row changes, so one sync is enough. */
        var idx = bpMicGridIdx(input);
        if(idx !== null){ bpMicResistanceSync(idx); }
    }

    /* Which panel does a MIC input belong to? The grid states its own index on
       .lr-bact-mic[data-bpidx], which is what an E. coli pathotype panel has
       to offer -- it sits in #astNdiv and has no .pathogen-block ancestor. A
       bacteriology row is still read from its block when the attribute is
       missing (a panel rendered before 2026-10-16 and left in a cached page). */
    function bpMicGridIdx(el){
        if(!el || !el.closest){ return null; }
        var grid = el.closest('.lr-bact-mic');
        if(grid && grid.getAttribute('data-bpidx') !== null){ return grid.getAttribute('data-bpidx'); }
        var block = el.closest('.pathogen-block');
        return block ? block.getAttribute('data-bpidx') : null;
    }

    /* ---------- AmpC β-lactamase Phenotypic Test (per-row) -------------------
       Mirrors the server-side logic in includes/lab-ampc.php. UX only --
       iu-lab.php re-derives the trigger from the posted values, re-applies the
       breakpoints and re-computes the "AmpC phenotype" before storing.

       Trigger (2026-10-08): CTX AND CRO BOTH Resistant on the routine AST
       (CAZ was dropped).
       Prefill: CTX / CRO / FEP values are copied from the routine AST into
                the AmpC inputs AS A CONVENIENCE on first open (2026-10-10:
                all four Value inputs are editable; prefill only fills empty
                destinations and never overwrites a user edit or a saved
                value on edit-mode reopen).
       Manual:  FOX has no routine ABST source; the user types its value.

       Per-agent interpretation (S / R, two perspectives):
         Disc Diffusion / Disc approximation method -> value is zone (mm).
         MIC / E Test                               -> value is MIC (µg/mL).
       The method dropdown on each row picks the perspective; the band
       tables below mirror bdsis_ampc_breakpoints() in lab-ampc.php. */
    var AMPC_TRIGGER_CODES = ['CTX', 'CRO'];
    /* AMPC_AUTO_SOURCES maps an AmpC agent code to the routine ABST code
       it should prefill from. The three auto rows (CTX / CRO / FEP) are
       editable; the user can override whenever the bench reading differs
       or when the routine ABST was MIC (the DD prefill does not apply in
       that case -- bpMicResistanceSync skips this step). */
    var AMPC_AUTO_SOURCES  = { CTX: 'CTX', CRO: 'CRO', FEP: 'FEP' };    // AmpC code -> ABST source code
    var AMPC_AGENTS        = ['CTX', 'CRO', 'FOX', 'FEP'];
    /* Binary bands (2026-10-08 revision: Intermediate removed per the
       client's updated zone-only spec). r_max for DD means R when
       value <= r_max, else S. r_min for MIC means R when value >= r_min,
       else S. The FEP DD rule is "zone > 18 -> S else R", encoded as
       r_max = 18 so the <= branch returns R uniformly. */
    var AMPC_BREAKPOINTS   = {
        DD: {
            CTX: { r_max: 22 },   // zone <= 22 R, else S
            CRO: { r_max: 19 },   // zone <= 19 R, else S
            FOX: { r_max: 14 },   // zone <= 14 R, else S
            FEP: { r_max: 18 }    // zone > 18 S, else R  (same math as "<= 18 -> R")
        },
        MIC: {
            CTX: { r_min: 4  },
            CRO: { r_min: 4  },
            FOX: { r_min: 32 },
            FEP: { r_min: 16 }
        }
    };

    function bpAmpcTriggered(panel){
        for(var i=0; i<AMPC_TRIGGER_CODES.length; i++){
            var c = AMPC_TRIGGER_CODES[i];
            if(!panel[c] || panel[c].result !== 'Resistant'){ return null; }
        }
        return AMPC_TRIGGER_CODES.slice();
    }

    /* AmpC incomplete-test message (2026-10-06 spec, must match
       bdsis_ampc_incomplete_message() in includes/lab-ampc.php). */
    var AMPC_INCOMPLETE_MSG = 'AmpC interpretation: Incomplete – AmpC β-lactamase Phenotypic Test result required.';

    /* Which band table a method reads from. DD for Disc Diffusion / Disc
       approximation method; MIC for MIC / E Test. Any other / legacy value
       falls back to DD so pre-2026-10-08 records interpret unchanged. */
    function bpAmpcPerspective(method){
        var m = (method == null) ? '' : String(method).trim().toLowerCase();
        if(m === 'mic')                     { return 'MIC'; }
        if(m === 'e test' || m === 'e-test'){ return 'MIC'; }
        return 'DD';
    }

    function bpAmpcInterpretCode(code, value, method){
        /* Returns Susceptible / Resistant from the raw value + the method's
           perspective. '' when the input is blank or carries no numeric
           token (counts as "Not Tested"; the screen bypasses it). 2026-10-12:
           accepts clinical MIC notation with comparator prefixes ("<=0.5",
           ">16", ">=2") -- the first numeric token drives interpretation,
           and the raw string is left on the DOM for save/round-trip. */
        if(value === '' || value === null || value === undefined){ return ''; }
        if(typeof value === 'string'){
            var t = value.trim();
            if(t === ''){ return ''; }
            var m = t.match(/\d+(\.\d+)?/);
            if(!m){ return ''; }
            value = m[0];
        }
        var v = parseFloat(value);
        if(isNaN(v) || v < 0){ return ''; }
        var persp = bpAmpcPerspective(method);
        var bp    = AMPC_BREAKPOINTS[persp] && AMPC_BREAKPOINTS[persp][code];
        if(!bp){ return ''; }
        if(persp === 'DD'){
            /* Zone: larger = more susceptible. */
            return (v <= bp.r_max) ? 'Resistant' : 'Susceptible';
        }
        /* MIC: larger = more resistant. */
        return (v >= bp.r_min) ? 'Resistant' : 'Susceptible';
    }

    /* Unit label beside the Value input switches between "(mm)" (Disc
       Diffusion family) and "(µg/mL)" (MIC family) when the method
       dropdown changes. Called for every row by bpAmpcInterpret() so one
       input event re-labels everything consistently. */
    function bpAmpcSyncUnitLabel(idx, code){
        var mEl   = document.getElementById('bpAmpcMethod' + idx + '_' + code);
        var label = document.querySelector('#bpAmpc' + idx + ' .bp-ampc-value-unit[data-ampc-unit-for="' + code + '"]');
        if(!label){ return; }
        var persp = bpAmpcPerspective(mEl ? mEl.value : '');
        label.textContent = (persp === 'MIC') ? '(µg/mL)' : '(mm)';
    }

    function bpAmpcInterpret(idx){
        var panel = document.getElementById('bpAmpc' + idx);
        if(!panel){ return; }
        /* Per-agent S / R interpretation. Each agent's zone / MIC input
           feeds bpAmpcInterpretCode(); the result is written into the
           per-row Interpretation pill. Blank inputs leave the pill empty
           (that agent is treated as "Not Tested" and the screen skips it). */
        var results = {}, allFour = true;
        for(var i=0; i<AMPC_AGENTS.length; i++){
            var code = AMPC_AGENTS[i];
            var mEl = document.getElementById('bpAmpcMethod' + idx + '_' + code);
            var zEl = document.getElementById('bpAmpcZone'   + idx + '_' + code);
            var rEl = document.getElementById('bpAmpcResult' + idx + '_' + code);
            if(!zEl || !rEl){ continue; }
            bpAmpcSyncUnitLabel(idx, code);
            var m   = mEl ? (mEl.value || '') : '';
            var raw = (zEl.value == null) ? '' : String(zEl.value).trim();
            var r   = bpAmpcInterpretCode(code, raw, m);
            rEl.value = r;
            results[code] = r;
            if(r === ''){ allFour = false; }
            if(code === 'FOX'){
                var fm = document.getElementById('ampc_fox_method_' + idx); if(fm){ fm.value = m; }
                var fv = document.getElementById('ampc_fox_val_' + idx); if(fv){ fv.value = raw; }
                var fv2 = document.getElementById('ampc_fox_value_' + idx); if(fv2){ fv2.value = raw; }
                var fi = document.getElementById('ampc_fox_int_' + idx); if(fi){ fi.value = r; }
            } else if(code === 'FEP'){
                var fm = document.getElementById('ampc_fep_method_' + idx); if(fm){ fm.value = m; }
                var fv = document.getElementById('ampc_fep_val_' + idx); if(fv){ fv.value = raw; }
                var fv2 = document.getElementById('ampc_fep_value_' + idx); if(fv2){ fv2.value = raw; }
                var fi = document.getElementById('ampc_fep_int_' + idx); if(fi){ fi.value = r; }
            }
        }
        /* Final AmpC phenotype pill (auto-computed, 2026-10-08 revised):
             IF any of CTX / CRO / FEP / FOX is blank / Not Tested
                 -> incomplete message
             ELSE IF FEP = Susceptible AND (CTX / CRO / FOX = Resistant)
                 -> "AmpC producer"
             ELSE
                 -> "AmpC negative"
           Matches bdsis_ampc_overall() in lab-ampc.php exactly; the server
           re-derives on save so a hand-crafted POST cannot bypass the rule. */
        var finalEl = document.getElementById('bpAmpcResult' + idx);
        var finalVal = '';
        if(finalEl){
            if(!allFour){
                finalVal = AMPC_INCOMPLETE_MSG;
            } else {
                var fepS = (results.FEP === 'Susceptible');
                var anyR = (results.CTX === 'Resistant')
                        || (results.CRO === 'Resistant')
                        || (results.FOX === 'Resistant');
                finalVal = (fepS && anyR) ? 'AmpC producer' : 'AmpC negative';
            }
            finalEl.value = finalVal;
        }
        var pRes = document.getElementById('ampc_phenotype_result_' + idx);
        if(pRes){ pRes.value = finalVal; }
        if(typeof lrQueueTones === 'function'){ lrQueueTones(); }
    }

    /* 2026-10-14: delegated `input` + `change` wiring for every AmpC
       Value and Method control.

       bdsis_ampc_panel_html() already puts an inline oninput on each Value
       input and an inline onchange on each Method select, which covers
       ordinary typing. Two cases that hook alone misses:

         (a) a `change` that arrives with NO preceding `input` -- browser
             autofill, a form restored on back-navigation, and any script
             that assigns .value and then dispatches change. The inline
             oninput never fires for those, so the pills would keep showing
             the interpretation of the value the field used to hold.

         (b) a panel inserted into the DOM after this script ran. Adding a
             pathogen row clones a block, so a per-element binding taken at
             load time would not cover it; a document-level listener does.

       Running alongside the inline handler is harmless: bpAmpcInterpret()
       is a pure recompute of the whole panel from the DOM, so firing it
       twice for one keystroke writes identical pills. Capture phase and
       document target match the lrQueueTones listeners further down. */
    function bpAmpcIdxFromControl(el){
        /* Panels are <div class="... bp-ampc" id="bpAmpc<idx>">. Walk up to
           that container and strip the 6-char "bpAmpc" prefix. Taking the
           idx off the container rather than parsing the control's own id
           keeps this working for any control the panel grows later. */
        var n = el;
        while(n && n !== document){
            if(n.classList && n.classList.contains('bp-ampc') && n.id && n.id.indexOf('bpAmpc') === 0){
                return n.id.substring(6);
            }
            n = n.parentNode;
        }
        return null;
    }
    function bpAmpcRecalcFromEvent(ev){
        var t = ev.target;
        if(!t || !t.classList){ return; }
        /* Only the four Value inputs and the four Method selects change an
           interpretation; every other control in the panel is an output. */
        if(!t.classList.contains('bp-ampc-zone') && !t.classList.contains('bp-ampc-method')){ return; }
        var idx = bpAmpcIdxFromControl(t);
        if(idx === null || idx === ''){ return; }
        bpAmpcInterpret(idx);
    }
    document.addEventListener('input',  bpAmpcRecalcFromEvent, true);
    document.addEventListener('change', bpAmpcRecalcFromEvent, true);

    function bpAmpcApply(idx, panel, opts){
        var box = document.getElementById('bpAmpc' + idx);
        if(!box){ return; }
        opts = opts || {};
        var requireFields = (opts.requireFields !== false);
        var skipPrefill   = (opts.skipPrefill === true);
        var triggers = bpAmpcTriggered(panel);
        var show = (triggers !== null);
        box.style.display = show ? 'block' : 'none';
        var why = box.querySelector('.bp-ampc-why');
        if(why){ why.textContent = show ? triggers.join(', ') : 'CTX, CRO'; }
        bpSetRequiredWithin(box, show && requireFields);
        if(!show){ return; }

        /* Prefill CTX / CRO / FEP values from the routine AST panel as a
           convenience. 2026-10-10 revision: the AmpC inputs are now editable
           (not readonly), so the prefill ONLY fires when the destination is
           empty -- it never overwrites a value the user already typed. On
           the first open of a new record this is the familiar auto-pool;
           on reopen of a saved record the saved value wins. In MIC mode
           the source values are MIC strings (not mm zones) so prefill is
           deliberately skipped (bpMicResistanceSync does not call this). */
        if(!skipPrefill){
            for(var ampcCode in AMPC_AUTO_SOURCES){
                var src  = AMPC_AUTO_SOURCES[ampcCode];
                var srcZ = (panel[src] && panel[src].zone != null) ? panel[src].zone : '';
                var dst  = document.getElementById('bpAmpcZone' + idx + '_' + ampcCode);
                if(dst && String(dst.value || '').trim() === '' && String(srcZ || '').trim() !== ''){
                    dst.value = srcZ;
                }
            }
            bpAmpcInterpret(idx);
        }
    }

    /* bpAmpcApplyMic -- MIC-mode counterpart of bpAmpcApply's DD prefill
       (2026-10-12). bpMicResistanceSync calls this once the AmpC panel's
       MIC trigger (CTX > 1 AND CRO > 1) has fired. For each of the three
       auto-source agents (CTX / CRO / FEP) we:
         (a) copy the matching routine MIC value from the .bp-mic-value
             input into the AmpC Value input -- but only when the AmpC
             input is still EMPTY, so a user edit or a saved value is
             never overwritten;
         (b) promote the AmpC method dropdown from its default
             'Disc Diffusion' to 'MIC' so the band table dispatches to
             the MIC perspective (CTX/CRO r_min=4, FEP r_min=16, FOX
             r_min=32). We only promote when the dropdown is still at
             its default -- a user who has deliberately picked DD or
             E Test keeps their choice.
       FOX has no routine source (source='manual' in bdsis_ampc_agents())
       and is intentionally skipped by the AMPC_AUTO_SOURCES map -- the
       user types FOX manually. After prefill we re-run bpAmpcInterpret
       so the unit label switches to (µg/mL) and the pills recompute. */
    function bpAmpcApplyMic(idx){
        var box = document.getElementById('bpAmpc' + idx);
        if(!box){ return; }
        var micBox = document.getElementById('bpMic' + idx);
        if(!micBox){ return; }

        /* Read routine MIC values keyed by code (raw strings; parser
           normalises on save). */
        var vals = {};
        var inputs = micBox.querySelectorAll('.bp-mic-value');
        for(var i=0;i<inputs.length;i++){
            var code = (inputs[i].getAttribute('data-code') || '').toUpperCase();
            if(!code){ continue; }
            var raw = String(inputs[i].value || '').trim();
            if(raw !== ''){ vals[code] = raw; }
        }

        /* 2026-10-14 fix -- method promotion is now independent of whether a
           routine MIC value exists, and covers all FOUR agents.

           Previously this was one loop over AMPC_AUTO_SOURCES (CTX / CRO /
           FEP) that `continue`d before touching the method dropdown whenever
           the routine panel had no value for that code. Two consequences,
           both of which made a hand-typed MIC read against the DD band:

             - FOX is not in AMPC_AUTO_SOURCES at all (it has no routine
               source; the user always types it). Its server-side default
               method is '' (bdsis_ampc_default_method), and
               bpAmpcPerspective('') falls back to 'DD'. So a Cefoxitin MIC
               of 32 was compared against the DD rule "zone <= 14 -> R" and
               came out Susceptible, when the MIC rule ">= 32 -> R" makes it
               Resistant -- the single most wrong cell on the panel.

             - CTX / CRO / FEP had the same problem whenever the routine MIC
               panel was still empty and the user typed straight into AmpC:
               the `continue` skipped the promotion, so the value was read
               as a zone.

           Promotion stays conservative: only a dropdown still sitting on its
           fresh state ('' or the 'Disc Diffusion' server default) is moved,
           so a deliberate DD / E Test choice is never overridden. */
        var ai, agCode, methodEl;
        for(ai = 0; ai < AMPC_AGENTS.length; ai++){
            agCode   = AMPC_AGENTS[ai];
            methodEl = document.getElementById('bpAmpcMethod' + idx + '_' + agCode);
            if(!methodEl){ continue; }
            var cur = String(methodEl.value || '').trim();
            if(cur !== '' && cur !== 'Disc Diffusion'){ continue; }
            /* Confirm 'MIC' is in this agent's option list before assigning
               -- the <option> must exist for the select to adopt the value
               cleanly. */
            var hasMic = false;
            for(var oi = 0; oi < methodEl.options.length; oi++){
                if(methodEl.options[oi].value === 'MIC'){ hasMic = true; break; }
            }
            if(hasMic){ methodEl.value = 'MIC'; }
        }

        /* Value prefill stays limited to the three agents that HAVE a routine
           source, and stays non-destructive: empty destinations only, so a
           user edit or a value restored on edit-mode reload always wins.
           FOX is deliberately absent -- it is typed by hand. */
        for(var ampcCode in AMPC_AUTO_SOURCES){
            var src  = AMPC_AUTO_SOURCES[ampcCode];
            var srcV = vals[src];
            if(srcV == null || String(srcV).trim() === ''){ continue; }
            var dst = document.getElementById('bpAmpcZone' + idx + '_' + ampcCode);
            if(dst && String(dst.value || '').trim() === ''){
                dst.value = srcV;
            }
        }
        bpAmpcInterpret(idx);
    }

    /* A pathogen row that an E.coli PCR / AST result was derived from is fixed.
       Every control inside it is switched off so it cannot be edited or posted;
       iu-lab.php ignores such a row whatever arrives, so this is presentation.
       Hidden inputs are left alone and the row keeps rendering its stored
       values, including any ESBL / carbapenemase result. */
    function bpLockFixedRows(){
        var blocks = document.querySelectorAll('#pathogenRows .pathogen-block[data-locked="1"]');
        for(var i=0;i<blocks.length;i++){
            var els = blocks[i].querySelectorAll('input, select, textarea, button');
            for(var j=0;j<els.length;j++){
                if(els[j].type === 'hidden'){ continue; }
                els[j].disabled = true;
                els[j].removeAttribute('required');   /* a disabled field is not validated */
            }
            var rm = blocks[i].querySelector('.bp-remove');
            if(rm){ rm.style.display = 'none'; }
        }
    }
    /* ------------------------------------------------------------------
       View / Edit mode.

       A section that already holds a result opens inert: every control in the
       card is disabled, so no dropdown opens, no field takes a keystroke and no
       date picker appears. Pressing Edit hands the card back exactly as it was,
       including every rule that had already switched a control off -- a fixed
       pathogen row, the Not Required status select, a disabled processed-by --
       because the original state is recorded before anything is greyed out and
       only what was live is revived.

       A section with nothing in it opens in Add mode: there is nothing to view.

       This is presentation. What may be written is decided by $labMaySave when
       the page renders and re-decided by iu-lab.php on every post.
       ------------------------------------------------------------------ */
    function lrControlsIn(root){ return root.querySelectorAll('input, select, textarea, button'); }

    /* View mode switches off only what was live, and remembers which ones, so
       leaving view mode revives exactly those. Anything a business rule had
       already switched off -- a fixed pathogen row, a Not Required status, an
       OD value waiting for its result to be chosen -- is never touched here,
       and the handlers that enable such a field at runtime keep working. */
    function lrApplyMode(form){
        if(!form){ return; }
        var view = (form.getAttribute('data-lrmode') === 'view');
        var els = lrControlsIn(form), i, el;
        for(i=0;i<els.length;i++){
            el = els[i];
            if(el.type === 'hidden'){ continue; }   /* still posts, never focusable */
            /* Action bar: Save / Delete / Edit are shown or hidden by mode, never
               disabled by it. The server disables the Save button on its own terms
               (an E.coli PCR that already has AST results cannot be re-saved), and
               that state has to survive a trip through view mode untouched. */
            if(el.closest && el.closest('.lr-actionbar')){ continue; }
            if(view){
                if(!el.disabled){ el.setAttribute('data-lrviewoff', '1'); el.disabled = true; }
            }else if(el.getAttribute('data-lrviewoff') === '1'){
                el.removeAttribute('data-lrviewoff');
                el.disabled = false;
            }
        }
        /* The Edit button lives inside the card it unlocks, so it is exempt. */
        if(view){
            var keep = form.querySelectorAll('.lr-when-view, .lr-when-view *');
            for(i=0;i<keep.length;i++){ if('disabled' in keep[i]){ keep[i].removeAttribute('data-lrviewoff'); keep[i].disabled = false; } }
        }
        var onView = form.querySelectorAll('.lr-when-view');
        for(i=0;i<onView.length;i++){ onView[i].style.display = view ? '' : 'none'; }
        var onEdit = form.querySelectorAll('.lr-when-edit');
        for(i=0;i<onEdit.length;i++){ onEdit[i].style.display = view ? 'none' : ''; }
        if(form.classList){ form.classList.toggle('lr-viewing', view); }
    }

    function lrEnterEdit(btn){
        var form = (btn && btn.closest) ? btn.closest('form.lr-form') : null;
        if(!form){ return; }
        form.setAttribute('data-lrmode', 'edit');
        lrApplyMode(form);
        /* A pathogen row an E.coli PCR / AST result was derived from stays fixed
           even in edit mode; re-assert it after the controls come back. */
        if(typeof bpLockFixedRows === 'function'){ bpLockFixedRows(); }
        if(typeof lrQueueTones === 'function'){ lrQueueTones(); }
        var first = form.querySelector('select:not([disabled]), input:not([type=hidden]):not([disabled]), textarea:not([disabled])');
        if(first && first.focus){ first.focus(); }
    }

    /* Re-apply after markup arrives from the server (the E.coli AST panels are
       fetched on every method change, and their controls have no snapshot yet). */
    function lrRefreshForms(){
        var forms = document.querySelectorAll('form.lr-form');
        for(var i=0;i<forms.length;i++){ lrApplyMode(forms[i]); }
    }

    if(window.jQuery){
        jQuery(function(){
            /* Order matters: the business rules that disable a control run first,
               so the snapshot records them as "was already off". */
            if(typeof bpLockFixedRows === 'function'){ bpLockFixedRows(); }
            lrRefreshForms();
        });
    }

    /* ------------------------------------------------------------------
       E.coli AST panels.

       Each pathotype panel (#astNdiv) is refilled by load-ecoli-ast.php when
       its AST method changes, and now carries the same ESBL / Carbapenemase
       sub-panels keyed by 'E' + prt3_record_id. The triggers read what the
       panel has RECORDED: the interpretation of a typed Disk Diffusion zone,
       or the reader's own MIC interpretation -- never an MIC number.
       ------------------------------------------------------------------ */
    var ECO_MIC_WORD = { 'S':'Susceptible', 'I':'Intermediate', 'R':'Resistant', 'SDD':'SDD', 'N/A':'N/A' };

    /* Interpret one E.coli zone into its result pill, then re-decide the panel. */
    function ecoAstInterpret(input){
        if(!input){ return; }
        var out = document.getElementById(input.id + 'r');
        if(out){
            var raw = (input.value || '').trim();
            var zone = parseFloat(raw);
            if(raw === '' || raw === '-99' || isNaN(zone)){ out.value = ''; }
            else {
                var sus  = parseFloat(input.getAttribute('data-sus'));
                var int1 = parseFloat(input.getAttribute('data-int1'));
                var int2 = parseFloat(input.getAttribute('data-int2'));
                var res  = parseFloat(input.getAttribute('data-res'));
                if(isNaN(sus) || isNaN(res)){ out.value = ''; }
                else {
                    var r = '';
                    if(zone <= res){ r = 'Resistant'; }
                    if(!isNaN(int1) && !isNaN(int2) && zone >= int1 && zone <= int2){ r = 'Intermediate'; }
                    if(zone >= sus){ r = 'Susceptible'; }
                    out.value = r;
                }
            }
        }
        ecoResistanceSyncFrom(input);
        if(typeof lrQueueTones === 'function'){ lrQueueTones(); }
    }

    /* code -> {result, zone} for one panel, from whichever table it is showing. */
    function ecoAstPanelOf(box){
        var out = {}, i;
        if(!box){ return out; }
        var zones = box.querySelectorAll('.eco-zone');
        for(i=0;i<zones.length;i++){
            var code = (zones[i].getAttribute('data-code') || '').toUpperCase();
            if(code === ''){ continue; }
            var res = document.getElementById(zones[i].id + 'r');
            out[code] = { result: res ? res.value : '', zone: (zones[i].value || '').trim() };
        }
        /* Shared MIC grid rows (bdsis_bact_mic_panel_html): each antibiotic has a
           .bp-mic-value input (data-code) and a sibling .bp-mic-result (result word).
           These have the same code-indexed structure bpMicRawValues() reads, so
           ecoResistanceSync -> bpMicResistanceSync can derive the phenotype triggers. */
        var micVals = box.querySelectorAll('.bp-mic-value');
        for(i=0;i<micVals.length;i++){
            var mv = micVals[i];
            var mc = (mv.getAttribute('data-code') || '').toUpperCase();
            if(mc === ''){ continue; }
            /* Sibling .bp-mic-result lives in the same lr-line row. */
            var mrEl = mv.closest ? mv.closest('.bp-mic-row') : null;
            var mr2  = mrEl ? mrEl.querySelector('.bp-mic-result') : null;
            out[mc] = { result: mr2 ? (mr2.value || '') : '', zone: '' };
        }
        /* Backward compat: old free-list rows (.lr-mic__row) -- kept so a panel
           that was saved with the superseded model and not yet re-saved still
           shows its results correctly for the trigger logic. */
        var rows = box.querySelectorAll('.lr-mic__row');
        for(i=0;i<rows.length;i++){
            var c = rows[i].querySelector('.lr-mic__code');
            var p = rows[i].querySelector('.lr-mic__interp');
            if(!c || !p){ continue; }
            var mc2 = (c.value || '').toUpperCase();
            if(mc2 === '' || out[mc2]){ continue; }   // skip if shared grid already set it
            /* SDD and N/A are recorded results but trigger nothing. */
            out[mc2] = { result: ECO_MIC_WORD[p.value] || '', zone: '' };
        }
        return out;
    }

    function ecoResistanceSync(box){
        if(!box){ return; }
        var holder = box.querySelector('.eco-resistance');
        if(!holder){ return; }   /* method Not Required / Pending, or nothing saved to hang results on */
        var idx = holder.getAttribute('data-ecoidx');
        /* MIC method: the panel carries the shared breakpoint grid, so the
           triggers are the MIC phenotype screens (MIC_PHENOTYPE), read from
           the raw values -- exactly what an Enteric Pathogen row does. Disk
           Diffusion keeps reading the interpreted zone pills. */
        if(box.querySelector('.lr-bact-mic')){
            bpMicResistanceSync(idx);
            return;
        }
        bpResistanceApply(idx, ecoAstPanelOf(box));
    }
    function ecoResistanceSyncFrom(el){
        ecoResistanceSync(el && el.closest ? el.closest('.lr-ast-tiles') : null);
    }
    function ecoResistanceSyncAll(){
        var boxes = document.querySelectorAll('.lr-ast-tiles');
        for(var i=0;i<boxes.length;i++){ ecoResistanceSync(boxes[i]); }
    }
    if(window.jQuery){
        /* Delegated: the MIC rows are added, removed and reloaded at will. */
        jQuery(document).on('change', '.lr-mic__interp, .lr-mic__code', function(){ ecoResistanceSyncFrom(this); });
        /* Shared MIC grid (.bp-mic-value) on an E. coli panel: fire ecoResistanceSyncFrom
           so bpMicResistanceSync triggers ESBL/AmpC/CPE panels in real time.
           Bacteriology rows reach bpBactMicInterpret directly via the oninput attribute. */
        jQuery(document).on('input change', '.lr-ast-tiles .bp-mic-value', function(){ ecoResistanceSyncFrom(this); });
        jQuery(function(){ ecoResistanceSyncAll(); });
    }

    /* The plain CTX / CAZ discs are the routine discs, so an empty ESBL zone is
       seeded from the routine zone for the same code. */
    /* Copy the routine reading into a confirmatory plain-disc field, but ONLY
       for an agent the reader has actually started: a method chosen on the
       disc itself or on its clavulanate partner.

       Prefilling every agent unconditionally left a zone with no method on
       agents nobody had touched, and the save refuses exactly that pairing --
       "choose the method for CAZ" on a panel where only CTX had been filled in.
       The reading is still filled in for you; it just waits until the row is
       in use, which is also when it can be right. */
    function bpEsblPrefill(idx, panel){
        var methodOf = function(code){
            var m = document.getElementById('bpEsblMethod'+idx+'_'+code);
            return m ? (m.value||'').trim() : '';
        };
        var setMethodOf = function(code, val){
            var m = document.getElementById('bpEsblMethod'+idx+'_'+code);
            if(m && (m.value||'').trim() === ''){ m.value = val; }
        };
        var partnerOf = function(code){
            for(var j=0;j<BP_ESBL_AGENTS.length;j++){
                if(BP_ESBL_AGENTS[j].pair === code){ return BP_ESBL_AGENTS[j].code; }
            }
            return '';
        };
        for(var i=0;i<BP_ESBL_AGENTS.length;i++){
            var a = BP_ESBL_AGENTS[i]; if(a.pair){ continue; }
            var partner = partnerOf(a.code);
            var ownMethod = methodOf(a.code);
            var partnerMethod = (partner !== '') ? methodOf(partner) : '';
            var started = (ownMethod !== '') || (partnerMethod !== '');
            if(!started){ continue; }
            var z = document.getElementById('bpEsblZone'+idx+'_'+a.code);
            if(z && (z.value||'').trim() === '' && panel[a.code] && panel[a.code].zone !== '' && panel[a.code].zone !== '-99'){
                z.value = panel[a.code].zone;
            }
            if(ownMethod === '' && partnerMethod !== ''){
                setMethodOf(a.code, partnerMethod);
            }
        }
    }

    /* Combination disk: clavulanate disc >= rule mm larger than its plain
       partner = ESBL producer. Decides the interpretation once a pair is
       complete; iu-lab.php applies the same rule on save. */
    /* The routine readings behind a panel, whichever kind of panel it is: a
       pathogen row (numeric index) or an E.coli pathotype ('E' + record id). */
    function bpPanelFor(idx){
        if(String(idx).charAt(0) === 'E'){
            var holder = document.querySelector('.eco-resistance[data-ecoidx="'+idx+'"]');
            var box = (holder && holder.closest) ? holder.closest('.lr-ast-tiles') : null;
            return box ? ecoAstPanelOf(box) : {};
        }
        return bpAstPanelOf(idx);
    }

    function bpEsblInterpret(idx){
        var esbl = document.getElementById('bpEsbl'+idx); if(!esbl){ return; }
        /* Choosing a method puts the row in use, so its plain-disc reading can
           now be carried over from the routine panel. */
        bpEsblPrefill(idx, bpPanelFor(idx));
        var zones = {}, methods = {}, zs = esbl.querySelectorAll('.bp-esbl-zone'), i;
        for(i=0;i<zs.length;i++){
            var code = zs[i].getAttribute('data-code');
            zones[code] = parseFloat(zs[i].value);
            var m = document.getElementById('bpEsblMethod'+idx+'_'+code);
            methods[code] = m ? m.value : '';
        }
        var decided = null;
        for(i=0;i<BP_ESBL_AGENTS.length;i++){
            var a = BP_ESBL_AGENTS[i]; if(!a.pair){ continue; }
            var diffEl = document.getElementById('bpEsblDiff'+idx+'_'+a.code);
            var z1 = zones[a.pair], z2 = zones[a.code];
            if(isNaN(z1) || isNaN(z2)){ if(diffEl){ diffEl.value = ''; } continue; }
            var diff = Math.round((z2 - z1) * 10) / 10;
            if(diffEl){ diffEl.value = (diff >= 0 ? '+' : '') + diff + ' mm'; }
            // ESBL / CARBAPENEMASE CHANGE: both discs of the pair must be combination-disk readings
            if(methods[a.code] !== 'Combination Disk Test' || methods[a.pair] !== 'Combination Disk Test'){ continue; }
            if(diff >= parseFloat(a.rule)){ decided = 'ESBL producer'; break; }
            if(decided === null){ decided = 'Non-ESBL producer'; }
        }
        var out = document.getElementById('bpEsblResult'+idx);
        if(out && decided !== null){ out.value = decided; }
    }

    // START ESBL / CARBAPENEMASE CHANGE
    /* A zone the mCIM / eCIM rules can classify: whole mm, 6 or more.
       Mirrors bdsis_cim_zone_valid(). */
    function bpCimZone(el){
        if(!el){ return NaN; }
        var s = (el.value||'').trim();
        if(s === '' || !/^\d+(\.0+)?$/.test(s)){ return NaN; }
        var z = parseFloat(s);
        return (z >= 6) ? z : NaN;
    }
    function bpReq(el, on){ if(el){ el.setAttribute('data-was-required','1'); el.required = !!on; } }
    function bpShow(el, on){ if(el){ el.style.display = on ? 'block' : 'none'; } }

    /* Carbapenems Test. Method mCIM (or not yet chosen) follows the decision
       rule: 6-15 Positive; 16-18 Positive with colonies else Indeterminate;
       >= 19 Negative, or Indeterminate with colonies; eCIM only on Positive.
       Carba NP / PCR / Other take a stated interpretation; eCIM chosen here is
       refused (it follows a Positive mCIM). Mirrors
       bdsis_bact_resistance_plan() on the server, which has the final say. */
    /* ----- Carbapenemase Screening (Module A, 2026-10-07) -------------------
       Auto-populates the 3 readonly carbapenem rows (EPT / IMI / MER) from the
       routine DD AST above, then computes the Screening Result:
         EPT <= 18 mm  OR  IMI <= 19 mm  OR  MEM <= 19 mm  ->  Positive
         else                                              ->  Negative
       Toggles Module B visibility accordingly. */
    /* ----- Module A perspective (2026-10-14) ---------------------------
       Module A's three screening inputs are dual-perspective, exactly like
       the AmpC Value column: under a DD routine they hold zone diameters in
       mm (Resistant when the zone is SMALL), under a MIC routine they hold
       MIC values in µg/mL (Resistant when the MIC is LARGE). The PHP in
       lab-helpers.php renders the DD wording and tags every mm-specific
       string with data-dd-* / data-mic-* so the copy can follow the row's
       Method instead of lying in MIC mode.

       bpCarbaScreenIsMic reads the row's routine Method select ('02' = MIC)
       rather than trusting a flag, so a stale listener bound in MIC mode
       can cheaply ask what mode the row is in NOW. */
    function bpCarbaScreenIsMic(idx){
        var m = document.getElementById('bpMethod' + idx);
        if(m){ return String(m.value || '').trim() === '02'; }
        /* An E. coli pathotype panel has no per-row method select of its own
           -- the method lives on methoda..methodl, outside the panel, and the
           panel is re-fetched from load-ecoli-ast.php whenever it changes. So
           the question "is this panel in MIC mode" is answered by whether it
           is showing a MIC grid at all. */
        var grid = document.getElementById('bpMic' + idx);
        return !!(grid && grid.style.display !== 'none');
    }

    /* Swap the unit label, the section hint and each input's tooltip to the
       requested perspective. Idempotent -- safe to call on every sync. */
    function bpCarbaScreenModeCopy(idx, mode){
        var cpe = document.getElementById('bpCpe' + idx);
        if(!cpe){ return; }
        var isMic = (mode === 'MIC');
        var units = cpe.querySelectorAll('.bp-cpe-screen-unit');
        for(var i = 0; i < units.length; i++){
            units[i].textContent = isMic ? 'MIC (µg/mL)' : 'Zone (mm)';
        }
        var hint = cpe.querySelector('.bp-cpe-screen-hint');
        if(hint){
            var t = hint.getAttribute(isMic ? 'data-mic-hint' : 'data-dd-hint');
            if(t){ hint.textContent = t; }
        }
        var zs = cpe.querySelectorAll('.bp-cpe-screen-zone');
        for(var j = 0; j < zs.length; j++){
            var tt = zs[j].getAttribute(isMic ? 'data-mic-title' : 'data-dd-title');
            if(tt){ zs[j].setAttribute('title', tt); }
        }
    }

    /* Undo bpCarbaScreenSyncMic's unlock when the row goes back to a DD
       routine. Without this the data-mic-unlocked sentinel was one-way: a
       row switched from MIC to DD kept hand-editable Module A inputs with a
       "MIC µg/mL" placeholder, while the DD sync overwrote whatever was
       typed on every AST keystroke. Values are NOT cleared here -- the DD
       sync repopulates them from the routine panel on the same pass. */
    function bpCarbaScreenRelock(idx){
        var cpe = document.getElementById('bpCpe' + idx);
        if(!cpe){ return; }
        var zs = cpe.querySelectorAll('.bp-cpe-screen-zone');
        for(var i = 0; i < zs.length; i++){
            zs[i].removeAttribute('readonly');
            zs[i].removeAttribute('tabindex');
            zs[i].removeAttribute('pattern');
            zs[i].setAttribute('type', 'number');
            zs[i].setAttribute('min', '0');
            zs[i].setAttribute('max', '512');
            zs[i].setAttribute('step', 'any');
            zs[i].setAttribute('placeholder', 'Zone');
            zs[i].removeAttribute('data-mic-unlocked');
        }
    }

    var CARBA_SCREEN_CODES = ['EPT', 'IMI', 'MER'];
    /* Module A's three rows are named in the DD spelling (EPT / IMI / MER --
       the same codes bdsis_bact_trigger_codes() and the DD antibiogram use),
       but the routine MIC panel names the identical drugs ETP / IPM / MEM
       (bdsis_bact_mic_breakpoints, bacteriology_mic_table, MIC_PHENOTYPE). */
    var CARBA_SCREEN_MIC_SOURCES = { EPT: 'ETP', IMI: 'IPM', MER: 'MEM' };
    function bpCarbaScreenMicSource(code){
        return CARBA_SCREEN_MIC_SOURCES[code] || code;
    }

    /* Evaluates clinical breakpoints for Module A:
       - EPT (10 µg): Resistant <= 18 mm (screening cutoff < 22 mm), Intermediate 19-21 mm, Susceptible >= 22 mm
       - IMI (10 µg): Resistant <= 19 mm (screening alert < 23 mm), Intermediate 20-22 mm, Susceptible >= 23 mm
       - MER (10 µg): Resistant <= 19 mm (screening alert < 23 mm), Intermediate 20-22 mm, Susceptible >= 23 mm */
    function bpCarbaScreenInterpretCode(code, val, isMic){
        var s = String(val == null ? '' : val).trim();
        if(s === '' || s === '-99'){ return ''; }
        var m = s.match(/\d+(\.\d+)?/);
        if(!m){ return ''; }
        var num = parseFloat(m[0]);
        if(isNaN(num)){ return ''; }

        if(isMic){
            var micThr = (code === 'EPT') ? 1 : 2;
            return (num > micThr) ? 'Resistant' : 'Susceptible';
        }

        if(code === 'EPT'){
            if(num <= 18){ return 'Resistant'; }
            if(num >= 19 && num <= 21){ return 'Intermediate'; }
            if(num >= 22){ return 'Susceptible'; }
        } else if(code === 'IMI'){
            if(num <= 19){ return 'Resistant'; }
            if(num >= 20 && num <= 22){ return 'Intermediate'; }
            if(num >= 23){ return 'Susceptible'; }
        } else if(code === 'MER'){
            if(num <= 19){ return 'Resistant'; }
            if(num >= 20 && num <= 22){ return 'Intermediate'; }
            if(num >= 23){ return 'Susceptible'; }
        }
        return '';
    }

    /* Handles manual input directly into Module A with bidirectional sync to AST grid */
    function bpCarbaScreenManualInput(inputEl, idx, code){
        if(!inputEl){ return; }
        var val = (inputEl.value || '').trim();
        var lCode = code.toLowerCase();

        // 1. Sync value to hidden submission input
        var hidZ = document.getElementById(lCode + '_zone_mm_' + idx) || document.getElementById(lCode + '_zone_mm');
        if(hidZ){ hidZ.value = val; }
        var hidVal = document.getElementById(lCode + '_val_' + idx) || document.getElementById(lCode + '_val');
        if(hidVal){ hidVal.value = val; }

        // 2. Bidirectional sync back to primary AST grid
        var isMic = (typeof bpCarbaScreenIsMic === 'function') && bpCarbaScreenIsMic(idx);
        if(isMic){
            var micBox = document.getElementById('bpMic' + idx);
            if(micBox){
                var want = (typeof bpCarbaScreenMicSource === 'function') ? bpCarbaScreenMicSource(code) : code;
                var micIns = micBox.querySelectorAll('.bp-mic-value');
                for(var k = 0; k < micIns.length; k++){
                    if((micIns[k].getAttribute('data-code') || '').toUpperCase() === want){
                        micIns[k].value = val;
                        if(typeof bpBactMicInterpret === 'function'){ bpBactMicInterpret(micIns[k]); }
                        break;
                    }
                }
            }
        } else {
            // E. coli AST grid (.eco-zone)
            var ecoliBox = inputEl.closest ? inputEl.closest('.lr-ast-tiles') : null;
            if(!ecoliBox){
                ecoliBox = document.querySelector('.lr-ast-tiles[data-ecoidx="' + idx + '"]') || document.getElementById('bpAst');
            }
            if(ecoliBox){
                var ecoIn = ecoliBox.querySelector('.eco-zone[data-code="' + code + '"]');
                if(ecoIn){
                    ecoIn.value = val;
                    if(typeof ecoAstInterpret === 'function'){ ecoAstInterpret(ecoIn); }
                }
            }
            // Non-E. coli bacteriology panel (.bp-zone)
            var bactZone = document.querySelector('.bp-zone[data-code="' + code + '"][data-idx="' + idx + '"]');
            if(bactZone){
                bactZone.value = val;
                if(typeof bpAstInterpret === 'function'){ bpAstInterpret(bactZone); }
            }
        }

        // 3. Re-evaluate Module A interpretations and trigger states
        if(isMic){
            if(typeof bpCarbaScreenSyncMic === 'function'){ bpCarbaScreenSyncMic(idx); }
        } else {
            if(typeof bpCarbaScreenSync === 'function'){ bpCarbaScreenSync(idx); }
        }
    }

    function bpCarbaScreenSync(idx){
        var cpe = document.getElementById('bpCpe'+idx);
        if(!cpe){ return; }
        bpCarbaScreenRelock(idx);
        bpCarbaScreenModeCopy(idx, 'DD');
        var panel = (typeof bpAstPanelOf === 'function') ? bpAstPanelOf(idx) : {};

        var ecoliBox = document.querySelector('.lr-ast-tiles[data-ecoidx="' + idx + '"]');
        if(!ecoliBox && cpe.closest){
            ecoliBox = cpe.closest('.lr-ast-tiles');
        }

        var anyThresholdMet = false;
        var testedCount = 0;
        var triggeredAgents = [];

        for(var i=0; i<CARBA_SCREEN_CODES.length; i++){
            var code = CARBA_SCREEN_CODES[i];
            var lCode = code.toLowerCase();
            var zEl = document.getElementById('bpCarbaScreenZone'+idx+'_'+code);
            var rEl = document.getElementById('bpCarbaScreenInterp'+idx+'_'+code);
            if(!zEl){ continue; }

            zEl.removeAttribute('readonly');
            zEl.removeAttribute('tabindex');

            var src = panel[code] || {};
            var zone = (src.zone != null && String(src.zone).trim() !== '') ? String(src.zone).trim() : '';

            // If empty in panel, check .eco-zone input in E. coli AST tiles
            if(zone === '' && ecoliBox){
                var ecoIn = ecoliBox.querySelector('.eco-zone[data-code="' + code + '"]');
                if(ecoIn && ecoIn.value != null && String(ecoIn.value).trim() !== ''){
                    zone = String(ecoIn.value).trim();
                }
            }

            // Auto-pull into zEl if zEl is not currently focused by user
            if(document.activeElement !== zEl){
                if(zone !== '' && zone !== '-99'){
                    zEl.value = zone;
                }
            }

            var currentVal = String(zEl.value || '').trim();
            var hidZ = document.getElementById(lCode + '_zone_mm_' + idx) || document.getElementById(lCode + '_zone_mm');
            if(hidZ){ hidZ.value = currentVal; }
            var hidVal = document.getElementById(lCode + '_val_' + idx) || document.getElementById(lCode + '_val');
            if(hidVal){ hidVal.value = currentVal; }

            if(currentVal === '' || currentVal === '-99'){
                if(rEl){ rEl.value = ''; }
                var hidI = document.getElementById(lCode + '_interpretation_' + idx) || document.getElementById(lCode + '_interpretation');
                if(hidI){ hidI.value = ''; }
                continue;
            }

            testedCount++;
            var interp = bpCarbaScreenInterpretCode(code, currentVal, false);
            if(rEl){ rEl.value = interp; }
            var hidI = document.getElementById(lCode + '_interpretation_' + idx) || document.getElementById(lCode + '_interpretation');
            if(hidI){ hidI.value = interp; }

            /* Trigger condition: Resistant or below screening cutoff / alert (< 22 for EPT, < 23 for IMI/MER) */
            if(interp === 'Resistant' || interp === 'Intermediate'){
                anyThresholdMet = true;
                triggeredAgents.push(code);
            }
        }

        var screenEl = document.getElementById('bpCpeScreenResult'+idx);
        var screening = anyThresholdMet ? 'Positive' : (testedCount > 0 ? 'Negative' : '');
        if(screenEl){ screenEl.value = screening; }
        var hidScr = document.getElementById('carbapenemase_screening_result_' + idx) || document.getElementById('carbapenemase_screening_result');
        if(hidScr){ hidScr.value = screening; }
        var hidScrAlias = document.getElementById('carbapenemase_screen_res_' + idx) || document.getElementById('carbapenemase_screen_res');
        if(hidScrAlias){ hidScrAlias.value = screening; }

        var whyC = cpe.querySelector('.bp-cpe-why');
        if(whyC){
            if(triggeredAgents.length > 0){
                whyC.textContent = triggeredAgents.join(', ');
            } else {
                whyC.textContent = '';
            }
        }

        /* Module B appears only when screening is Positive. */
        var moduleB = document.getElementById('bpCpeModuleB'+idx);
        var showB = (screening === 'Positive');
        if(moduleB){
            moduleB.style.display = showB ? 'block' : 'none';
            if(typeof bpSetRequiredWithin === 'function'){
                bpSetRequiredWithin(moduleB, false);
            }
        }
        var fin = document.getElementById('bpCpeResult'+idx);
        if(!showB){
            if(fin){
                if(screening === 'Negative'){
                    fin.value = 'Carbapenemase not detected';
                } else if(screening === ''){
                    fin.value = '';
                }
            }
        } else {
            if(typeof bpMcimInterpret === 'function'){ bpMcimInterpret(idx); }
        }
        if(fin){
            var hidFin = document.getElementById('final_carbapenemase_result_' + idx) || document.getElementById('final_carbapenemase_result');
            if(hidFin){ hidFin.value = fin.value; }
            var hidFinAlias = document.getElementById('final_carbapenemase_res_' + idx) || document.getElementById('final_carbapenemase_res');
            if(hidFinAlias){ hidFinAlias.value = fin.value; }
        }
    }

    /* bpCarbaScreenSyncMic -- MIC-mode counterpart to bpCarbaScreenSync
       (2026-10-12). Called from bpMicResistanceSync whenever the CPE panel
       is visible under a MIC-routine isolate. For each of the three Module
       A screening agents (EPT / IMI / MER):
         (a) Pull the routine MIC value from the matching .bp-mic-value
             input in the routine panel into the Module A screening Zone
             input -- only when the Module A input is empty, so a user
             edit or a saved value is never overwritten.
         (b) Unlock the Module A input (remove readonly / tabindex, add
             step="any" + placeholder) and attach an onInput handler so
             the user can type directly in Module A when the routine
             panel hasn't been filled yet. The handler mirrors edits
             back to the routine MIC input (so the value saves via the
             existing bacteriology_mic_table pipeline -- Module A has no
             dedicated columns on bacteriology_resistance_table).
         (c) Derive the per-agent S/R interpretation per the MIC
             thresholds: EPT > 1 ug/mL -> Resistant, IMI/MEM > 2 ug/mL
             -> Resistant; otherwise Susceptible.
       Then compute the Screening Result (Positive when any agent is
       Resistant, else Negative) and toggle Module B's visibility. The
       interpretation thresholds here are the SCREENING thresholds asked
       for by the client; they are intentionally stricter than
       MIC_PHENOTYPE.cpe (the panel-opening trigger) which uses CLSI's
       lowest R-adjacent floors (ETP > 0.5, IPM > 1, MEM > 1). */
    var MIC_CARBA_SCREEN_THR = { EPT: 1, IMI: 2, MER: 2 };
    function bpCarbaScreenSyncMic(idx){
        var cpe = document.getElementById('bpCpe'+idx);
        if(!cpe){ return; }
        var micBox = document.getElementById('bpMic'+idx);
        if(!micBox){ return; }
        /* Label the column, the hint and the tooltips in MIC terms before
           anything is written, so the user never reads "Zone (mm)" above a
           field holding a MIC. */
        bpCarbaScreenModeCopy(idx, 'MIC');

        /* Snapshot routine MIC inputs by code so we can prefill AND mirror
           edits back to persist via the routine save path. */
        var routineInputs = {};
        var routineVals   = {};
        var micIns = micBox.querySelectorAll('.bp-mic-value');
        for(var ri=0; ri<micIns.length; ri++){
            var rCode = (micIns[ri].getAttribute('data-code') || '').toUpperCase();
            if(!rCode){ continue; }
            routineInputs[rCode] = micIns[ri];
            var rawV = String(micIns[ri].value || '').trim();
            if(rawV !== ''){ routineVals[rCode] = rawV; }
        }

        var anyR = false, hasAny = false;
        for(var si=0; si<CARBA_SCREEN_CODES.length; si++){
            var sc  = CARBA_SCREEN_CODES[si];
            var zEl = document.getElementById('bpCarbaScreenZone'+idx+'_'+sc);
            var rEl = document.getElementById('bpCarbaScreenInterp'+idx+'_'+sc);
            if(!zEl){ continue; }

            /* Unlock + wire the onInput handler once per element.
               data-mic-unlocked acts as the idempotency sentinel so a
               re-run of bpMicResistanceSync doesn't rebind the handler. */
            if(zEl.getAttribute('data-mic-unlocked') !== '1'){
                zEl.removeAttribute('readonly');
                zEl.removeAttribute('tabindex');
                zEl.removeAttribute('pattern');
                zEl.setAttribute('data-mic-unlocked', '1');
                zEl.setAttribute('type', 'number');
                zEl.setAttribute('min', '0');
                zEl.setAttribute('max', '512');
                zEl.setAttribute('step', 'any');
                zEl.setAttribute('placeholder', 'MIC µg/mL');
                /* Mirror the user's edit back into the routine MIC input of
                   the same code so the value persists via bacteriology_mic_table
                   on save. Direct .value assignment does NOT fire a secondary
                   input event, so this is loop-safe. */
                (function(myZ, myCode){
                    myZ.addEventListener('input', function(){
                        /* The listener outlives MIC mode -- it cannot be
                           unbound once the row switches back to a DD
                           routine -- so it asks what mode the row is in now
                           and goes inert in DD rather than writing into a
                           MIC panel that is no longer the active one. */
                        if(!bpCarbaScreenIsMic(idx)){ return; }
                        /* Re-query the routine input instead of using the
                           snapshot captured at bind time: the MIC panel is
                           re-rendered when the method or pathogen changes,
                           which would leave the closure holding a detached
                           node and silently drop the mirrored value. */
                        var box = document.getElementById('bpMic' + idx);
                        if(box){
                            var want = bpCarbaScreenMicSource(myCode);
                            var ins = box.querySelectorAll('.bp-mic-value');
                            for(var k = 0; k < ins.length; k++){
                                if((ins[k].getAttribute('data-code') || '').toUpperCase() === want){
                                    ins[k].value = myZ.value;
                                    /* The routine input owns the persisted value, so let
                                       its own handler recompute the routine CLSI pill --
                                       a bare .value assignment fires no event. */
                                    if(typeof bpBactMicInterpret === 'function'){
                                        bpBactMicInterpret(ins[k]);
                                    }
                                    break;
                                }
                            }
                        }
                        bpCarbaScreenSyncMic(idx);
                    });
                })(zEl, sc);
            }

            /* Prefill empty Module A input from routine MIC panel, looked up
               under the MIC panel's own spelling for this drug. */
            var srcV = routineVals[bpCarbaScreenMicSource(sc)];
            if(String(zEl.value || '').trim() === '' && srcV != null && String(srcV).trim() !== ''){
                var numMatch = String(srcV).match(/\d+(\.\d+)?/);
                zEl.value = (numMatch && zEl.type === 'number') ? numMatch[0] : srcV;
            }

            /* Per-agent MIC-threshold interpretation. */
            var zVal = String(zEl.value || '').trim();
            if(zVal !== ''){ hasAny = true; }
            /* Prefer the threshold the markup carries (data-mic-threshold,
               emitted from $screenRows['micthr'] in lab-helpers.php) so the
               MIC comparator has one source of truth, the same way the DD
               branch reads data-threshold. MIC_CARBA_SCREEN_THR stays as the
               fallback for a panel rendered before 2026-10-14. */
            var thrAttr = parseFloat(zEl.getAttribute('data-mic-threshold'));
            var thr = isNaN(thrAttr) ? MIC_CARBA_SCREEN_THR[sc] : thrAttr;
            var interp = '';
            if(zVal !== '' && thr != null){
                var m = zVal.match(/\d+(\.\d+)?/);
                if(m){
                    var num = parseFloat(m[0]);
                    if(!isNaN(num)){
                        if(num > thr){ interp = 'Resistant'; anyR = true; }
                        else          { interp = 'Susceptible'; }
                    }
                }
            }
            if(rEl){ rEl.value = interp; }
            var lSc = sc.toLowerCase();
            var hidZ = document.getElementById(lSc + '_zone_mm_' + idx) || document.getElementById(lSc + '_zone_mm');
            if(hidZ){ hidZ.value = zVal; }
            var hidVal = document.getElementById(lSc + '_val_' + idx) || document.getElementById(lSc + '_val');
            if(hidVal){ hidVal.value = zVal; }
            var hidI = document.getElementById(lSc + '_interpretation_' + idx) || document.getElementById(lSc + '_interpretation');
            if(hidI){ hidI.value = interp; }
        }

        /* Screening Result pill: Positive when any agent Resistant; empty
           when no agent is populated (so edit mode doesn't force "Negative"
           on an untouched panel). */
        var screenEl = document.getElementById('bpCpeScreenResult'+idx);
        var screening = hasAny ? (anyR ? 'Positive' : 'Negative') : '';
        if(screenEl){
            screenEl.value = screening;
        }
        var hidScr = document.getElementById('carbapenemase_screening_result_' + idx) || document.getElementById('carbapenemase_screening_result');
        if(hidScr){ hidScr.value = screening; }
        var hidScrAlias = document.getElementById('carbapenemase_screen_res_' + idx) || document.getElementById('carbapenemase_screen_res');
        if(hidScrAlias){ hidScrAlias.value = screening; }

        var whyC = cpe.querySelector('.bp-cpe-why');
        if(whyC){
            if(hasAny && anyR){
                var trigAgents = [];
                for(var ti=0; ti<CARBA_SCREEN_CODES.length; ti++){
                    var tCode = CARBA_SCREEN_CODES[ti];
                    var tInterpEl = document.getElementById('bpCarbaScreenInterp'+idx+'_'+tCode);
                    if(tInterpEl && tInterpEl.value === 'Resistant'){
                        trigAgents.push(tCode);
                    }
                }
                whyC.textContent = trigAgents.join(', ');
            } else {
                whyC.textContent = '';
            }
        }

        /* Module B visibility follows Screening = Positive. MIC mode keeps
           its inputs non-required (section-aware server validation decides
           on save). */
        var moduleB = document.getElementById('bpCpeModuleB'+idx);
        var showB = (hasAny && anyR);
        if(moduleB){
            moduleB.style.display = showB ? 'block' : 'none';
            if(typeof bpSetRequiredWithin === 'function'){
                bpSetRequiredWithin(moduleB, false);
            }
        }
        if(!showB){
            var fin = document.getElementById('bpCpeResult'+idx);
            if(fin){
                fin.value = (hasAny && !anyR) ? 'Carbapenemase not detected' : '';
            }
        } else {
            if(typeof bpMcimInterpret === 'function'){ bpMcimInterpret(idx); }
        }
        var finEl = document.getElementById('bpCpeResult'+idx);
        if(finEl){
            var hidFin = document.getElementById('final_carbapenemase_result_' + idx) || document.getElementById('final_carbapenemase_result');
            if(hidFin){ hidFin.value = finEl.value; }
            var hidFinAlias = document.getElementById('final_carbapenemase_res_' + idx) || document.getElementById('final_carbapenemase_res');
            if(hidFinAlias){ hidFinAlias.value = finEl.value; }
        }
    }

    function bpMcimInterpret(idx){
        /* Module B (Carbapenemase Confirmation) -- method is always mCIM in
           the 2026-10-07 redesign. Reads the mCIM zone alone and writes
           Positive / Negative / Indeterminate into #bpMcimResult. The
           "Point Colonies within zone?" Yes/No tie-breaker was retired on
           2026-10-10 at the client's request. */
        var cpe = document.getElementById('bpCpe'+idx);
        var zEl = document.getElementById('bpMcimZone'+idx);
        var out = document.getElementById('bpMcimResult'+idx), fin = document.getElementById('bpCpeResult'+idx);
        var ecim = document.getElementById('bpEcim'+idx), na = document.getElementById('bpEcimNa'+idx);
        if(!zEl || !out){ return; }
        var moduleB = document.getElementById('bpCpeModuleB'+idx);
        var active = !!(cpe && cpe.style.display !== 'none')
                  && !!(moduleB && moduleB.style.display !== 'none');

        if(zEl){
            zEl.required = false;
            zEl.removeAttribute('data-was-required');
        }

        var r = '';
        var z = bpCimZone(zEl);
        /* 2026-10-10 spec (zone-only, no Yes/No tie-breaker):
             zone >= 19 (clear)   -> Negative
             zone 16-18           -> Indeterminate   (repeat testing)
             zone 6-15            -> Positive                           */
        if(!isNaN(z)){
            if(z >= 19)      { r = 'Negative'; }
            else if(z <= 15) { r = 'Positive'; }
            else             { r = 'Indeterminate'; }
        }
        out.value = r;

        var hidMcimZ = document.getElementById('mcim_val_' + idx) || document.getElementById('mcim_val');
        if(hidMcimZ){ hidMcimZ.value = (!isNaN(z)) ? String(z) : ''; }
        var hidMcimR = document.getElementById('mcim_res_' + idx) || document.getElementById('mcim_res');
        if(hidMcimR){ hidMcimR.value = r; }

        /* mCIM / eCIM Combination Test opens only when mCIM is Positive. */
        var showE = (r === 'Positive');
        if(ecim){
            bpShow(ecim, showE);
            if(typeof bpSetRequiredWithin === 'function'){
                bpSetRequiredWithin(ecim, false);
            }
        }
        if(na){ bpShow(na, !showE); }

        /* Keep the mCIM zone pre-fill in the combination row current. */
        var combMcim = document.getElementById('bpCombMcimZone'+idx);
        if(combMcim){ combMcim.value = (!isNaN(z)) ? String(Math.round(z)) : ''; }

        if(showE){ bpEcimInterpret(idx); return; }
        /* mCIM Negative / Indeterminate -> clear eCIM data and write the
           final result directly (spec: Negative -> "Carbapenemase not detected",
           Indeterminate -> "Testing inconclusive"). */
        var eo = document.getElementById('bpEcimResult'+idx); if(eo){ eo.value = ''; }
        var ez = document.getElementById('bpEcimZone'+idx);   if(ez){ ez.value = ''; }
        var diff = document.getElementById('bpEcimDiff'+idx); if(diff){ diff.value = ''; }
        if(!fin){ return; }
        fin.value = (r === 'Negative') ? 'Carbapenemase not detected'
                  : (r === 'Indeterminate') ? 'Testing inconclusive' : '';
        var hidFin = document.getElementById('final_carbapenemase_result_' + idx) || document.getElementById('final_carbapenemase_result');
        if(hidFin){ hidFin.value = fin.value; }
        var hidFinAlias = document.getElementById('final_carbapenemase_res_' + idx) || document.getElementById('final_carbapenemase_res');
        if(hidFinAlias){ hidFinAlias.value = fin.value; }
        return;
    }

