            /* The first pathogen is mandatory, so it cannot be removed; neither is
               a row an E.coli PCR / AST result was derived from. */
            var fixed = (blocks[i].getAttribute('data-locked') === '1');
            if(btn){ btn.style.display = (i===0 || fixed) ? 'none' : ''; }
        }
    }

    /* Removal happens ONLY from the red Remove button. `ev` is optional so any
       legacy removePathogenRow(this) call still works. */
    function removePathogenRow(el, ev){
        if(ev){
            /* Keep the click here: nothing above may act on it, and it must not
               submit or scroll the form. */
            if(ev.stopPropagation){ ev.stopPropagation(); }
            if(ev.preventDefault){ ev.preventDefault(); }
        }
        var block = el.closest ? el.closest('.pathogen-block') : null;
        if(!block || !block.parentNode){ return; }
        /* Enteric Pathogen 1 is mandatory: never removable, whatever reaches
           here. renumberPathogenRows() hides its button; this makes it real. */
        if(block === block.parentNode.firstElementChild){ return; }
        block.parentNode.removeChild(block);
        /* Indexes are deliberately NOT re-written: the backend compacts the
           surviving rows into P1..Pn by position, so gaps are harmless. */
        renumberPathogenRows();
    }

    function addPathogenRow(){
        var tpl = document.getElementById('pathogenRowTemplate');
        var host = document.getElementById('pathogenRows');
        if(!tpl || !host){ return; }
        var markup = tpl.innerHTML.split('__IDX__').join(bpNextIdx);
        var wrap = document.createElement('div');
        wrap.innerHTML = markup;
        var node = wrap.firstElementChild;
        if(!node){ return; }
        host.appendChild(node);
        bpNextIdx++;
        // Cloned rows use native date inputs; nothing to re-initialise.
        renumberPathogenRows();
        displayASTRow(bpNextIdx-1);
        bpResistanceSync(bpNextIdx-1);
    }

