    /* --------------------------------------------------------------
       Result tones (presentation only -- lab-results.css).

       Colours each result field from its CURRENT value: soft red for
       Resistant / Positive / producer / MBL / serine, amber for
       Intermediate / Indeterminate, green for Susceptible / Negative.
       The interpretation functions set .value, which fires no event and
       changes no attribute, so nothing can observe them directly;
       instead a capture-phase listener queues one repaint after any
       input, change or click -- by the time the queued task runs, every
       handler of that event has finished and written its result (a
       timer, not requestAnimationFrame, which never fires while the tab
       is in the background). The
       E.coli AST panels arrive by AJAX, hence the ajaxComplete hook.
       Nothing here reads or writes a value.
       -------------------------------------------------------------- */
    var LR_TONE_FIELDS = '.bp-astresult, .bp-mic-result, .eco-astresult, .bp-esbl-diff, [id^="bpMcimResult"], [id^="bpEcimResult"], '
                       + '[id^="bpCpeResult"], [id^="bpCarbaNpResult"], [id^="bpCarbaNpInterp"], '
                       + 'select[id^="bpEsblResult"], select[id^="bpCpeInterp"], [id^="bpEcimNaText"], .lr-ast-tiles em, '
                       + 'select.lr-mic__interp';
    function lrToneOf(v){
        v = String(v || '').trim().toLowerCase();
        if(v === ''){ return 'empty'; }
        /* MIC interpretation codes (select values). */
        if(v === 's'){ return 'success'; }
        if(v === 'i' || v === 'sdd'){ return 'warning'; }
        if(v === 'r'){ return 'danger'; }
        if(v === 'n/a'){ return 'muted'; }
        if(v.indexOf('not required') > -1 || v.indexOf('not applicable') > -1){ return 'muted'; }
        if(v.indexOf('non-esbl') > -1 || /(^|\s)(susceptible|sensitive|negative)$/.test(v)){ return 'success'; }
        if(v.indexOf('intermediate') > -1 || v.indexOf('indeterminate') > -1){ return 'warning'; }
        if(/(^|\s)(resistant|positive)$/.test(v) || v.indexOf('producer') > -1 || v.indexOf('detected') > -1){ return 'danger'; }
        return 'info';
    }
    function lrApplyTones(){
        var els = document.querySelectorAll(LR_TONE_FIELDS);
        for(var i=0;i<els.length;i++){
            var el = els[i];
            var v  = (el.tagName === 'EM') ? el.textContent : el.value;
            /* A zone difference is a reading, not a verdict: neutral when present. */
            var t  = el.classList.contains('bp-esbl-diff') ? (String(v||'').trim() === '' ? 'empty' : 'info') : lrToneOf(v);
            if(el.getAttribute('data-tone') !== t){ el.setAttribute('data-tone', t); }
        }
    }
    var lrToneQueued = false;
    function lrQueueTones(){
        if(lrToneQueued){ return; }
        lrToneQueued = true;
        setTimeout(function(){ lrToneQueued = false; lrApplyTones(); }, 0);
    }
    document.addEventListener('input',  lrQueueTones, true);
    document.addEventListener('change', lrQueueTones, true);
    document.addEventListener('click',  lrQueueTones, true);
    window.addEventListener('load', lrQueueTones);
    if(window.jQuery){ jQuery(document).ajaxComplete(lrQueueTones); jQuery(lrQueueTones); }

    /* --------------------------------------------------------------
       E. coli AST -- MIC entries (includes/lab-mic.php renders them;
       load-ecoli-ast.php returns the panel when the method is MIC).

       Each panel keeps its entries as rows in the DOM; that IS the state:
         row  data-mic-id = entry id (UUID v4, kept across saves)
         mic[<pathotype record>][<id>][code|value|interp]
       Add clones the panel's <template> under a fresh id; Remove drops
       the row. bdsisMicSync() disables, in every row, the antibiotics
       already chosen in another row (no duplicates), keeps the count
       and empty state current, and hides Add once every antibiotic is
       used. iu-lab.php re-checks all of it on save.
       -------------------------------------------------------------- */
    function bdsisUuid(){
        var c = window.crypto || window.msCrypto;
        if(c && typeof c.randomUUID === 'function'){ return c.randomUUID(); }
        var b = new Uint8Array(16);
        if(c && c.getRandomValues){ c.getRandomValues(b); }
        else { for(var i=0;i<16;i++){ b[i] = Math.floor(Math.random()*256); } }
        b[6] = (b[6] & 0x0f) | 0x40;
        b[8] = (b[8] & 0x3f) | 0x80;
        var h = [];
        for(var j=0;j<16;j++){ h.push((b[j] + 0x100).toString(16).slice(1)); }
        return h.slice(0,4).join('') + '-' + h.slice(4,6).join('') + '-' + h.slice(6,8).join('') + '-' + h.slice(8,10).join('') + '-' + h.slice(10).join('');
    }
    function bdsisMicPanel(el){ return (el && el.closest) ? el.closest('.lr-mic') : null; }

    function bdsisMicSync(elOrPanel){
        var panel = (elOrPanel && elOrPanel.classList && elOrPanel.classList.contains('lr-mic')) ? elOrPanel : bdsisMicPanel(elOrPanel);
        if(!panel){ return; }
        var rows = panel.querySelectorAll('.lr-mic__rows .lr-mic__row');
        var used = {}, i, j;
        for(i=0;i<rows.length;i++){
            var sel = rows[i].querySelector('select.lr-mic__code');
            if(sel && sel.value){ used[sel.value] = (used[sel.value] || 0) + 1; }
        }
        for(i=0;i<rows.length;i++){
            var s = rows[i].querySelector('select.lr-mic__code');
            if(!s){ continue; }
            for(j=0;j<s.options.length;j++){
                var o = s.options[j];
                if(o.value === ''){ continue; }
                o.disabled = (o.value !== s.value) && !!used[o.value];
            }
        }
        var max = parseInt(panel.getAttribute('data-mic-max'), 10) || 0;
        var empty = panel.querySelector('.lr-mic__empty');
        if(empty){ empty.style.display = rows.length ? 'none' : ''; }
        var count = panel.querySelector('.lr-mic__count');
        if(count){ count.textContent = rows.length; }
        var add = panel.querySelector('.lr-mic__add');
        if(add){ add.style.display = (max && rows.length >= max) ? 'none' : ''; }
    }

    function bdsisMicAdd(btn){
        var panel = bdsisMicPanel(btn);
        if(!panel){ return; }
        var tpl  = panel.querySelector('template.lr-mic__tpl');
        var host = panel.querySelector('.lr-mic__rows');
        if(!tpl || !host){ return; }
        var wrap = document.createElement('div');
        wrap.innerHTML = tpl.innerHTML.split('__UUID__').join(bdsisUuid());
        var row = wrap.firstElementChild;
        if(!row){ return; }
        host.appendChild(row);
        bdsisMicSync(panel);
        var first = row.querySelector('select.lr-mic__code');
        if(first){ first.focus(); }
    }

    function bdsisMicRemove(btn){
        var row = (btn && btn.closest) ? btn.closest('.lr-mic__row') : null;
        var panel = bdsisMicPanel(btn);
        if(!row || !panel){ return; }
        /* Keep focus inside the panel for keyboard users. */
        var next = row.nextElementSibling || row.previousElementSibling;
        row.parentNode.removeChild(row);
        bdsisMicSync(panel);
        var target = next ? next.querySelector('select.lr-mic__code') : panel.querySelector('.lr-mic__add');
        if(target){ target.focus(); }
    }

