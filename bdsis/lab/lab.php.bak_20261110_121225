                     #bpMic{idx} — new MIC entry grid (per MIC Document)
                   JS `bpSetAstMethod()` shows one and hides the other based on
                   the Method dropdown above. Default is Disk Diffusion for
                   historical compatibility. */
                $isMic = ($method === '02');
                $h .= '<div class="lr-ast" id="bpAst'.$idx.'" style="'.$astStyle.'">';
                $h .= '<div class="lr-ast-dd" id="bpDd'.$idx.'" style="display:'.($isMic ? 'none' : 'block').';">';
                $h .= '<div class="lr-subcard lr-subcard--ast">';
                $h .= '<div class="lr-subcard__head"><h4 class="lr-subcard__title">Antimicrobial Susceptibility</h4>'
                    . '<span class="lr-subcard__meta">Disk diffusion &middot; interpreted as you type</span></div>';
                /* Zone is optional: not all antibiotics are tested for every isolate,
                   so the user may leave a row blank. An empty zone flows through the
                   iu-lab.php DELETE branch alongside the "-99" sentinel and no phantom
                   zone_diameter=0 row is written. */
                $h .= '<div class="row lr-grid-head d-none d-md-flex"><div class="col-md-3">Antibiotic</div><div class="col-md-3">Method</div>'
                    . '<div class="col-md-2">Zone (mm)</div><div class="col-md-4">Interpretation</div></div>';
                $j = 0;
                $nAst = count($astRows);
                foreach($astRows as $a){
                    $agentTxt = htmlspecialchars($a['agent'], ENT_QUOTES);
                    $zoneId   = 'bpZone'.$idx.'_'.$j;
                    $h .= '<div class="row lr-line'.($j === $nAst - 1 ? ' lr-line--last' : '').'">';
                    $h .= '<div class="col-md-3 lr-cell lr-cell--name"><span class="lr-agent">'.$agentTxt.'</span>';
                    $h .= '<input type="hidden" name="code['.$idx.']['.$j.']" value="'.htmlspecialchars($a['code'], ENT_QUOTES).'" /></div>';
                    $h .= '<div class="col-md-3 lr-cell d-none d-md-block"><span class="lr-chip">Disk Diffusion</span></div>';
                    /* Breakpoints travel with the field so bpAstInterpret() can fill the
                       result as the user types, using the very numbers iu-lab.php applies
                       on save. Reading them from ms_ast_table rather than hardcoding a
                       table in JS is what stops the two from drifting apart. */
                    $h .= '<div class="col-6 col-md-2 lr-cell"><label class="lr-cell-label" for="'.$zoneId.'">Zone (mm)<span class="sr-only">, '.$agentTxt.'</span>:</label>';
                    $h .= '<input type="number" name="zone['.$idx.']['.$j.']" id="'.$zoneId.'" value="'.htmlspecialchars((string)$a['zone'], ENT_QUOTES).'"'
                        . ' class="form-control text-center bp-zone"'
                        . ' data-sus="'.htmlspecialchars((string)$a['sus'], ENT_QUOTES).'"'
                        . ' data-int1="'.htmlspecialchars((string)$a['int1'], ENT_QUOTES).'"'
                        . ' data-int2="'.htmlspecialchars((string)$a['int2'], ENT_QUOTES).'"'
                        . ' data-res="'.htmlspecialchars((string)$a['res'], ENT_QUOTES).'"'
                        . ' oninput="bpAstInterpret(this); bpResistanceSync(bpBlockIdx(this));" /></div>';
                    $h .= '<div class="col-6 col-md-4 lr-cell"><label class="lr-cell-label" for="'.$zoneId.'r">Result<span class="sr-only">, '.$agentTxt.'</span>:</label>';
                    $h .= '<input type="text" id="'.$zoneId.'r" value="'.htmlspecialchars((string)$a['rslt'], ENT_QUOTES).'" class="form-control lr-pill bp-astresult" readonly tabindex="-1" aria-label="AST result, '.$agentTxt.'" /></div>';
                    $h .= '</div>';
                    $j++;
                }
                $h .= '</div>';   /* close DD subcard */
                $h .= '</div>';   /* /#bpDd{idx} */
                /* MIC sub-panel — sibling of #bpDd{idx}. Hidden by default, revealed
                   by bpSetAstMethod() when the Method dropdown is set to MIC. The
                   saved MIC values (if any) come from bacteriology_mic_table rows
                   for this isolate's record_id. $bdsis is NOT a parameter of this
                   closure, so we read it from the global scope via $GLOBALS to
                   avoid the "Undefined variable $bdsis" warning that would
                   otherwise fire on every pathogen row render. The isset guard
                   is cheap and keeps the helper call defensive even on pages
                   that somehow render the block without the DB handle in scope. */
                $micBdsis = isset($GLOBALS['bdsis']) ? $GLOBALS['bdsis'] : null;
                $micSaved = (isset($row['recid']) && $row['recid'] !== '' && $micBdsis && function_exists('bdsis_bact_mic_load_saved'))
                          ? bdsis_bact_mic_load_saved($micBdsis, (int)$row['recid'])
