        while(list($bpid,$bslot,$bpname)=$ecoliRowQry->fetch_row()){
            if(isset($ecoliBlocks[$bpid])){ $ecoliBlocks[$bpid]['slots'][]=$bslot; continue; }
            if(!bdsis_ecoli_pcr_applies($bdsis, $sid, $bpid)){ continue; }
            $ecoliBlocks[$bpid]=array('ecoli_id'=>$bpid, 'name'=>$bpname, 'slots'=>array($bslot));
        }
