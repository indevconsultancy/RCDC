        var e = bpCimZone(zEl), m = bpCimZone(mEl);
        out.value = (isNaN(e) || isNaN(m)) ? '' : ((e - m) >= 5 ? 'Metallo-β-lactamase (MBL) detected' : 'Serine carbapenemase detected');
        /* Show the difference the call is made on, as the ESBL pair does. */
        var dEl = document.getElementById('bpEcimDiff'+idx);
        if(dEl){ var d = e - m; dEl.value = (isNaN(e) || isNaN(m)) ? '' : ((d >= 0 ? '+' : '') + (Math.round(d * 10) / 10) + ' mm'); }

        var hidEcimZ = document.getElementById('ecim_val_' + idx) || document.getElementById('ecim_val');
        if(hidEcimZ){ hidEcimZ.value = (!isNaN(e)) ? String(e) : ''; }
        var hidEcimR = document.getElementById('ecim_res_' + idx) || document.getElementById('ecim_res');
        if(hidEcimR){ hidEcimR.value = out.value; }

        if(fin){
            fin.value = out.value;
            var hidFin = document.getElementById('final_carbapenemase_result_' + idx) || document.getElementById('final_carbapenemase_result');
            if(hidFin){ hidFin.value = fin.value; }
