    /* ----- Carba NP Decision Engine (standalone, 2026-10-07) ----------------
       Writes BOTH auto-computed outputs for the standalone Carba NP card:
         #bpCarbaNpResult{idx} = System Result   (Positive / Negative / Invalid)
         #bpCarbaNpInterp{idx} = Interpretation  (Carbapenemase producer /
                                                  No carbapenemase detected /
                                                  Invalid)

       4-rule decision matrix (A = Tube A internal control, B = Tube B test):
         Rule 1: A "Red or red-orange" + B "Light orange, dark yellow, or yellow"
                 -> Positive / Carbapenemase producer
         Rule 2: A "Red or red-orange" + B "Red or red-orange"
                 -> Negative / No carbapenemase detected
         Rule 3: A "Red or red-orange" + B "Orange"
                 -> Invalid / Invalid
         Rule 4: A "Orange, light orange, dark yellow or yellow" (bad control)
                 + B anything (incl. "Any color") -> Invalid / Invalid

       Clearing either dropdown resets both outputs to blank. The Carba NP
       card is now a sibling of (not nested inside) the Carbapenemase
       Detection card, so this function does NOT mirror into #bpCpeResult:
       each card presents its own outcome. Server-side
       bdsis_carba_np_result() / bdsis_carba_np_interpret() apply the same
       matrix so a hand-crafted POST cannot bypass the control-integrity
       rule, and the save path uses the Carba NP interpretation as the
       final carbapenemase result only when the mCIM/eCIM flow produced
       none. */
    var CARBA_NP_A_OK      = 'Red or red-orange';
    var CARBA_NP_A_INVALID = 'Orange, light orange, dark yellow or yellow';
    function bpCarbaNpInterpret(idx){
        var aEl = document.getElementById('bpCarbaNpTubeA'+idx);
        var bEl = document.getElementById('bpCarbaNpTubeB'+idx);
        var rEl = document.getElementById('bpCarbaNpResult'+idx);
        var iEl = document.getElementById('bpCarbaNpInterp'+idx);
        if(!aEl || !bEl){ return; }
        var a = aEl.value || '';
        var b = bEl.value || '';
        /* Legacy fallback: an edit-mode record from before 2026-10-07 kept
           an Oxford comma in the Tube A invalid wording. Treat it as the
           same category so the first auto-recalc on open yields the right
           verdict without the user having to re-pick the dropdown. */
        var aNorm = (a === 'Orange, light orange, dark yellow, or yellow') ? CARBA_NP_A_INVALID : a;
        var sysR = '', interp = '';
        if(aNorm !== '' && b !== ''){
            if(aNorm === CARBA_NP_A_INVALID){
                sysR = 'Invalid';  interp = 'Invalid';                                       /* rule 4 */
            } else if(aNorm === CARBA_NP_A_OK){
                if(b === 'Light orange, dark yellow, or yellow'){
                    sysR = 'Positive'; interp = 'Carbapenemase producer';                    /* rule 1 */
                } else if(b === 'Red or red-orange'){
                    sysR = 'Negative'; interp = 'No carbapenemase detected';                 /* rule 2 */
                } else if(b === 'Orange'){
                    sysR = 'Invalid';  interp = 'Invalid';                                   /* rule 3 */
                }
                /* "Any color" with a valid control is undefined by the
                   decision matrix (it only pairs with an invalid control).
                   Leave outputs blank -- the user is signalling the reading
                   is incomplete. */
            }
        }
        if(rEl){ rEl.value = sysR;   }
        if(iEl){ iEl.value = interp; }

        var hA = document.getElementById('carba_tube_a_' + idx); if(hA){ hA.value = a; }
        var hB = document.getElementById('carba_tube_b_' + idx); if(hB){ hB.value = b; }
        var hR = document.getElementById('carba_system_result_' + idx); if(hR){ hR.value = sysR; }
        var hI = document.getElementById('carba_interpretation_' + idx); if(hI){ hI.value = interp; }

        if(typeof lrQueueTones === 'function'){ lrQueueTones(); }
    }

