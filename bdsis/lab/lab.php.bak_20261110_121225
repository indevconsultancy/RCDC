    /* The two AST option sets. E.coli ('025' LF / '026' NLF) records whether the
       E.coli PCR Result section applies to the isolate, so it offers
       Positive/Negative; every other pathogen keeps Required/Not Required. */
    var BP_AST_OPTIONS_STD   = [['','Select Status'],['R','Required'],['NR','Not Required']];
    var BP_AST_OPTIONS_ECOLI = [['','Select Result'],['Positive','Positive'],['Negative','Negative']];

    function bpIsEcoliPathogen(v){
        if(!v) return false;
        var s = String(v).trim();
        return (s === '025' || s === '026' || s === 'LF Ecoli' || s === 'NLF Ecoli' || s === 'LF E.coli' || s === 'NLF E.coli');
    }

    /* ----- Method dropdown visibility (2026-10-14) ----------------------
       Disk Diffusion / MIC is a choice about how the ROUTINE antibiogram was
       read, and an E.coli isolate (025 LF / 026 NLF) never carries one: its
       antimicrobials live on the E.coli PCR / AST card instead, and
       displayASTRow() already hides #bpAst for 025/026. The Method select sits
       in the row ABOVE that panel though, so it used to stay on screen for
       E.coli -- offering a choice between two panels that were both hidden.
       This collapses its whole form-group alongside the panel it controls.

       Matching is on the pathogen ID via bpIsEcoliPathogen(), not on the
       display text: the stored names are "LF E.coli" / "NLF E.coli" but the
       spacing varies in the wild ("LF E. coli"), and every other E.coli branch
       in this file and in iu-lab.php already keys off 025/026.

       The select is hidden but deliberately NOT disabled, and its value is
       left alone. iu-lab.php skips the entire AST block for 025/026 (the
       pathogen guards at lines 127 and 292), so the posted method[] is ignored
       for these rows whatever it says -- and when it is absent the server
       already falls back to '01' Disk Diffusion. Keeping the element live also
       means bpResistanceSyncAll() and bpCarbaScreenIsMic() keep reading a
       stable value instead of meeting a disabled control.

       required is still handled through bpSetRequiredWithin() (the house
       helper, which tracks the original state on data-was-required). The
       Method select is not required today, so that call is a no-op -- it is
       there so hiding this group can never become the "hidden required field
       silently blocks submit" trap that bpSyncEcoliPcrSection() warns about. */
    function bpSyncMethodVisibility(idx){
        var wrap = document.getElementById('bpMethodWrap' + idx);
        if(!wrap){ return; }
        var p    = document.getElementById('bpPathogen' + idx);
        var show = !(p && bpIsEcoliPathogen(p.value));
        wrap.style.display = show ? '' : 'none';
        if(typeof bpSetRequiredWithin === 'function'){ bpSetRequiredWithin(wrap, show); }
    }

    /* Rebuild the option list of an AST select. Options are rebuilt, never
       hidden with CSS -- hidden <option>s are unreliable across browsers. The
       current value survives when it is still a valid choice, otherwise the
       select falls back to "" so no stale value can be posted. */
    function bpSetAstOptions(s, set){
        var i, same = (s.options.length==set.length);
        if(same){
            for(i=0;i<set.length;i++){
                if(s.options[i].value!=set[i][0]){ same=false; break; }
            }
        }
        if(same){ return; }
        var cur = s.value, keep = '';
        for(i=0;i<set.length;i++){
            if(set[i][0]!=='' && set[i][0]==cur){ keep = cur; }
        }
        while(s.options.length){ s.remove(0); }
        for(i=0;i<set.length;i++){
            var o = document.createElement('option');
            o.value = set[i][0];
            o.text  = set[i][1];
            s.appendChild(o);
        }
        s.value = keep;
    }

    /* Interpret a zone diameter the instant it is typed.

       This mirrors iu-lab.php exactly -- same order, same comparisons -- so the
       value shown while typing is the value that will be stored:
           zone <= resistance                    -> Resistant
           zone >= intermediate1 && <= intermediate2 -> Intermediate
           zone >= susceptible                   -> Susceptible
       The order matters: the tests overlap at the edges and the last match wins.
       Thresholds come from data-* attributes populated from ms_ast_table, so the
       browser can never disagree with the save path.

       "Susceptible" is used rather than "Sensitive" because that is the value the
       database stores and every report prints. -99 is the existing sentinel for
       "not tested" and clears the result instead of interpreting it. */
    function bpAstInterpret(input){
        var row = input.closest ? input.closest('.row') : null;
        if(!row){ return; }
        var out = row.querySelector('.bp-astresult');
        if(!out){ return; }

        var raw = (input.value || '').trim();
        if(raw === ''){ out.value = ''; return; }

        var zone = parseFloat(raw);
        if(isNaN(zone) || raw === '-99'){ out.value = ''; return; }

        var sus  = parseFloat(input.getAttribute('data-sus'));
        var int1 = parseFloat(input.getAttribute('data-int1'));
        var int2 = parseFloat(input.getAttribute('data-int2'));
        var res  = parseFloat(input.getAttribute('data-res'));
        if(isNaN(sus) || isNaN(res)){ return; }   // no breakpoints for this agent

        var result = '';
        if(zone <= res){ result = 'Resistant'; }
        if(!isNaN(int1) && !isNaN(int2) && zone >= int1 && zone <= int2){ result = 'Intermediate'; }
        if(zone >= sus){ result = 'Susceptible'; }
        out.value = result;
    }

    /* Fill results for zones already on screen (edit view, and cloned rows). */
    function bpAstInterpretAll(scope){
        var el = (scope || document).querySelectorAll('.bp-zone');
        for(var i=0;i<el.length;i++){ if((el[i].value||'').trim() !== ''){ bpAstInterpret(el[i]); } }
    }

    function displayASTRow(idx){
        var p = document.getElementById('bpPathogen'+idx);
        var s = document.getElementById('bpStatus'+idx);
        var a = document.getElementById('bpAst'+idx);
        if(!p || !s || !a){ return; }
        var val1 = p.value;
        var isEcoli = bpIsEcoliPathogen(val1);
        /* Method is meaningless for an E.coli isolate -- collapse it with the
           AST panel below. Driven from here so the existing onchange on the
           pathogen select, initPathogenRows() on load/edit, and
           addPathogenRow() for a cloned row all pick it up unchanged. */
        bpSyncMethodVisibility(idx);
        bpSetAstOptions(s, isEcoli ? BP_AST_OPTIONS_ECOLI : BP_AST_OPTIONS_STD);
        if(val1=="NR" || val1=="101" || val1=="999"){
            s.value="NR"; s.disabled=true;
        }else{
            s.disabled=false;
        }
        var val2 = s.value;
        /* E.coli never carries antimicrobial zones in this form, so the panel
           stays hidden for 025/026 whatever the Positive/Negative choice is.
           #bpAst wraps #bpDd, #bpMic AND #bpConf -- which is where the ESBL,
           Carbapenemase (Module A/B, mCIM/eCIM), AmpC and Carba NP cards live --
           so collapsing it collapses every confirmatory card with it. That is
           why there is no separate rule for the Carba NP Test: it is inside
           #bpConf and goes with the parent. */
        if(isEcoli || val1=="" || val2=="" || val1=="NR" || val2=="NR" || val1=="101" || val1=="999"){
            a.style.display="none";
            /* 2026-10-14: strip `required` across the whole collapsed subtree.
               Hiding alone was not enough. #bpAst contains one genuine required
               control -- the Final ESBL Status select (esbl_result[idx]) -- and
               mcim_zone[idx] carries data-was-required so bpSetRequiredWithin()
               can promote it when the Carbapenemase panel opens. Both are set
               by bpResistanceApply() from the posted zones, and those zones stay
               in the DOM when the user switches an already-filled row to
               LF/NLF E.coli. The triggers therefore still fire, the panels were
               still marked required, and the browser then refused to submit
               while reporting the error against a control inside a display:none
               subtree -- the form simply looked dead. Stripping at the ANCESTOR
               dominates whatever the per-panel trigger logic decided, which is
               the only ordering that is safe here.

               Scope is exactly #bpAst: the four required controls in the header
               row above it -- pathogen, status, Processed by, Date of processing
               -- sit OUTSIDE this container and keep their required state, so an
               E.coli row is still validated for the fields that do apply to it. */
            if(typeof bpSetRequiredWithin === 'function'){ bpSetRequiredWithin(a, false); }
        }else{
            a.style.display="block";
            /* Re-opening delegates to the trigger logic rather than blanket
               restoring: bpResistanceApply() decides which of ESBL / CPE / AmpC
               is actually visible for the current zones and re-applies required
               only there (via its own bpSetRequiredWithin calls). A blanket
               restore here would mark panels required that are not even shown. */
            if(typeof bpResistanceSync === 'function'){ bpResistanceSync(idx); }
        }
        bpSyncEcoliPcrSection();
        if(typeof bpStageSync === 'function'){ bpStageSync(idx); }
    }

    /* Live show/hide of the whole E.coli PCR Result section as the Bacteriology
       AST choice changes -- the browser-side echo of bdsis_ecoli_pcr_applies():
       clause 1 is "some E.coli row is Positive", clause 2 is the sticky flag PHP
       stamps when saved PCR records already exist. Only ever touches a section
       PHP already rendered -- a PCR record cannot be saved before its
       bacteriology row exists (FK on subject_id). */
    function bpSyncEcoliPcrSection(){
        var sec = document.getElementById('ecoliPcrResultSection');
        if(!sec){ return; }
        if(sec.getAttribute('data-bp-sticky')=="1"){ return; }
        var blocks = document.querySelectorAll('#pathogenRows .pathogen-block');
        var anyPositive = false;
        for(var i=0;i<blocks.length;i++){
            var bi = blocks[i].getAttribute('data-bpidx');
            var p  = document.getElementById('bpPathogen'+bi);
            var s  = document.getElementById('bpStatus'+bi);
            if(p && s && bpIsEcoliPathogen(p.value) && s.value=="Positive"){ anyPositive = true; }
        }
        sec.style.display = anyPositive ? '' : 'none';
        /* Same trap as inside a block: a `required` control in a display:none
           container makes the browser silently refuse to submit. */
        bpSetRequiredWithin(sec, anyPositive);
    }

    /* Strip/restore `required` across a container being hidden/shown. The
       original state is remembered in data-was-required so nothing is invented
       on the way back. */
    function bpSetRequiredWithin(container, show){
        var reqd = container.querySelectorAll('[required], [data-was-required]');
        for(var i=0;i<reqd.length;i++){
            if(show){
                if(reqd[i].getAttribute('data-was-required')=="1"){ reqd[i].required=true; }
            }else{
                if(reqd[i].required){ reqd[i].setAttribute('data-was-required','1'); }
                reqd[i].required=false;
            }
        }
    }
